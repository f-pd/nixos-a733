From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Fri, 9 Oct 2026 16:25:09 +0200
Subject: [PATCH] dt-bindings: phy: Add the Allwinner A733 DisplayPort AUX PHY

The SERDES block of the A733 has an analog front end for the AUX channel
and the hot plug detect input of the DisplayPort transmitter. The user
manual draws it as a block of its own beside the first combo PHY, with
its own interface to the transmitter and its own registers (section
18.2.2, figure 18-3, and sections 18.2.6.13 to 18.2.6.15).

Add a binding for it as a PHY of its own. It shares the SERDES clock
and the SERDES reset with the combo PHYs.

Tested on Radxa Cubie A7S: booted on one board with a device tree that
uses this binding; the AUX PHY probes and dtbs_check reports nothing.

Assisted-by: LLM
---
 .../phy/allwinner,sun60i-a733-dp-aux-phy.yaml | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-dp-aux-phy.yaml

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-dp-aux-phy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-dp-aux-phy.yaml
new file mode 100644
index 000000000000..e766ec5dbac4
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-dp-aux-phy.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/allwinner,sun60i-a733-dp-aux-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 DisplayPort AUX and HPD PHY
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The SERDES block of the A733 has an analog front end for the AUX channel
+  and the hot plug detect input of the DisplayPort transmitter, beside the
+  combo PHY that carries the main link lanes.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-dp-aux-phy
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: SERDES PHY clock
+
+  clock-names:
+    items:
+      - const: serdes
+
+  resets:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    phy@6c01e00 {
+        compatible = "allwinner,sun60i-a733-dp-aux-phy";
+        reg = <0x06c01e00 0x200>;
+        clocks = <&ccu CLK_SERDES_PHY>;
+        clock-names = "serdes";
+        resets = <&ccu RST_BUS_SERDES>;
+        #phy-cells = <0>;
+    };
