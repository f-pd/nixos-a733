--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun60i_de_top.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifndef _SUN60I_DE_TOP_H_
+#define _SUN60I_DE_TOP_H_
+
+#include <linux/mod_devicetable.h>
+#include <linux/types.h>
+
+struct device;
+
+extern const struct of_device_id sun60i_de_top_of_table[];
+
+int sun60i_de_top_route(struct device *dev, unsigned int disp,
+			unsigned int tcon);
+
+#endif /* _SUN60I_DE_TOP_H_ */
