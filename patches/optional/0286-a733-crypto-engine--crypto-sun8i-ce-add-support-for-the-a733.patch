diff --git a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-cipher.c b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-cipher.c
index 64245cef6c91..491b8b54ed33 100644
--- a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-cipher.c
+++ b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-cipher.c
@@ -132,8 +132,9 @@ static int sun8i_ce_cipher_fallback(struct skcipher_request *areq)
 }
 
 static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
-				   struct ce_task *cet)
+				   union ce_desc *desc)
 {
+	struct ce_task *cet = &desc->task;
 	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(areq);
 	struct sun8i_cipher_tfm_ctx *op = crypto_skcipher_ctx(tfm);
 	struct sun8i_ce_dev *ce = op->ce;
@@ -161,14 +162,17 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 	if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
 		algt->stat_req++;
 
-	memset(cet, 0, sizeof(struct ce_task));
+	memset(desc, 0, sizeof(*desc));
 
+	/* struct ce_task_sym starts with these four words as well */
 	cet->t_id = cpu_to_le32(rctx->flow);
 	common = ce->variant->alg_cipher[algt->ce_algo_id];
 	common |= rctx->op_dir | CE_COMM_INT;
 	cet->t_common_ctl = cpu_to_le32(common);
 	/* CTS and recent CE (H6) need length in bytes, in word otherwise */
-	if (ce->variant->cipher_t_dlen_in_bytes)
+	if (ce->variant->split_tasks)
+		desc->sym.t_dlen = cpu_to_le32(areq->cryptlen);
+	else if (ce->variant->cipher_t_dlen_in_bytes)
 		cet->t_dlen = cpu_to_le32(areq->cryptlen);
 	else
 		cet->t_dlen = cpu_to_le32(areq->cryptlen / 4);
@@ -196,7 +200,10 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 		err = -EFAULT;
 		goto theend;
 	}
-	cet->t_key = desc_addr_val_le32(ce, rctx->addr_key);
+	if (ce->variant->split_tasks)
+		ce_put_le40(desc->sym.t_key, rctx->addr_key);
+	else
+		cet->t_key = desc_addr_val_le32(ce, rctx->addr_key);
 
 	ivsize = crypto_skcipher_ivsize(tfm);
 	if (areq->iv && ivsize > 0) {
@@ -213,7 +220,10 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 			err = -ENOMEM;
 			goto theend_iv;
 		}
-		cet->t_iv = desc_addr_val_le32(ce, rctx->addr_iv);
+		if (ce->variant->split_tasks)
+			ce_put_le40(desc->sym.t_iv, rctx->addr_iv);
+		else
+			cet->t_iv = desc_addr_val_le32(ce, rctx->addr_iv);
 	}
 
 	if (areq->src == areq->dst) {
@@ -241,11 +251,15 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 
 	len = areq->cryptlen;
 	for_each_sg(areq->src, sg, nr_sgs, i) {
-		cet->t_src[i].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
 		todo = min(len, sg_dma_len(sg));
-		cet->t_src[i].len = cpu_to_le32(todo / 4);
-		dev_dbg(ce->dev, "%s total=%u SG(%d %u off=%d) todo=%u\n", __func__,
-			areq->cryptlen, i, cet->t_src[i].len, sg->offset, todo);
+		if (ce->variant->split_tasks) {
+			ce_sg_set_src(&desc->sym.t_sg[i], sg_dma_address(sg), todo);
+		} else {
+			cet->t_src[i].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
+			cet->t_src[i].len = cpu_to_le32(todo / 4);
+		}
+		dev_dbg(ce->dev, "%s total=%u SG(%d off=%d) todo=%u\n", __func__,
+			areq->cryptlen, i, sg->offset, todo);
 		len -= todo;
 	}
 	if (len > 0) {
@@ -256,11 +270,15 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 
 	len = areq->cryptlen;
 	for_each_sg(areq->dst, sg, nr_sgd, i) {
-		cet->t_dst[i].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
 		todo = min(len, sg_dma_len(sg));
-		cet->t_dst[i].len = cpu_to_le32(todo / 4);
-		dev_dbg(ce->dev, "%s total=%u SG(%d %u off=%d) todo=%u\n", __func__,
-			areq->cryptlen, i, cet->t_dst[i].len, sg->offset, todo);
+		if (ce->variant->split_tasks) {
+			ce_sg_set_dst(&desc->sym.t_sg[i], sg_dma_address(sg), todo);
+		} else {
+			cet->t_dst[i].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
+			cet->t_dst[i].len = cpu_to_le32(todo / 4);
+		}
+		dev_dbg(ce->dev, "%s total=%u SG(%d off=%d) todo=%u\n", __func__,
+			areq->cryptlen, i, sg->offset, todo);
 		len -= todo;
 	}
 	if (len > 0) {
@@ -307,8 +325,7 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 	return err;
 }
 
-static void sun8i_ce_cipher_unprepare(struct skcipher_request *areq,
-				      struct ce_task *cet)
+static void sun8i_ce_cipher_unprepare(struct skcipher_request *areq)
 {
 	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(areq);
 	struct sun8i_cipher_tfm_ctx *op = crypto_skcipher_ctx(tfm);
@@ -329,9 +346,7 @@ static void sun8i_ce_cipher_unprepare(struct skcipher_request *areq,
 	}
 
 	if (areq->iv && ivsize > 0) {
-		if (cet->t_iv)
-			dma_unmap_single(ce->dev, rctx->addr_iv, ivsize,
-					 DMA_TO_DEVICE);
+		dma_unmap_single(ce->dev, rctx->addr_iv, ivsize, DMA_TO_DEVICE);
 		offset = areq->cryptlen - ivsize;
 		if (rctx->op_dir & CE_DECRYPTION) {
 			memcpy(areq->iv, rctx->backup_iv, ivsize);
@@ -365,7 +380,7 @@ int sun8i_ce_cipher_do_one(struct crypto_engine *engine, void *areq)
 	err = sun8i_ce_run_task(ce, rctx->flow,
 				crypto_tfm_alg_name(req->base.tfm));
 
-	sun8i_ce_cipher_unprepare(req, chan->tl);
+	sun8i_ce_cipher_unprepare(req);
 
 	local_bh_disable();
 	crypto_finalize_skcipher_request(engine, req, err);
diff --git a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-core.c b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-core.c
index 97c163510ae7..30cf289c0a44 100644
--- a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-core.c
+++ b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-core.c
@@ -143,6 +143,31 @@ static const struct ce_variant ce_d1_variant = {
 	.trng = CE_ALG_TRNG,
 };
 
+/*
+ * The A733 takes its own task descriptor layouts, and each of its channels
+ * feeds one algorithm unit. The module clock is in the range the manual
+ * gives for the CE clock domain.
+ */
+static const struct ce_variant ce_a733_variant = {
+	.alg_cipher = { CE_ALG_AES, CE_ALG_DES, CE_ALG_3DES,
+	},
+	.alg_hash = { CE_ALG_A733_MD5, CE_ALG_A733_SHA1, CE_ALG_A733_SHA224,
+		CE_ALG_A733_SHA256, CE_ALG_A733_SHA384, CE_ALG_A733_SHA512
+	},
+	.op_mode = { CE_OP_ECB, CE_OP_CBC
+	},
+	.split_tasks = true,
+	.ce_clks = {
+		{ "bus", 0, 300000000 },
+		{ "mod", 300000000, 600000000 },
+		{ "ram", 0, 700000000 },
+		{ "trng", 0, 0 },
+		{ "sys", 0, 300000000 },
+		},
+	.esr = ESR_A733,
+	.trng = CE_ALG_A733_TRNG,
+};
+
 static const struct ce_variant ce_r40_variant = {
 	.alg_cipher = { CE_ALG_AES, CE_ALG_DES, CE_ALG_3DES,
 	},
@@ -162,16 +187,21 @@ static const struct ce_variant ce_r40_variant = {
 static void sun8i_ce_dump_task_descriptors(struct sun8i_ce_flow *chan)
 {
 	print_hex_dump(KERN_INFO, "TASK: ", DUMP_PREFIX_NONE, 16, 4,
-		       chan->tl, sizeof(struct ce_task), false);
+		       chan->tl, sizeof(*chan->tl), false);
 }
 
 /*
  * sun8i_ce_get_engine_number() get the next channel slot
  * This is a simple round-robin way of getting the next channel
  * The flow 3 is reserve for xRNG operations
+ * On the A733 each channel feeds one algorithm unit, so the type of the
+ * algorithm gives the channel.
  */
 int sun8i_ce_get_engine_number(struct sun8i_ce_dev *ce, u32 type)
 {
+	if (ce->variant->split_tasks)
+		return type == CRYPTO_ALG_TYPE_AHASH ? CE_CHAN_HASH : CE_CHAN_SYMM;
+
 	return atomic_inc_return(&ce->flow) % (MAXFLOW - 1);
 }
 
@@ -192,15 +222,23 @@ int sun8i_ce_run_task(struct sun8i_ce_dev *ce, int flow, const char *name)
 
 	reinit_completion(&ce->chanlist[flow].complete);
 	writel(desc_addr_val(ce, ce->chanlist[flow].t_phy), ce->base + CE_TDQ);
+	if (ce->variant->split_tasks)
+		writel(upper_32_bits(ce->chanlist[flow].t_phy) & 0xff,
+		       ce->base + CE_TDA1);
 
 	ce->chanlist[flow].status = 0;
 	/* Be sure all data is written before enabling the task */
 	wmb();
 
-	/* Only H6 needs to write a part of t_common_ctl along with "1", but since it is ignored
-	 * on older SoCs, we have no reason to complicate things.
-	 */
-	v = 1 | ((le32_to_cpu(ce->chanlist[flow].tl->t_common_ctl) & 0x7F) << 8);
+	if (ce->variant->split_tasks) {
+		v = CE_TLR_LOAD(flow);
+	} else {
+		/* Only H6 needs to write a part of t_common_ctl along with "1",
+		 * but since it is ignored on older SoCs, we have no reason to
+		 * complicate things.
+		 */
+		v = 1 | ((le32_to_cpu(ce->chanlist[flow].tl->task.t_common_ctl) & 0x7F) << 8);
+	}
 	writel(v, ce->base + CE_TLR);
 	mutex_unlock(&ce->mlock);
 
@@ -267,6 +305,24 @@ int sun8i_ce_run_task(struct sun8i_ce_dev *ce, int flow, const char *name)
 		if (v & CE_ERR_KEYLADDER)
 			dev_err(ce->dev, "CE ERROR: key ladder configuration error\n");
 		break;
+	case ESR_A733:
+		v >>= (flow * 8);
+		v &= 0xFF;
+		if (v || ce->chanlist[flow].status != CE_ISR_DONE) {
+			dev_err(ce->dev, "CE ERROR: %x status %x for flow %x\n",
+				v, ce->chanlist[flow].status, flow);
+			sun8i_ce_dump_task_descriptors(&ce->chanlist[flow]);
+			err = -EFAULT;
+		}
+		if (v == CE_ERR_CODE_ALGO_NOTSUP)
+			dev_err(ce->dev, "CE ERROR: algorithm not supported\n");
+		if (v == CE_ERR_CODE_KEYSRAM)
+			dev_err(ce->dev, "CE ERROR: keysram access error\n");
+		if (v == CE_ERR_CODE_KEYLADDER)
+			dev_err(ce->dev, "CE ERROR: key ladder configuration error\n");
+		if (v == CE_ERR_CODE_DATALEN)
+			dev_err(ce->dev, "CE ERROR: data length error\n");
+		break;
 	}
 
 	return err;
@@ -280,7 +336,13 @@ static irqreturn_t ce_irq_handler(int irq, void *data)
 
 	p = readl(ce->base + CE_ISR);
 	for (flow = 0; flow < MAXFLOW; flow++) {
-		if (p & (BIT(flow))) {
+		if (ce->variant->split_tasks) {
+			if (CE_ISR_STATUS(p, flow)) {
+				writel(CE_ISR_CLEAR(flow), ce->base + CE_ISR);
+				ce->chanlist[flow].status = CE_ISR_STATUS(p, flow);
+				complete(&ce->chanlist[flow].complete);
+			}
+		} else if (p & (BIT(flow))) {
 			writel(BIT(flow), ce->base + CE_ISR);
 			ce->chanlist[flow].status = 1;
 			complete(&ce->chanlist[flow].complete);
@@ -682,7 +744,7 @@ static void sun8i_ce_free_chanlist(struct sun8i_ce_dev *ce, int i)
 	while (i >= 0) {
 		crypto_engine_exit(ce->chanlist[i].engine);
 		if (ce->chanlist[i].tl)
-			dma_free_coherent(ce->dev, sizeof(struct ce_task),
+			dma_free_coherent(ce->dev, sizeof(union ce_desc),
 					  ce->chanlist[i].tl,
 					  ce->chanlist[i].t_phy);
 		i--;
@@ -718,7 +780,7 @@ static int sun8i_ce_allocate_chanlist(struct sun8i_ce_dev *ce)
 			goto error_engine;
 		}
 		ce->chanlist[i].tl = dma_alloc_coherent(ce->dev,
-							sizeof(struct ce_task),
+							sizeof(union ce_desc),
 							&ce->chanlist[i].t_phy,
 							GFP_KERNEL);
 		if (!ce->chanlist[i].tl) {
@@ -991,10 +1053,13 @@ static int sun8i_ce_probe(struct platform_device *pdev)
 	sun8i_ce_hwrng_register(ce);
 #endif
 
-	v = readl(ce->base + CE_CTR);
-	v >>= CE_DIE_ID_SHIFT;
-	v &= CE_DIE_ID_MASK;
-	dev_info(&pdev->dev, "CryptoEngine Die ID %x\n", v);
+	/* The A733 has no CE_CTR */
+	if (!ce->variant->split_tasks) {
+		v = readl(ce->base + CE_CTR);
+		v >>= CE_DIE_ID_SHIFT;
+		v &= CE_DIE_ID_MASK;
+		dev_info(&pdev->dev, "CryptoEngine Die ID %x\n", v);
+	}
 
 	pm_runtime_put_sync(ce->dev);
 
@@ -1054,6 +1119,8 @@ static const struct of_device_id sun8i_ce_crypto_of_match_table[] = {
 	  .data = &ce_h6_variant },
 	{ .compatible = "allwinner,sun50i-h616-crypto",
 	  .data = &ce_h616_variant },
+	{ .compatible = "allwinner,sun60i-a733-crypto",
+	  .data = &ce_a733_variant },
 	{}
 };
 MODULE_DEVICE_TABLE(of, sun8i_ce_crypto_of_match_table);
diff --git a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c
index 22cede7a2dfa..f99eb71b612b 100644
--- a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c
+++ b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c
@@ -14,6 +14,7 @@
 #include <crypto/md5.h>
 #include <crypto/sha1.h>
 #include <crypto/sha2.h>
+#include <linux/bitfield.h>
 #include <linux/bottom_half.h>
 #include <linux/dma-mapping.h>
 #include <linux/kernel.h>
@@ -313,8 +314,10 @@ static u64 hash_pad(__le32 *buf, unsigned int bufsize, u64 padi, u64 byte_count,
 	return j;
 }
 
-static int sun8i_ce_hash_prepare(struct ahash_request *areq, struct ce_task *cet)
+static int sun8i_ce_hash_prepare(struct ahash_request *areq, union ce_desc *desc)
 {
+	struct ce_task *cet = &desc->task;
+	struct ce_task_hash *th = &desc->hash;
 	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
 	struct ahash_alg *alg = __crypto_ahash_alg(tfm->base.__crt_alg);
 	struct sun8i_ce_hash_reqctx *rctx = ahash_request_ctx_dma(areq);
@@ -347,15 +350,22 @@ static int sun8i_ce_hash_prepare(struct ahash_request *areq, struct ce_task *cet
 
 	dev_dbg(ce->dev, "%s %s len=%d\n", __func__, crypto_tfm_alg_name(areq->base.tfm), areq->nbytes);
 
-	memset(cet, 0, sizeof(struct ce_task));
+	memset(desc, 0, sizeof(*desc));
 
-	cet->t_id = cpu_to_le32(rctx->flow);
-	common = ce->variant->alg_hash[algt->ce_algo_id];
-	common |= CE_COMM_INT;
-	cet->t_common_ctl = cpu_to_le32(common);
+	if (ce->variant->split_tasks) {
+		th->t_ctl = cpu_to_le32(FIELD_PREP(CE_HASH_CTL_CHAN, rctx->flow) |
+					CE_HASH_CTL_INT);
+		th->t_cmd = cpu_to_le32(FIELD_PREP(CE_HASH_CMD_HASH,
+						   ce->variant->alg_hash[algt->ce_algo_id]));
+	} else {
+		cet->t_id = cpu_to_le32(rctx->flow);
+		common = ce->variant->alg_hash[algt->ce_algo_id];
+		common |= CE_COMM_INT;
+		cet->t_common_ctl = cpu_to_le32(common);
 
-	cet->t_sym_ctl = 0;
-	cet->t_asym_ctl = 0;
+		cet->t_sym_ctl = 0;
+		cet->t_asym_ctl = 0;
+	}
 
 	rctx->nr_sgs = sg_nents_for_len(areq->src, areq->nbytes);
 	nr_sgs = dma_map_sg(ce->dev, areq->src, rctx->nr_sgs, DMA_TO_DEVICE);
@@ -367,9 +377,13 @@ static int sun8i_ce_hash_prepare(struct ahash_request *areq, struct ce_task *cet
 
 	len = areq->nbytes;
 	for_each_sg(areq->src, sg, nr_sgs, i) {
-		cet->t_src[i].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
 		todo = min(len, sg_dma_len(sg));
-		cet->t_src[i].len = cpu_to_le32(todo / 4);
+		if (ce->variant->split_tasks) {
+			ce_sg_set_src(&th->t_sg[i], sg_dma_address(sg), todo);
+		} else {
+			cet->t_src[i].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
+			cet->t_src[i].len = cpu_to_le32(todo / 4);
+		}
 		len -= todo;
 	}
 	if (len > 0) {
@@ -381,8 +395,12 @@ static int sun8i_ce_hash_prepare(struct ahash_request *areq, struct ce_task *cet
 	rctx->result_len = digestsize;
 	rctx->addr_res = dma_map_single(ce->dev, rctx->result, rctx->result_len,
 					DMA_FROM_DEVICE);
-	cet->t_dst[0].addr = desc_addr_val_le32(ce, rctx->addr_res);
-	cet->t_dst[0].len = cpu_to_le32(rctx->result_len / 4);
+	if (ce->variant->split_tasks) {
+		ce_sg_set_dst(&th->t_sg[0], rctx->addr_res, rctx->result_len);
+	} else {
+		cet->t_dst[0].addr = desc_addr_val_le32(ce, rctx->addr_res);
+		cet->t_dst[0].len = cpu_to_le32(rctx->result_len / 4);
+	}
 	if (dma_mapping_error(ce->dev, rctx->addr_res)) {
 		dev_err(ce->dev, "DMA map dest\n");
 		err = -EINVAL;
@@ -414,15 +432,27 @@ static int sun8i_ce_hash_prepare(struct ahash_request *areq, struct ce_task *cet
 	rctx->pad_len = j * 4;
 	rctx->addr_pad = dma_map_single(ce->dev, rctx->pad, rctx->pad_len,
 					DMA_TO_DEVICE);
-	cet->t_src[i].addr = desc_addr_val_le32(ce, rctx->addr_pad);
-	cet->t_src[i].len = cpu_to_le32(j);
+	if (ce->variant->split_tasks) {
+		ce_sg_set_src(&th->t_sg[i], rctx->addr_pad, rctx->pad_len);
+	} else {
+		cet->t_src[i].addr = desc_addr_val_le32(ce, rctx->addr_pad);
+		cet->t_src[i].len = cpu_to_le32(j);
+	}
 	if (dma_mapping_error(ce->dev, rctx->addr_pad)) {
 		dev_err(ce->dev, "DMA error on padding SG\n");
 		err = -EINVAL;
 		goto err_unmap_result;
 	}
 
-	if (ce->variant->hash_t_dlen_in_bits)
+	/*
+	 * A733: the data length (DLA, A733 manual 19.1.4.14) in bits, of the
+	 * message as padded by the driver (19.1.4.9). The last package flag
+	 * stays clear: the CE writes the state after any package, and after
+	 * the padding that state is the digest.
+	 */
