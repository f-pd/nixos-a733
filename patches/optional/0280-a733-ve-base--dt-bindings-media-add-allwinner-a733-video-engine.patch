From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Mon, 12 Oct 2026 09:10:00 +0200
Subject: [PATCH] dt-bindings: media: Add Allwinner A733 video engine

The A733 has a video decoder and a video encoder. They are separate
blocks, each with its own register window, interrupt, clocks, reset,
power domain and IOMMU masters, so each is a node of its own, with its
own compatible, described in one file.

The binding of the older video engines does not fit: it has three clocks
and a SRAM claim, and the A733 blocks have five clock gates and no SRAM
mapping that the manual describes. The five clocks are, per block, its
bus gate, the AHB matrix gate, the MBUS matrix port gate, the MBUS clock
enable and the module clock (manual sections 4.1.6.82 to 4.1.6.84 and
4.1.6.114 to 4.1.6.116). The decoder's two bus masters sit on the second
IOMMU, the encoder's on the first (manual chapter 10).

Not covered: the manual describes no register of the blocks, so nothing
register-level is described, and the firmware that controls the decoder
has no property yet.

Tested on Radxa Cubie A7S: with both nodes enabled for a test, the
decoder and encoder probe with the clocks, resets, power domains and
IOMMU masters this binding names.

Assisted-by: LLM
---
 .../allwinner,sun60i-a733-video-engine.yaml   | 131 ++++++++++++++++++
 1 file changed, 131 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/allwinner,sun60i-a733-video-engine.yaml

diff --git a/Documentation/devicetree/bindings/media/allwinner,sun60i-a733-video-engine.yaml b/Documentation/devicetree/bindings/media/allwinner,sun60i-a733-video-engine.yaml
new file mode 100644
index 000000000000..596a24b6bbf4
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/allwinner,sun60i-a733-video-engine.yaml
@@ -0,0 +1,131 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/allwinner,sun60i-a733-video-engine.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 Video Engine
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The A733 has a video decoder and a video encoder. They are separate
+  blocks, each with its own register window, interrupt, clock gates, module
+  clock, reset, power domain and IOMMU masters, so each is a node of its
+  own. The decoder handles H.265, VP9 and AVS2 up to 8K, among others, and
+  the encoder H.264 and H.265 up to 4K at 30 frames per second. Unlike the
+  video engine of the older Allwinner SoCs, described in
+  allwinner,sun4i-a10-video-engine.yaml, each block has five clocks and no
+  SRAM claim.
+
+  The module clock takes one of VE0PLL, VE1PLL, three fixed PLL taps, DEPLL3X
+  or NPUPLL as its parent. Its parent and rate are set with assigned-clocks.
+
+properties:
+  compatible:
+    enum:
+      - allwinner,sun60i-a733-video-decoder
+      - allwinner,sun60i-a733-video-encoder
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Bus gate of the block (VE_BGR_REG)
+      - description: AHB matrix gate (AHB_MAT_CLK_GATING_REG)
+      - description: MBUS matrix port gate (MBUS_MAT_CLK_GATING_REG)
+      - description: MBUS clock enable (MBUS_GATE_EN_REG)
+      - description: Module clock (VE_DEC_CLK_REG or VE_ENC0_CLK_REG)
+
+  clock-names:
+    items:
+      - const: bus
+      - const: ahb
+      - const: mbus
+      - const: mclk
+      - const: mod
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  iommus:
+    minItems: 1
+    maxItems: 2
+    description:
+      The decoder has two bus masters, VE_MBUS0 and VE_MBUS1, both on the
+      second IOMMU. The encoder has one, VE_ENC, on the first IOMMU. The
+      MBUS port gate of the block is the "mbus" clock here and the "masterN"
+      clock of the IOMMU, which holds it while the master translates.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - power-domains
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: allwinner,sun60i-a733-video-decoder
+    then:
+      properties:
+        iommus:
+          minItems: 2
+    else:
+      properties:
+        iommus:
+          maxItems: 1
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/allwinner,sun60i-a733-pck-600.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    bus {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        video-codec@1c0e000 {
+            compatible = "allwinner,sun60i-a733-video-decoder";
+            reg = <0x01c0e000 0x2000>;
+            interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
+            clocks = <&ccu CLK_BUS_VE_DEC0>, <&ccu CLK_AHB_VE_DEC>,
+                     <&ccu CLK_MBUS_VE_DEC0_GATE>, <&ccu CLK_MBUS_VE_DEC0>,
+                     <&ccu CLK_VE_DEC0>;
+            clock-names = "bus", "ahb", "mbus", "mclk", "mod";
+            resets = <&ccu RST_BUS_VE_DEC0>;
+            power-domains = <&pck600 PD_VE_DEC>;
+            iommus = <&iommu1 0>, <&iommu1 1>;
+        };
+
+        video-codec@1c10000 {
+            compatible = "allwinner,sun60i-a733-video-encoder";
+            reg = <0x01c10000 0x1000>;
+            interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
+            clocks = <&ccu CLK_BUS_VE_ENC0>, <&ccu CLK_AHB_VE_ENC>,
+                     <&ccu CLK_MBUS_VE_ENC0_GATE>, <&ccu CLK_MBUS_VE_ENC0>,
+                     <&ccu CLK_VE_ENC0>;
+            clock-names = "bus", "ahb", "mbus", "mclk", "mod";
+            resets = <&ccu RST_BUS_VE_ENC0>;
+            power-domains = <&pck600 PD_VE_ENC>;
+            iommus = <&iommu0 3>;
+        };
+    };
+
+...
