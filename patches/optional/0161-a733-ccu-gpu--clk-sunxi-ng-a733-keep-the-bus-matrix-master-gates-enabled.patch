From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Fri, 16 Oct 2026 21:41:19 +0200
Subject: [PATCH] clk: sunxi-ng: a733: Keep the bus-matrix master gates enabled

The master gates in AHB_MAT_CLK_GATING (0x5c0) and MBUS_MAT_CLK_GATING
(0x5e0) of a powered-off domain read back as 0, while the register
keeps the written value: a gate written as 1 opens again when its
domain powers up. A gate update is a read-modify-write of the whole
register, so toggling any of these gates while a domain is off writes
that domain's gates as 0, and the domain powers up with its bus-matrix
ports closed. The manual describes all of them as plain read/write
bits, enabled out of reset.

Seen on the Radxa Cubie A7S: with the GPU suspended and GPU_TOP off,
loading sun60i_de_top enables ahb-de and mbus-desys, the next GPU
resume finds ahb-gpu0 closed, and the GPU firmware fails to boot.

Mark every gate in both registers critical, so that neither register
is written after registration. This also covers the GPU gates, which
no consumer claims and clk_disable_unused() would otherwise close.

The registration itself still writes both registers, once per gate,
from what they read. That is safe because every domain with a gate in
them is on when the CCU probes: the PCK-600 domains come out of the
boot firmware powered and are only switched later by their consumers.

Tested on Radxa Cubie A7S: with GPU_TOP allowed to switch off, the GPU
resumes and renders after each group of the display, crypto, DSU, PHY,
DMA and server modules is loaded, and ahb-gpu0 and mbus-gpu0 read 1
whenever GPU_TOP is on.

Assisted-by: LLM
---
 drivers/clk/sunxi-ng/ccu-sun60i-a733.c | 48 +++++++++++++++-----------
 1 file changed, 28 insertions(+), 20 deletions(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
index 3b0cfe593cec..1df3f76fced9 100644
--- a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
@@ -559,32 +559,40 @@ static SUNXI_CCU_GATE_HWS(mbus_iommu1_sys_clk, "mbus-iommu1-sys", mbus_hws, 0x5b
 static SUNXI_CCU_GATE_HWS(apb_iommu1_sys_clk, "apb-iommu1-sys", apb0_hws, 0x5b4, BIT(1), 0);
 static SUNXI_CCU_GATE_HWS(ahb_iommu1_sys_clk, "ahb-iommu1-sys", ahb_hws, 0x5b4, BIT(2), 0);
 
+/*
+ * The gates of a powered-off domain in the two bus-matrix registers
+ * (0x5c0, 0x5e0) read back as 0, but the register keeps the written
+ * value. A gate update is a read-modify-write of the whole register,
+ * so toggling one gate while a domain is off closes that domain's
+ * gates. Keep every gate in both registers on, so that neither
+ * register is written after registration.
+ */
 static SUNXI_CCU_GATE_HWS(ahb_ve_dec_clk, "ahb-ve-dec", ahb_hws,
-			  0x5c0, BIT(0), 0);
+			  0x5c0, BIT(0), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_ve_enc_clk, "ahb-ve-enc", ahb_hws,
-			  0x5c0, BIT(1), 0);
+			  0x5c0, BIT(1), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_vid_in_clk, "ahb-vid-in", ahb_hws,
-			  0x5c0, BIT(2), 0);
+			  0x5c0, BIT(2), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_vid_cout0_clk, "ahb-vid-cout0", ahb_hws,
-			  0x5c0, BIT(3), 0);
+			  0x5c0, BIT(3), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_vid_cout1_clk, "ahb-vid-cout1", ahb_hws,
-			  0x5c0, BIT(4), 0);
+			  0x5c0, BIT(4), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_de_clk, "ahb-de", ahb_hws,
-			  0x5c0, BIT(5), 0);
+			  0x5c0, BIT(5), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_npu_clk, "ahb-npu", ahb_hws,
-			  0x5c0, BIT(6), 0);
+			  0x5c0, BIT(6), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_gpu0_clk, "ahb-gpu0", ahb_hws,
-			  0x5c0, BIT(7), 0);
+			  0x5c0, BIT(7), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_serdes_clk, "ahb-serdes", ahb_hws,
-			  0x5c0, BIT(8), 0);
+			  0x5c0, BIT(8), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_usb_sys_clk, "ahb-usb-sys", ahb_hws,
-			  0x5c0, BIT(9), 0);
+			  0x5c0, BIT(9), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_msi_lite0_clk, "ahb-msi-lite0", ahb_hws,
 			  0x5c0, BIT(16), CLK_IS_CRITICAL);
 
 /* This gate controls access to the storage controller MMIO registers. */
 static SUNXI_CCU_GATE_HWS(ahb_store_clk, "ahb-store", ahb_hws,
-			  0x5c0, BIT(24), 0);
+			  0x5c0, BIT(24), CLK_IS_CRITICAL);
 static const struct clk_hw *ahb_store_hws[] = { &ahb_store_clk.common.hw };
 
 /* Keep enabled for access to the CPUS domain registers. */
@@ -592,23 +600,23 @@ static SUNXI_CCU_GATE_HWS(ahb_cpus_clk, "ahb-cpus", ahb_hws,
 			  0x5c0, BIT(28), CLK_IS_CRITICAL);
 
 static SUNXI_CCU_GATE_HWS(mbus_iommu0_clk, "mbus-iommu0", mbus_hws,
-			  0x5e0, BIT(0), 0);
+			  0x5e0, BIT(0), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_iommu1_clk, "mbus-iommu1", mbus_hws,
-			  0x5e0, BIT(1), 0);
+			  0x5e0, BIT(1), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_desys_clk, "mbus-desys", mbus_hws,
-			  0x5e0, BIT(11), 0);
+			  0x5e0, BIT(11), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_ve_enc0_gate_clk, "mbus-ve-enc0-gate", mbus_hws,
-			  0x5e0, BIT(12), 0);
+			  0x5e0, BIT(12), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_ve_dec0_gate_clk, "mbus-ve-dec0-gate", mbus_hws,
-			  0x5e0, BIT(14), 0);
+			  0x5e0, BIT(14), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_gpu0_clk, "mbus-gpu0", mbus_hws,
-			  0x5e0, BIT(16), 0);
+			  0x5e0, BIT(16), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_npu_clk, "mbus-npu", mbus_hws,
-			  0x5e0, BIT(18), 0);
+			  0x5e0, BIT(18), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_vid_in_clk, "mbus-vid-in", mbus_hws,
-			  0x5e0, BIT(24), 0);
+			  0x5e0, BIT(24), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_serdes_clk, "mbus-serdes", mbus_hws,
-			  0x5e0, BIT(28), 0);
+			  0x5e0, BIT(28), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_msi_lite0_clk, "mbus-msi-lite0", mbus_hws,
 			  0x5e0, BIT(29), CLK_IS_CRITICAL);
 
