From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Wed, 14 Oct 2026 10:08:42 +0200
Subject: [PATCH] dt-bindings: media: Add Allwinner A733 2D graphics
 accelerator

The A733 has a 2D graphics accelerator, the G2D (manual section 14.5).
Add its binding, in media with the other 2D memory-to-memory engines.

No existing binding fits. The G2D of the older Allwinner SoCs is not
described by any binding in the tree, and the A733 block sits in the
DE_SYS power domain with the display engine and has its bus master
behind the second IOMMU (manual chapter 10). The four clocks are the
bus gate, the module clock, the MBUS clock enable of the DE_SYS port and
the AHB clock enable of the display engine system (manual sections
4.1.6.109, 4.1.6.108, 4.1.6.83 and 4.1.6.82). Without the last one the
window reads zero and drops writes.

Not covered: the manual describes no register of the block, so nothing
register-level is described.

Tested on Radxa Cubie A7S: with the node enabled for a test, the 2D
accelerator probes with the four clocks, reset, power domain and IOMMU
master this binding names, and its version register reads back while
the block is resumed.

Assisted-by: LLM
---
 .../media/allwinner,sun60i-a733-g2d.yaml      | 87 +++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/allwinner,sun60i-a733-g2d.yaml

diff --git a/Documentation/devicetree/bindings/media/allwinner,sun60i-a733-g2d.yaml b/Documentation/devicetree/bindings/media/allwinner,sun60i-a733-g2d.yaml
new file mode 100644
index 000000000000..55ec78163a05
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/allwinner,sun60i-a733-g2d.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/allwinner,sun60i-a733-g2d.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 2D Graphics Accelerator
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The G2D of the A733 is a 2D graphics accelerator that does blits, fills,
+  rotation and flips, scaling, color space conversion and alpha blending
+  of memory buffers. It sits in the display engine system (DE_SYS) beside
+  the display engine, is powered with it, and its bus master is behind the
+  second IOMMU.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-g2d
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Bus gate (G2D_BGR_REG)
+      - description: Module clock (G2D_CLK_REG)
+      - description: MBUS clock enable of the DE_SYS port
+      - description: AHB clock enable of the display engine system
+
+  clock-names:
+    items:
+      - const: bus
+      - const: mod
+      - const: mbus
+      - const: ahb
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/allwinner,sun60i-a733-pck-600.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    bus {
+        #address-cells = <1>;
+        #size-cells = <1>;
+
+        graphics@5440000 {
+            compatible = "allwinner,sun60i-a733-g2d";
+            reg = <0x05440000 0x40000>;
+            interrupts = <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH>;
+            clocks = <&ccu CLK_BUS_G2D>, <&ccu CLK_G2D>,
+                     <&ccu CLK_MBUS_DESYS>, <&ccu CLK_AHB_DE>;
+            clock-names = "bus", "mod", "mbus", "ahb";
+            resets = <&ccu RST_BUS_G2D>;
+            power-domains = <&pck600 PD_DE_SYS>;
+            iommus = <&iommu1 4>;
+        };
+    };
+
+...
