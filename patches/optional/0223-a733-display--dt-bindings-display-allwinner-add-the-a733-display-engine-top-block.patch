diff --git a/Documentation/devicetree/bindings/display/allwinner,sun60i-a733-de-top.yaml b/Documentation/devicetree/bindings/display/allwinner,sun60i-a733-de-top.yaml
new file mode 100644
index 000000000000..506df89881fe
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/allwinner,sun60i-a733-de-top.yaml
@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/allwinner,sun60i-a733-de-top.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 Display Engine top block
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description: |
+  The top block of the A733 display engine holds the reset and the
+  clock gate of each display, the reset and clock gate of the display
+  engine's MBUS port, and the mux that connects each display to a
+  TCON. It provides the resets and clocks to the mixers and sits in the
+  display pipeline between the mixers and the TCONs:
+
+    mixer0 - [0] DE top [1] - TCON
+    mixer1 - [2] DE top [3] - TCON
+
+  The reg of the endpoint in an input port is the number of the mixer
+  feeding that display (0 on port 0, 1 on port 2). The reg of an
+  endpoint in an output port is the number of the TCON in the
+  DE-to-TCON mux. The vendor device tree (radxa/allwinner-bsp, branch
+  cubie-aiot-v1.4.8, configs/linux-6.6/sun60iw2p1.dtsi) numbers the
+  TCONs the same for both displays:
+
+    tcon0: 0, tcon1: 1, tcon2: 2, tcon3: 4, tcon4: 5
+
+  Only 5, for TCON TV1, has been read back on silicon.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-de-top
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: AHB bus matrix gate of the display engine
+      - description: Display engine bus clock
+      - description: Display engine module clock
+      - description: MBUS gate of the display engine
+
+  clock-names:
+    items:
+      - const: ahb
+      - const: bus
+      - const: mod
+      - const: mbus
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  "#clock-cells":
+    const: 1
+
+  "#reset-cells":
+    const: 1
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Input endpoint for display 0, from mixer 0
+
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Output endpoints for display 0, to the TCONs
+
+      port@2:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Input endpoint for display 1, from mixer 1
+
+      port@3:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Output endpoints for display 1, to the TCONs
+
+    required:
+      - port@0
+      - port@1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - power-domains
+  - "#clock-cells"
+  - "#reset-cells"
+  - ports
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/power/allwinner,sun60i-a733-pck-600.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    de_top: clock-controller@5008000 {
+        compatible = "allwinner,sun60i-a733-de-top";
+        reg = <0x05008000 0x100>;
+        clocks = <&ccu CLK_AHB_DE>, <&ccu CLK_BUS_DE0>, <&ccu CLK_DE0>,
+                 <&ccu CLK_MBUS_DESYS>;
+        clock-names = "ahb", "bus", "mod", "mbus";
+        resets = <&ccu RST_BUS_DE0>;
+        power-domains = <&pck600 PD_DE_SYS>;
+        #clock-cells = <1>;
+        #reset-cells = <1>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                de_top_in_mixer0: endpoint {
+                    remote-endpoint = <&mixer0_out_de_top>;
+                };
+            };
+
+            port@1 {
+                #address-cells = <1>;
+                #size-cells = <0>;
+                reg = <1>;
+
+                de_top_disp0_out_tcon_tv1: endpoint@5 {
+                    reg = <5>;
+                    remote-endpoint = <&tcon_tv1_in_de_top>;
+                };
+            };
+        };
+    };
+
+...
diff --git a/include/dt-bindings/clock/allwinner,sun60i-a733-de-top.h b/include/dt-bindings/clock/allwinner,sun60i-a733-de-top.h
new file mode 100644
index 000000000000..b2ae60d4bc7d
--- /dev/null
+++ b/include/dt-bindings/clock/allwinner,sun60i-a733-de-top.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+
+#ifndef _DT_BINDINGS_CLOCK_SUN60I_A733_DE_TOP_H_
+#define _DT_BINDINGS_CLOCK_SUN60I_A733_DE_TOP_H_
+
+#define CLK_DE_TOP_DISP0	0
+#define CLK_DE_TOP_DISP1	1
+#define CLK_DE_TOP_DISP2	2
+#define CLK_DE_TOP_DISP3	3
+#define CLK_DE_TOP_MBUS		4	/* held by de_top */
+
+#endif /* _DT_BINDINGS_CLOCK_SUN60I_A733_DE_TOP_H_ */
diff --git a/include/dt-bindings/reset/allwinner,sun60i-a733-de-top.h b/include/dt-bindings/reset/allwinner,sun60i-a733-de-top.h
new file mode 100644
index 000000000000..15732da8d923
--- /dev/null
+++ b/include/dt-bindings/reset/allwinner,sun60i-a733-de-top.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+
+#ifndef _DT_BINDINGS_RESET_SUN60I_A733_DE_TOP_H_
+#define _DT_BINDINGS_RESET_SUN60I_A733_DE_TOP_H_
+
+#define RST_DE_TOP_DISP0	0
+#define RST_DE_TOP_DISP1	1
+#define RST_DE_TOP_DISP2	2
+#define RST_DE_TOP_DISP3	3
+#define RST_DE_TOP_MBUS		4	/* held by de_top */
+
+#endif /* _DT_BINDINGS_RESET_SUN60I_A733_DE_TOP_H_ */
