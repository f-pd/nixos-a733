From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Fri, 9 Oct 2026 18:01:13 +0200
Subject: [PATCH] dt-bindings: clock: Add the Allwinner A733 video output 1
 clock unit

The VIDEO_OUT1_SYS block of the A733 selects whether each of the two
TCON TVs takes its clock from the HDMI or the eDP side and gates the
clocks of both TCONs and the clock from TCON TV0 to HDMI (user manual
sections 15.2.9.1 and 15.2.9.2). A TCON TV has no pixel clock until this
block is set up.

Its two registers hold clock source selects and clock gates only, no
display route: the DE-to-TCON route is in the display engine top block.
Add a binding for it as a clock unit, as for the DE2 clock unit of the
display engine. Figure 15-18 of the user manual draws its registers as
the DPSS top registers of the video output 1 subsystem, so its bus
clock and reset are taken to be those of DPSS_TOP1 in the CCU, together
with the video output 1 gate of the AHB bus matrix.

Not covered: the CVBS clock sources of the TCON TVs and the HDMI PHY
clock source of TCON TV0.

Tested on Radxa Cubie A7S: booted on one board with a device tree that
uses this binding; the clock unit probes and dtbs_check reports nothing.

Assisted-by: LLM
---
 .../clock/allwinner,sun60i-a733-vo1-ccu.yaml  | 78 +++++++++++++++++++
 .../clock/allwinner,sun60i-a733-vo1-ccu.h     | 12 +++
 2 files changed, 90 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-vo1-ccu.yaml
 create mode 100644 include/dt-bindings/clock/allwinner,sun60i-a733-vo1-ccu.h

diff --git a/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-vo1-ccu.yaml b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-vo1-ccu.yaml
new file mode 100644
index 000000000000..2a4d5ce34064
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-vo1-ccu.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/allwinner,sun60i-a733-vo1-ccu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 video output 1 clock unit
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description: |
+  The video output 1 block (VIDEO_OUT1_SYS) of the A733 selects whether
+  each of the two TCON TVs takes its clock from the HDMI or the eDP side,
+  and gates the clocks of both TCONs and the clock from TCON TV0 to HDMI.
+
+  The indices of the clocks it provides are in
+  dt-bindings/clock/allwinner,sun60i-a733-vo1-ccu.h.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-vo1-ccu
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    minItems: 3
+    items:
+      - description: AHB bus matrix gate of the video output 1 block
+      - description: Bus clock of the block
+      - description: TCON TV clock of the eDP side
+      - description: TCON TV clock of the HDMI side
+
+  clock-names:
+    minItems: 3
+    items:
+      - const: ahb
+      - const: bus
+      - const: edp
+      - const: hdmi
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/clock/allwinner,sun60i-a733-vo1-ccu.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    vo1_ccu: clock-controller@5510000 {
+        compatible = "allwinner,sun60i-a733-vo1-ccu";
+        reg = <0x05510000 0x1000>;
+        clocks = <&ccu CLK_AHB_VID_COUT1>, <&ccu CLK_BUS_DPSS_TOP1>,
+                 <&ccu CLK_EDP_TV>;
+        clock-names = "ahb", "bus", "edp";
+        resets = <&ccu RST_BUS_DPSS_TOP1>;
+        #clock-cells = <1>;
+        assigned-clocks = <&vo1_ccu CLK_VO1_TV1_SEL>;
+        assigned-clock-parents = <&ccu CLK_EDP_TV>;
+    };
diff --git a/include/dt-bindings/clock/allwinner,sun60i-a733-vo1-ccu.h b/include/dt-bindings/clock/allwinner,sun60i-a733-vo1-ccu.h
new file mode 100644
index 000000000000..b073e96c6c7d
--- /dev/null
+++ b/include/dt-bindings/clock/allwinner,sun60i-a733-vo1-ccu.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+
+#ifndef _DT_BINDINGS_CLOCK_SUN60I_A733_VO1_CCU_H_
+#define _DT_BINDINGS_CLOCK_SUN60I_A733_VO1_CCU_H_
+
+#define CLK_VO1_TV0_SEL		0
+#define CLK_VO1_TV1_SEL		1
+#define CLK_VO1_TV0		2
+#define CLK_VO1_TV1		3
+#define CLK_VO1_TV0_HDMI	4
+
+#endif /* _DT_BINDINGS_CLOCK_SUN60I_A733_VO1_CCU_H_ */
