From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 20:33:12 +0200
Subject: [PATCH] ASoC: sun4i-i2s: Keep the FIFO across a pause

sun4i_i2s_trigger() runs the same start path for START, RESUME and
PAUSE_RELEASE, and that path flushes the FIFO and clears the sample
counter. After a pause the FIFO still holds samples the DMA delivered
before the pause, so the release drops up to a full FIFO of audio.

Flush only on START and RESUME. PAUSE_PUSH clears only the enable and
DRQ bits, so the FIFO is intact when the stream continues.

Tested on Radxa Cubie A7S: on two boards an I2S stream running through
the controller's internal loop was paused and released; while paused the
DMA channel and the TX FIFO stood still, and the stream went on with the
next frame, none lost and none repeated.

Assisted-by: LLM
---
 sound/soc/sunxi/sun4i-i2s.c | 42 +++++++++++++++++++++----------------
 1 file changed, 24 insertions(+), 18 deletions(-)

diff --git a/sound/soc/sunxi/sun4i-i2s.c b/sound/soc/sunxi/sun4i-i2s.c
index 716fa4d872ff..8c2a5070f0b9 100644
--- a/sound/soc/sunxi/sun4i-i2s.c
+++ b/sound/soc/sunxi/sun4i-i2s.c
@@ -959,15 +959,17 @@ static int sun4i_i2s_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
 	return 0;
 }
 
-static void sun4i_i2s_start_capture(struct sun4i_i2s *i2s)
+static void sun4i_i2s_start_capture(struct sun4i_i2s *i2s, bool flush)
 {
-	/* Flush RX FIFO */
-	regmap_update_bits(i2s->regmap, SUN4I_I2S_FIFO_CTRL_REG,
-			   SUN4I_I2S_FIFO_CTRL_FLUSH_RX,
-			   SUN4I_I2S_FIFO_CTRL_FLUSH_RX);
-
-	/* Clear RX counter */
-	regmap_write(i2s->regmap, SUN4I_I2S_RX_CNT_REG, 0);
+	if (flush) {
+		/* Flush RX FIFO */
+		regmap_update_bits(i2s->regmap, SUN4I_I2S_FIFO_CTRL_REG,
+				   SUN4I_I2S_FIFO_CTRL_FLUSH_RX,
+				   SUN4I_I2S_FIFO_CTRL_FLUSH_RX);
+
+		/* Clear RX counter */
+		regmap_write(i2s->regmap, SUN4I_I2S_RX_CNT_REG, 0);
+	}
 
 	/* Enable RX Block */
 	regmap_update_bits(i2s->regmap, SUN4I_I2S_CTRL_REG,
@@ -980,15 +982,17 @@ static void sun4i_i2s_start_capture(struct sun4i_i2s *i2s)
 			   SUN4I_I2S_DMA_INT_CTRL_RX_DRQ_EN);
 }
 
-static void sun4i_i2s_start_playback(struct sun4i_i2s *i2s)
+static void sun4i_i2s_start_playback(struct sun4i_i2s *i2s, bool flush)
 {
-	/* Flush TX FIFO */
-	regmap_update_bits(i2s->regmap, SUN4I_I2S_FIFO_CTRL_REG,
-			   SUN4I_I2S_FIFO_CTRL_FLUSH_TX,
-			   SUN4I_I2S_FIFO_CTRL_FLUSH_TX);
-
-	/* Clear TX counter */
-	regmap_write(i2s->regmap, SUN4I_I2S_TX_CNT_REG, 0);
+	if (flush) {
+		/* Flush TX FIFO */
+		regmap_update_bits(i2s->regmap, SUN4I_I2S_FIFO_CTRL_REG,
+				   SUN4I_I2S_FIFO_CTRL_FLUSH_TX,
+				   SUN4I_I2S_FIFO_CTRL_FLUSH_TX);
+
+		/* Clear TX counter */
+		regmap_write(i2s->regmap, SUN4I_I2S_TX_CNT_REG, 0);
+	}
 
 	/* Enable TX Block */
 	regmap_update_bits(i2s->regmap, SUN4I_I2S_CTRL_REG,
@@ -1031,15 +1035,17 @@ static int sun4i_i2s_trigger(struct snd_pcm_substream *substream, int cmd,
 			     struct snd_soc_dai *dai)
 {
 	struct sun4i_i2s *i2s = snd_soc_dai_get_drvdata(dai);
+	/* After a pause the FIFO still holds the next samples of the stream */
+	bool flush = cmd != SNDRV_PCM_TRIGGER_PAUSE_RELEASE;
 
 	switch (cmd) {
 	case SNDRV_PCM_TRIGGER_START:
 	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
 	case SNDRV_PCM_TRIGGER_RESUME:
 		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
-			sun4i_i2s_start_playback(i2s);
+			sun4i_i2s_start_playback(i2s, flush);
 		else
-			sun4i_i2s_start_capture(i2s);
+			sun4i_i2s_start_capture(i2s, flush);
 		break;
 
 	case SNDRV_PCM_TRIGGER_STOP:
