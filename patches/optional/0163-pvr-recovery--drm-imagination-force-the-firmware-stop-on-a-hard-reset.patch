From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Mon, 5 Oct 2026 07:05:06 +0200
Subject: [PATCH] drm/imagination: Force the firmware stop on a hard reset

pvr_power_reset() only reaches pvr_fw_hard_reset() when
pvr_power_fw_disable() succeeds, and on a hard reset that is
pvr_fw_stop(). pvr_fw_stop() first polls ROGUE_CR_SIDEKICK_IDLE with a
1 s timeout. A stuck GPU does not go idle, the poll times out, and the
reset declares the device lost without resetting anything.

Skipping the failed poll is not enough: pvr_fw_stop() is also the only
quiesce before the GPU clocks are gated, and a clock stopped under a
busy block can hang the interconnect.

Add a forced stop. It walks the same drain sequence with 10 ms per poll,
logs a poll that times out instead of returning it, puts the core into
soft reset whether it went idle or not, asserts SOFT_RESET2 where
pvr_fw_start() does, and reads both registers back before the caller
gates the clocks. The META TxVECINT_BHALT read is skipped in this mode,
since it polls with its own 1 s timeout. Use the forced stop for a hard
reset and for a firmware that failed to boot; the graceful stop of
runtime suspend is unchanged.

Not covered: a GPU whose bus is wedged so that register accesses do not
complete.

Tested on Radxa Cubie A7S: not tested; the test system submits no GPU
jobs, so this path was not reached.

Assisted-by: LLM
---
 .../gpu/drm/imagination/pvr_fw_startstop.c    | 135 +++++++++++++++---
 .../gpu/drm/imagination/pvr_fw_startstop.h    |   1 +
 drivers/gpu/drm/imagination/pvr_power.c       |  18 ++-
 3 files changed, 131 insertions(+), 23 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_fw_startstop.c b/drivers/gpu/drm/imagination/pvr_fw_startstop.c
index e24ed6fc4362..54b9ea09fe67 100644
--- a/drivers/gpu/drm/imagination/pvr_fw_startstop.c
+++ b/drivers/gpu/drm/imagination/pvr_fw_startstop.c
@@ -9,6 +9,7 @@
 #include "pvr_rogue_meta.h"
 #include "pvr_vm.h"
 
+#include <drm/drm_print.h>
 #include <linux/compiler.h>
 #include <linux/delay.h>
 #include <linux/ktime.h>
@@ -16,6 +17,13 @@
 
 #define POLL_TIMEOUT_USEC 1000000
 
+/*
+ * A forced stop runs on a GPU that did not go idle. Each drain poll still gets
+ * a short chance to settle, but seven polls at POLL_TIMEOUT_USEC would hold the
+ * recovery for seven seconds to learn what the caller already knows.
+ */
+#define FORCE_POLL_TIMEOUT_USEC 10000
+
 static void
 rogue_axi_ace_list_init(struct pvr_device *pvr_dev)
 {
@@ -193,22 +201,53 @@ pvr_fw_start(struct pvr_device *pvr_dev)
 	return err;
 }
 
-/**
- * pvr_fw_stop() - Stop FW processor
- * @pvr_dev: Target PowerVR device.
+/*
+ * pvr_fw_stop_poll_result() - Decide what a failed idle poll means
  *
- * Returns:
- *  * 0 on success, or
- *  * Any error returned by pvr_cr_poll_reg32().
+ * A graceful stop gives up on the first poll that times out. A forced stop
+ * records it and carries on, because the soft reset at the end is the point.
  */
-int
-pvr_fw_stop(struct pvr_device *pvr_dev)
+static int
+pvr_fw_stop_poll_result(int err, bool force, bool *not_idle)
+{
+	if (err && force) {
+		*not_idle = true;
+		return 0;
+	}
+
+	return err;
+}
+
+/*
+ * pvr_fw_stop_fence_reset() - Finish a forced soft reset before the clocks go
+ *
+ * The caller gates the GPU clocks next. A reset write still in the SOCIF
+ * pipeline when its clock stops leaves a live core behind, so assert
+ * SOFT_RESET2 as pvr_fw_start() does and read both registers back.
+ */
+static void
+pvr_fw_stop_fence_reset(struct pvr_device *pvr_dev)
+{
+	bool has_reset2 = PVR_HAS_FEATURE(pvr_dev, xe_tpu2);
+
+	if (has_reset2)
+		pvr_cr_write64(pvr_dev, ROGUE_CR_SOFT_RESET2, ROGUE_CR_SOFT_RESET2_MASKFULL);
+
+	(void)pvr_cr_read64(pvr_dev, ROGUE_CR_SOFT_RESET);
+	if (has_reset2)
+		(void)pvr_cr_read64(pvr_dev, ROGUE_CR_SOFT_RESET2);
+}
+
+static int
+__pvr_fw_stop(struct pvr_device *pvr_dev, bool force)
 {
 	const u32 sidekick_idle_mask = ROGUE_CR_SIDEKICK_IDLE_MASKFULL &
 				       ~(ROGUE_CR_SIDEKICK_IDLE_GARTEN_EN |
 					 ROGUE_CR_SIDEKICK_IDLE_SOCIF_EN |
 					 ROGUE_CR_SIDEKICK_IDLE_HOSTIF_EN);
+	const u64 poll_timeout = force ? FORCE_POLL_TIMEOUT_USEC : POLL_TIMEOUT_USEC;
 	bool skip_garten_idle = false;
+	bool not_idle = false;
 	u64 layout_mars_value = 0;
 	bool layout_mars = false;
 	bool meta_fw = pvr_dev->fw_dev.processor_type == PVR_FW_PROCESSOR_TYPE_META;
@@ -225,13 +264,15 @@ pvr_fw_stop(struct pvr_device *pvr_dev)
 	if (!layout_mars) {
 		/* Wait for Sidekick/Jones to signal IDLE except for the Garten Wrapper. */
 		err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_SIDEKICK_IDLE, sidekick_idle_mask,
-					sidekick_idle_mask, POLL_TIMEOUT_USEC);
+					sidekick_idle_mask, poll_timeout);
+		err = pvr_fw_stop_poll_result(err, force, &not_idle);
 		if (err)
 			return err;
 
 		/* Wait for SLC to signal IDLE. */
 		err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_SLC_IDLE, ROGUE_CR_SLC_IDLE_MASKFULL,
-					ROGUE_CR_SLC_IDLE_MASKFULL, POLL_TIMEOUT_USEC);
+					ROGUE_CR_SLC_IDLE_MASKFULL, poll_timeout);
+		err = pvr_fw_stop_poll_result(err, force, &not_idle);
 		if (err)
 			return err;
 	}
@@ -256,33 +297,38 @@ pvr_fw_stop(struct pvr_device *pvr_dev)
 	/* Extra Idle checks. */
 	err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_BIF_STATUS_MMU, 0,
 				ROGUE_CR_BIF_STATUS_MMU_MASKFULL,
-				POLL_TIMEOUT_USEC);
+				poll_timeout);
+	err = pvr_fw_stop_poll_result(err, force, &not_idle);
 	if (err)
 		return err;
 
 	err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_BIFPM_STATUS_MMU, 0,
 				ROGUE_CR_BIFPM_STATUS_MMU_MASKFULL,
-				POLL_TIMEOUT_USEC);
+				poll_timeout);
+	err = pvr_fw_stop_poll_result(err, force, &not_idle);
 	if (err)
 		return err;
 
 	if (!PVR_HAS_FEATURE(pvr_dev, xt_top_infrastructure)) {
 		err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_BIF_READS_EXT_STATUS, 0,
 					ROGUE_CR_BIF_READS_EXT_STATUS_MASKFULL,
-					POLL_TIMEOUT_USEC);
+					poll_timeout);
+		err = pvr_fw_stop_poll_result(err, force, &not_idle);
 		if (err)
 			return err;
 	}
 
 	err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_BIFPM_READS_EXT_STATUS, 0,
 				ROGUE_CR_BIFPM_READS_EXT_STATUS_MASKFULL,
-				POLL_TIMEOUT_USEC);
+				poll_timeout);
+	err = pvr_fw_stop_poll_result(err, force, &not_idle);
 	if (err)
 		return err;
 
 	err = pvr_cr_poll_reg64(pvr_dev, ROGUE_CR_SLC_STATUS1, 0,
 				ROGUE_CR_SLC_STATUS1_MASKFULL,
-				POLL_TIMEOUT_USEC);
+				poll_timeout);
+	err = pvr_fw_stop_poll_result(err, force, &not_idle);
 	if (err)
 		return err;
 
@@ -294,18 +340,25 @@ pvr_fw_stop(struct pvr_device *pvr_dev)
 		/* Wait for SLC to signal IDLE. */
 		err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_SLC_IDLE,
 					ROGUE_CR_SLC_IDLE_MASKFULL,
-					ROGUE_CR_SLC_IDLE_MASKFULL, POLL_TIMEOUT_USEC);
+					ROGUE_CR_SLC_IDLE_MASKFULL, poll_timeout);
+		err = pvr_fw_stop_poll_result(err, force, &not_idle);
 		if (err)
 			return err;
 
 		/* Wait for Sidekick/Jones to signal IDLE except for the Garten Wrapper. */
 		err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_SIDEKICK_IDLE, sidekick_idle_mask,
-					sidekick_idle_mask, POLL_TIMEOUT_USEC);
+					sidekick_idle_mask, poll_timeout);
+		err = pvr_fw_stop_poll_result(err, force, &not_idle);
 		if (err)
 			return err;
 	}
 
-	if (meta_fw) {
+	/*
+	 * A forced stop skips this read: pvr_meta_cr_read32() polls the META slave
+	 * port with its own POLL_TIMEOUT_USEC, which the short leash cannot cover.
+	 * The Garten poll below then runs on that leash instead.
+	 */
+	if (meta_fw && !force) {
 		err = pvr_meta_cr_read32(pvr_dev, META_CR_TxVECINT_BHALT, &reg_value);
 		if (err)
 			return err;
@@ -324,7 +377,8 @@ pvr_fw_stop(struct pvr_device *pvr_dev)
 			err = pvr_cr_poll_reg32(pvr_dev, ROGUE_CR_SIDEKICK_IDLE,
 						ROGUE_CR_SIDEKICK_IDLE_GARTEN_EN,
 						ROGUE_CR_SIDEKICK_IDLE_GARTEN_EN,
-						POLL_TIMEOUT_USEC);
+						poll_timeout);
+			err = pvr_fw_stop_poll_result(err, force, &not_idle);
 			if (err)
 				return err;
 		}
@@ -339,17 +393,56 @@ pvr_fw_stop(struct pvr_device *pvr_dev)
 					ROGUE_CR_MARS_IDLE_MH_SYSARB0_EN,
 					ROGUE_CR_MARS_IDLE_CPU_EN |
 					ROGUE_CR_MARS_IDLE_MH_SYSARB0_EN,
-					POLL_TIMEOUT_USEC);
-
+					poll_timeout);
+		err = pvr_fw_stop_poll_result(err, force, &not_idle);
 		if (err)
 			return err;
 	}
 
+	if (not_idle)
+		drm_err(from_pvr_device(pvr_dev),
+			"GPU did not go idle, forcing soft reset with transactions possibly in flight\n");
+
 	if (PVR_HAS_FEATURE(pvr_dev, pbe2_in_xe))
 		pvr_cr_write64(pvr_dev, ROGUE_CR_SOFT_RESET,
 			       ROGUE_CR_SOFT_RESET__PBE2_XE__MASKFULL);
 	else
 		pvr_cr_write64(pvr_dev, ROGUE_CR_SOFT_RESET, ROGUE_CR_SOFT_RESET_MASKFULL);
 
+	if (force)
+		pvr_fw_stop_fence_reset(pvr_dev);
+
 	return 0;
 }
+
+/**
+ * pvr_fw_stop() - Stop FW processor
+ * @pvr_dev: Target PowerVR device.
+ *
+ * Returns:
+ *  * 0 on success, or
+ *  * Any error returned by pvr_cr_poll_reg32().
+ */
+int
+pvr_fw_stop(struct pvr_device *pvr_dev)
+{
+	return __pvr_fw_stop(pvr_dev, false);
+}
+
+/**
+ * pvr_fw_stop_force() - Stop FW processor on a GPU that will not go idle
+ * @pvr_dev: Target PowerVR device.
+ *
+ * Walks the same drain sequence as pvr_fw_stop() on a short timeout and puts
+ * the core into soft reset whether or not it went idle, while its clocks still
+ * run. For the hard reset path, where the graceful stop can only time out, and
+ * for a firmware that failed to boot.
+ *
+ * Returns:
+ *  * 0 always; a poll that times out is logged, not returned.
+ */
+int
+pvr_fw_stop_force(struct pvr_device *pvr_dev)
+{
+	return __pvr_fw_stop(pvr_dev, true);
+}
diff --git a/drivers/gpu/drm/imagination/pvr_fw_startstop.h b/drivers/gpu/drm/imagination/pvr_fw_startstop.h
index a3cef061bd60..ba5b419a2591 100644
--- a/drivers/gpu/drm/imagination/pvr_fw_startstop.h
+++ b/drivers/gpu/drm/imagination/pvr_fw_startstop.h
@@ -9,5 +9,6 @@ struct pvr_device;
 
 int pvr_fw_start(struct pvr_device *pvr_dev);
 int pvr_fw_stop(struct pvr_device *pvr_dev);
+int pvr_fw_stop_force(struct pvr_device *pvr_dev);
 
 #endif /* PVR_FW_STARTSTOP_H */
diff --git a/drivers/gpu/drm/imagination/pvr_power.c b/drivers/gpu/drm/imagination/pvr_power.c
index d70dd165eb17..75058f774c73 100644
--- a/drivers/gpu/drm/imagination/pvr_power.c
+++ b/drivers/gpu/drm/imagination/pvr_power.c
@@ -126,7 +126,16 @@ pvr_power_fw_disable(struct pvr_device *pvr_dev, bool hard_reset, bool rpm_suspe
 		disable_irq(pvr_dev->irq);
 	}
 
-	err = pvr_fw_stop(pvr_dev);
+	/*
+	 * A hard reset answers a GPU that is already stuck. The graceful stop
+	 * waits for idle first and can only time out there, which sends
+	 * pvr_power_reset() to "device lost" with nothing reset.
+	 */
+	if (hard_reset)
+		err = pvr_fw_stop_force(pvr_dev);
+	else
+		err = pvr_fw_stop(pvr_dev);
+
 	if (err && rpm_suspend)
 		enable_irq(pvr_dev->irq);
 
@@ -148,7 +157,12 @@ pvr_power_fw_enable(struct pvr_device *pvr_dev, bool rpm_resume)
 	err = pvr_wait_for_fw_boot(pvr_dev);
 	if (err) {
 		drm_err(from_pvr_device(pvr_dev), "Firmware failed to boot\n");
-		pvr_fw_stop(pvr_dev);
+		/*
+		 * Nothing booted, so nothing to drain. The graceful stop would give
+		 * up at its first 1 s poll without writing SOFT_RESET, and a resume
+		 * gates the clocks right after this returns.
+		 */
+		pvr_fw_stop_force(pvr_dev);
 		goto out;
 	}
 
