From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Thu, 15 Oct 2026 15:25:10 +0200
Subject: [PATCH] drm/sun4i: ui_layer, vi_layer: Let DRM manage the planes

sun4i_drv no longer calls drm_mode_config_cleanup() itself (drm/sun4i:
drv: Do not call drm_mode_config_cleanup()). The managed release of
drm_mode_config_init() destroys the mode objects at the last
drm_dev_put() instead, after component_unbind_all(), and, while
userspace still holds the device open, after the display engine device
has released its devres.

The planes of the sun8i mixer live in devm memory of the display engine
device and are destroyed through .destroy, so they are cleaned up on
freed memory in that case.

Allocate and initialise them with drmm_universal_plane_alloc(), which
registers drm_plane_cleanup() as a managed action and frees the memory
after it. The managed variant wants a NULL .destroy, so drop the hook.
The VI layer picks its format list from the configuration it is given,
not from the layer, as the layer exists only after the allocation, and
the fields of both layers are set after it.

Not covered: the planes of the display backend, converted separately.

Tested on Radxa Cubie A7S: the DisplayPort device unbound and bound
again three times with a monitor attached, without an oops; the picture
returns after each bind.

Assisted-by: LLM
---
 drivers/gpu/drm/sun4i/sun8i_ui_layer.c | 26 ++++++++----------
 drivers/gpu/drm/sun4i/sun8i_vi_layer.c | 38 ++++++++++++--------------
 2 files changed, 28 insertions(+), 36 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
index 00756ab78b4e..d9f6a2bcc14f 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
@@ -18,6 +18,7 @@
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_gem_atomic_helper.h>
 #include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_managed.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
 
@@ -211,7 +212,6 @@ static const struct drm_plane_helper_funcs sun8i_ui_layer_helper_funcs = {
 static const struct drm_plane_funcs sun8i_ui_layer_funcs = {
 	.atomic_destroy_state	= drm_atomic_helper_plane_destroy_state,
 	.atomic_duplicate_state	= drm_atomic_helper_plane_duplicate_state,
-	.destroy		= drm_plane_cleanup,
 	.disable_plane		= drm_atomic_helper_disable_plane,
 	.reset			= drm_atomic_helper_plane_reset,
 	.update_plane		= drm_atomic_helper_update_plane,
@@ -255,9 +255,16 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 	struct sun8i_layer *layer;
 	int ret;
 
-	layer = devm_kzalloc(drm->dev, sizeof(*layer), GFP_KERNEL);
-	if (!layer)
-		return ERR_PTR(-ENOMEM);
+	/* possible crtcs are set later */
+	layer = drmm_universal_plane_alloc(drm, struct sun8i_layer, plane, 0,
+					   &sun8i_ui_layer_funcs,
+					   sun8i_ui_layer_formats,
+					   ARRAY_SIZE(sun8i_ui_layer_formats),
+					   sun8i_layer_modifiers, type, NULL);
+	if (IS_ERR(layer)) {
+		dev_err(drm->dev, "Couldn't initialize layer\n");
+		return layer;
+	}
 
 	layer->type = SUN8I_LAYER_TYPE_UI;
 	layer->index = index;
@@ -266,17 +273,6 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 	layer->regs = regs;
 	layer->cfg = cfg;
 
-	/* possible crtcs are set later */
-	ret = drm_universal_plane_init(drm, &layer->plane, 0,
-				       &sun8i_ui_layer_funcs,
-				       sun8i_ui_layer_formats,
-				       ARRAY_SIZE(sun8i_ui_layer_formats),
-				       sun8i_layer_modifiers, type, NULL);
-	if (ret) {
-		dev_err(drm->dev, "Couldn't initialize layer\n");
-		return ERR_PTR(ret);
-	}
-
 	ret = drm_plane_create_alpha_property(&layer->plane);
 	if (ret) {
 		dev_err(drm->dev, "Couldn't add alpha property\n");
diff --git a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
index 8711f8a1b6c6..17252b6a0afc 100644
--- a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
@@ -14,6 +14,7 @@
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_gem_atomic_helper.h>
 #include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_managed.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
 
@@ -316,7 +317,6 @@ static const struct drm_plane_helper_funcs sun8i_vi_layer_helper_funcs = {
 static const struct drm_plane_funcs sun8i_vi_layer_funcs = {
 	.atomic_destroy_state	= drm_atomic_helper_plane_destroy_state,
 	.atomic_duplicate_state	= drm_atomic_helper_plane_duplicate_state,
-	.destroy		= drm_plane_cleanup,
 	.disable_plane		= drm_atomic_helper_disable_plane,
 	.reset			= drm_atomic_helper_plane_reset,
 	.update_plane		= drm_atomic_helper_update_plane,
@@ -447,18 +447,7 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 	const u32 *formats;
 	int ret;
 
-	layer = devm_kzalloc(drm->dev, sizeof(*layer), GFP_KERNEL);
-	if (!layer)
-		return ERR_PTR(-ENOMEM);
-
-	layer->type = SUN8I_LAYER_TYPE_VI;
-	layer->index = index;
-	layer->channel = phy_index;
-	layer->overlay = 0;
-	layer->regs = regs;
-	layer->cfg = cfg;
-
-	if (layer->cfg->de_type >= SUN8I_MIXER_DE3) {
+	if (cfg->de_type >= SUN8I_MIXER_DE3) {
 		formats = sun8i_vi_layer_de3_formats;
 		format_count = ARRAY_SIZE(sun8i_vi_layer_de3_formats);
 	} else {
@@ -466,7 +455,7 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 		format_count = ARRAY_SIZE(sun8i_vi_layer_formats);
 	}
 
-	if (layer->cfg->rgb_only) {
+	if (cfg->rgb_only) {
 		rgb_formats = sun8i_vi_layer_rgb_formats(formats,
 							 &format_count);
 		if (!rgb_formats)
@@ -475,17 +464,24 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 	}
 
 	/* possible crtcs are set later */
-	ret = drm_universal_plane_init(drm, &layer->plane, 0,
-				       &sun8i_vi_layer_funcs,
-				       formats, format_count,
-				       sun8i_layer_modifiers,
-				       type, NULL);
+	layer = drmm_universal_plane_alloc(drm, struct sun8i_layer, plane, 0,
+					   &sun8i_vi_layer_funcs,
+					   formats, format_count,
+					   sun8i_layer_modifiers,
+					   type, NULL);
 	kfree(rgb_formats);
-	if (ret) {
+	if (IS_ERR(layer)) {
 		dev_err(drm->dev, "Couldn't initialize layer\n");
-		return ERR_PTR(ret);
+		return layer;
 	}
 
+	layer->type = SUN8I_LAYER_TYPE_VI;
+	layer->index = index;
+	layer->channel = phy_index;
+	layer->overlay = 0;
+	layer->regs = regs;
+	layer->cfg = cfg;
+
 	if (layer->cfg->de2_fcc_alpha || layer->cfg->de_type >= SUN8I_MIXER_DE3) {
 		ret = drm_plane_create_alpha_property(&layer->plane);
 		if (ret) {
