From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Fri, 9 Oct 2026 16:48:29 +0200
Subject: [PATCH] drm/sun4i: crtc: Capture the frame CRCs of a DisplayPort sink

The sun4i CRTCs have no CRC source, so a picture can only be checked by
eye. A DisplayPort sink can compute the CRCs of the frames it receives
and report them through its test registers, which drm_dp_helper reads
for the DRM CRC capture.

Add the "auto" CRC source to the CRTC when the A733 DisplayPort driver
is reachable: it forwards to the transmitter that drives the CRTC's
DisplayPort connector, which starts or stops the capture on its AUX
channel, as the Rockchip VOP does with the Analogix transmitter. As
there, the TCON module then depends on the DisplayPort module when both
are modules; a built-in TCON with a modular transmitter has no CRC
source.

The capture stops at the connector it started at, which the CRTC keeps,
and the transmitter finds its bridge through the encoder of that
connector, not through the connector state. The connector can leave the
CRTC while the file is open, by a modeset that turns the CRTC off and
detaches it. A stop that looked for the connector of the CRTC would then
fail, and the sink would go on computing CRCs (DP_TEST_SINK_START stays
set).

Not covered: the capture is not stopped when the CRTC is turned off.
drm_dp_stop_crc() waits for the worker, which polls until the file is
closed, so the disable path cannot call it; the worker has to end by
itself.

Tested on Radxa Cubie A7S: booted on one board with a DisplayPort
monitor; with the CRC file open, a modeset detached the connector from
the CRTC, and closing the file then stopped the CRC computation of the
sink, which stayed on without the patch; after the connector was
restored, the CRC that the sink computes for a white picture was the
expected one.

Assisted-by: LLM
---
 drivers/gpu/drm/sun4i/sun4i_crtc.c | 72 ++++++++++++++++++++++++++++++
 drivers/gpu/drm/sun4i/sun4i_crtc.h |  3 ++
 drivers/gpu/drm/sun4i/sun60i_dp.c  | 50 +++++++++++++++++++++
 drivers/gpu/drm/sun4i/sun60i_dp.h  | 11 +++++
 4 files changed, 136 insertions(+)
 create mode 100644 drivers/gpu/drm/sun4i/sun60i_dp.h

diff --git a/drivers/gpu/drm/sun4i/sun4i_crtc.c b/drivers/gpu/drm/sun4i/sun4i_crtc.c
index 55d507d477e5..55312a0115ce 100644
--- a/drivers/gpu/drm/sun4i/sun4i_crtc.c
+++ b/drivers/gpu/drm/sun4i/sun4i_crtc.c
@@ -12,6 +12,7 @@
 #include <linux/of_graph.h>
 #include <linux/of_irq.h>
 #include <linux/regmap.h>
+#include <linux/string.h>
 
 #include <video/videomode.h>
 
@@ -28,6 +29,7 @@
 #include "sun4i_drv.h"
 #include "sunxi_engine.h"
 #include "sun4i_tcon.h"
+#include "sun60i_dp.h"
 
 /*
  * While this isn't really working in the DRM theory, in practice we
@@ -187,6 +189,72 @@ static void sun4i_crtc_disable_vblank(struct drm_crtc *crtc)
 	sun4i_tcon_enable_vblank(scrtc->tcon, false);
 }
 
+#if IS_REACHABLE(CONFIG_DRM_SUN60I_DP)
+static struct drm_connector *sun4i_crtc_get_dp_connector(struct drm_crtc *crtc)
+{
+	struct drm_connector *connector, *found = NULL;
+	struct drm_connector_list_iter iter;
+
+	drm_connector_list_iter_begin(crtc->dev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		if (connector->connector_type == DRM_MODE_CONNECTOR_DisplayPort &&
+		    connector->state && connector->state->crtc == crtc) {
+			found = connector;
+			break;
+		}
+	}
+	drm_connector_list_iter_end(&iter);
+
+	return found;
+}
+
+/* The "auto" source is the frame CRC of a DisplayPort sink */
+static int sun4i_crtc_set_crc_source(struct drm_crtc *crtc, const char *source)
+{
+	struct sun4i_crtc *scrtc = drm_crtc_to_sun4i_crtc(crtc);
+	struct drm_connector *connector;
+	int ret;
+
+	/*
+	 * A modeset may have taken the connector off the CRTC meanwhile, so
+	 * the capture stops at the connector it started at.
+	 */
+	if (!source) {
+		connector = scrtc->crc_connector;
+		scrtc->crc_connector = NULL;
+
+		return connector ? sun60i_dp_stop_crc(connector) : -EINVAL;
+	}
+
+	if (strcmp(source, "auto"))
+		return -EINVAL;
+
+	connector = sun4i_crtc_get_dp_connector(crtc);
+	if (!connector)
+		return -EINVAL;
+
+	ret = sun60i_dp_start_crc(connector);
+	if (ret)
+		return ret;
+
+	scrtc->crc_connector = connector;
+
+	return 0;
+}
+
+static int sun4i_crtc_verify_crc_source(struct drm_crtc *crtc,
+					const char *source, size_t *values_cnt)
+{
+	if (source && strcmp(source, "auto"))
+		return -EINVAL;
+
+	/* One CRC each for red, green and blue */
+	*values_cnt = 3;
+
+	return 0;
+}
+#endif
+
 static const struct drm_crtc_funcs sun4i_crtc_funcs = {
 	.atomic_destroy_state	= drm_atomic_helper_crtc_destroy_state,
 	.atomic_duplicate_state	= drm_atomic_helper_crtc_duplicate_state,
@@ -196,6 +264,10 @@ static const struct drm_crtc_funcs sun4i_crtc_funcs = {
 	.set_config		= drm_atomic_helper_set_config,
 	.enable_vblank		= sun4i_crtc_enable_vblank,
 	.disable_vblank		= sun4i_crtc_disable_vblank,
+#if IS_REACHABLE(CONFIG_DRM_SUN60I_DP)
+	.set_crc_source		= sun4i_crtc_set_crc_source,
+	.verify_crc_source	= sun4i_crtc_verify_crc_source,
+#endif
 };
 
 struct sun4i_crtc *sun4i_crtc_init(struct drm_device *drm,
diff --git a/drivers/gpu/drm/sun4i/sun4i_crtc.h b/drivers/gpu/drm/sun4i/sun4i_crtc.h
index ed7aa7ce4b9c..75dc403de970 100644
--- a/drivers/gpu/drm/sun4i/sun4i_crtc.h
+++ b/drivers/gpu/drm/sun4i/sun4i_crtc.h
@@ -15,6 +15,9 @@ struct sun4i_crtc {
 
 	struct sunxi_engine		*engine;
 	struct sun4i_tcon		*tcon;
+
+	/* The connector whose sink computes the frame CRCs being captured */
+	struct drm_connector		*crc_connector;
 };
 
 static inline struct sun4i_crtc *drm_crtc_to_sun4i_crtc(struct drm_crtc *crtc)
diff --git a/drivers/gpu/drm/sun4i/sun60i_dp.c b/drivers/gpu/drm/sun4i/sun60i_dp.c
index 06aeeb0a2bf3..152ef573d4d0 100644
--- a/drivers/gpu/drm/sun4i/sun60i_dp.c
+++ b/drivers/gpu/drm/sun4i/sun60i_dp.c
@@ -46,6 +46,8 @@
 #include <drm/drm_modes.h>
 #include <drm/drm_of.h>
 
+#include "sun60i_dp.h"
+
 /* Transmitter controller registers (user manual section 15.4.7) */
 #define SUN60I_DP_LINK_BW_SET			0x0000
 #define SUN60I_DP_LANE_COUNT_SET		0x0004
@@ -1111,6 +1113,54 @@ static const struct drm_bridge_funcs sun60i_dp_bridge_funcs = {
 	.atomic_disable		= sun60i_dp_bridge_atomic_disable,
 };
 
+static struct sun60i_dp *sun60i_dp_from_connector(struct drm_connector *connector)
+{
+	struct drm_encoder *encoder;
+	struct drm_bridge *bridge = NULL;
+	struct sun60i_dp *dp = NULL;
+
+	/* The one encoder of the transmitter, also while the pipe is off */
+	drm_connector_for_each_possible_encoder(connector, encoder) {
+		bridge = drm_bridge_chain_get_first_bridge(encoder);
+		break;
+	}
+	if (!bridge)
+		return NULL;
+
+	if (bridge->funcs == &sun60i_dp_bridge_funcs)
+		dp = bridge_to_sun60i_dp(bridge);
+
+	drm_bridge_put(bridge);
+
+	return dp;
+}
+
+/*
+ * Frame CRCs computed by the sink, through the DisplayPort test sink
+ * registers, for the CRC capture of the CRTC that feeds the connector.
+ */
+int sun60i_dp_start_crc(struct drm_connector *connector)
+{
+	struct sun60i_dp *dp = sun60i_dp_from_connector(connector);
+
+	if (!dp || !connector->state->crtc)
+		return -EINVAL;
+
+	return drm_dp_start_crc(&dp->aux, connector->state->crtc);
+}
+EXPORT_SYMBOL_GPL(sun60i_dp_start_crc);
+
+int sun60i_dp_stop_crc(struct drm_connector *connector)
+{
+	struct sun60i_dp *dp = sun60i_dp_from_connector(connector);
+
+	if (!dp)
+		return -EINVAL;
+
+	return drm_dp_stop_crc(&dp->aux);
+}
+EXPORT_SYMBOL_GPL(sun60i_dp_stop_crc);
+
 /*
  * The transmitter creates the encoder of its TCON channel, a TMDS encoder as
  * sun4i_tcon expects of channel 1, and the connector of its bridge chain.
diff --git a/drivers/gpu/drm/sun4i/sun60i_dp.h b/drivers/gpu/drm/sun4i/sun60i_dp.h
new file mode 100644
index 000000000000..3f04b079ff16
--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun60i_dp.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifndef _SUN60I_DP_H_
+#define _SUN60I_DP_H_
+
+struct drm_connector;
+
+int sun60i_dp_start_crc(struct drm_connector *connector);
+int sun60i_dp_stop_crc(struct drm_connector *connector);
+
+#endif /* _SUN60I_DP_H_ */
