+/*
+ * Release the link from reset for DisplayPort (raw SerDes) with power state
+ * A0, the sequence of the vendor code. LINK_CTRL0 is written as absolute
+ * values, each releasing one more reset; the plug direction rides in all of
+ * them, so it is latched while PHY_RESET_N is low. The PIPE reset of the USB3
+ * controller is masked, so it cannot reset the lanes under DisplayPort.
+ */
+static int a733_combophy_dp_release_reset(struct a733_combophy *cp)
+{
+	static const u32 steps[] = {
+		LINK_CTRL0_PHY_RESET_N,
+		LINK_CTRL0_DP_LINK_RESET_N,
+		LINK_CTRL0_PIPE_LINK_RESET_N | LINK_CTRL0_PIPE_RESET_N_MASK,
+	};
+	u32 ctrl0 = 0;
+	unsigned int i;
+	int ret;
+
+	if (cp->orientation == TYPEC_ORIENTATION_REVERSE)
+		ctrl0 = LINK_CTRL0_TYPEC_CONN_DIR;
+	writel(ctrl0, cp->link + LINK_CTRL0);
+
+	for (i = 0; i < ARRAY_SIZE(steps); i++) {
+		ctrl0 |= steps[i];
+		writel(ctrl0, cp->link + LINK_CTRL0);
+		usleep_range(DP_RESET_STEP_US, 2 * DP_RESET_STEP_US);
+	}
+	usleep_range(DP_RESET_STEP_US, 2 * DP_RESET_STEP_US);
+
+	ret = a733_combophy_dp_wait(cp, LINK_STUS0_PMA_CMN_READY,
+				    DP_ACK_TIMEOUT_US, "PMA common ready");
+	if (ret)
+		return ret;
+
+	regmap_write(cp->top, TOP_DP_RAWS_TXDW_CONV_CTRL, TOP_DP_CFG_ALL);
+
+	a733_rmw(cp->link + LINK_CTRL3, 0, LINK_CTRL3_PLLCLK_EN);
+	ret = a733_combophy_dp_wait(cp, LINK_STUS0_CLK_EN_ACK,
+				    DP_ACK_TIMEOUT_US, "PLL clock acknowledge");
+	if (ret)
+		return ret;
+
+	usleep_range(DP_RESET_STEP_US, 2 * DP_RESET_STEP_US);
+
+	/* One-hot request: replace the field, never add to it */
+	a733_rmw(cp->link + LINK_CTRL3, LINK_CTRL3_POWER_STATE_REQ,
+		 LINK_CTRL3_POWER_STATE_REQ_A0);
+
+	return a733_combophy_dp_wait(cp, LINK_STUS0_POWER_STATE_ACK,
+				     DP_POWER_STATE_TIMEOUT_US,
+				     "power state acknowledge");
+}
