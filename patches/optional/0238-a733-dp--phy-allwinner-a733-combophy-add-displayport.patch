+/*
+ * Give the lanes back to USB3. If the USB3 controller holds the PHY, USB3 is
+ * started again as at init, as the lanes stay in reset otherwise. The CCU lets
+ * go of the PIPE clock afterwards, also if no controller holds the PHY or USB3
+ * did not start. Must be called with cp->lock held.
+ */
+static int a733_combophy_dp_leave(struct a733_combophy *cp)
+{
+	int ret = 0;
+
+	a733_combophy_hold_reset(cp);
+	a733_combophy_set_lanes(cp, false);
+	cp->mode = A733_COMBOPHY_USB;
+	cp->dp_rate = NULL;
+	a733_combophy_power_down(cp);
+
+	if (cp->usb_requested) {
+		ret = a733_combophy_usb_start(cp);
+		if (ret)
+			dev_err(cp->dev,
+				"USB3 did not start after DisplayPort: %d\n",
+				ret);
+	}
+
+	clk_disable_unprepare(cp->pipe_clk);
+	a733_combophy_clk_disable(cp);
+
+	return ret;
+}
+
+/*
+ * Hand the lanes to DisplayPort. The link is released at once; the
+ * transmitter sets the link rate and lane count through phy_configure().
+ * If USB3 has not set the PMA up, it is set up here, as the vendor code
+ * does. The USB3 controller has no SuperSpeed lanes now, and it leaves its
+ * core soft reset only with a PIPE clock, so the CCU feeds it, before the
+ * PHY stops. The CCU clock keeps the rate the device tree gives it. Must be
+ * called with cp->lock held.
+ */
+static int a733_combophy_dp_enter(struct a733_combophy *cp)
+{
+	bool pma_ready = cp->inited;
+	int ret;
+
+	ret = a733_combophy_clk_enable(cp);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(cp->pipe_clk);
+	if (ret) {
+		a733_combophy_clk_disable(cp);
+		return ret;
+	}
+
+	a733_combophy_hold_reset(cp);
+	cp->inited = false;
+	cp->mode = A733_COMBOPHY_DP;
+
+	/*
+	 * Leaving DisplayPort puts the PHY in IDDQ; a PMA access in IDDQ
+	 * stalls the bus, so leave it before the PMA is touched.
+	 */
+	a733_rmw(cp->link + LINK_CTRL2,
+		 LINK_CTRL2_IDDQ_EN_SEL | LINK_CTRL2_IDDQ_EN, 0);
+
+	if (!pma_ready)
+		a733_combophy_pma_config(cp);
+
+	a733_combophy_set_lanes(cp, true);
+
+	ret = a733_combophy_dp_release_reset(cp);
+	if (ret)
+		a733_combophy_dp_leave(cp);
+
+	return ret;
+}
