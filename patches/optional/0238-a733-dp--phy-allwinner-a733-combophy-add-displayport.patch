+static int a733_combophy_dp_set_link(struct a733_combophy *cp,
+				     const struct phy_configure_opts_dp *dp)
+{
+	const struct a733_dp_rate *rate = NULL;
+	u16 lanes = PMA_DP_LANES_ON;
+	int ret;
+
+	if (dp->set_rate)
+		rate = a733_combophy_dp_rate(dp->link_rate);
+
+	a733_combophy_hold_reset(cp);
+
+	/* The swing tables of the old rate do not fit the PMA set-up below */
+	if (rate)
+		cp->dp_rate = NULL;
+
+	if (dp->set_lanes) {
+		if (dp->lanes < A733_DP_LANES)
+			lanes |= GENMASK(A733_DP_LANES - 1, dp->lanes);
+		writew(lanes, cp->pma + PMA_REG(PMA_DP_LANES));
+	}
+
+	if (rate) {
+		writel(LINK_CTRL1_REFCLK, cp->link + LINK_CTRL1);
+		a733_pma_write_table(cp, a733_pma_dp_common,
+				     ARRAY_SIZE(a733_pma_dp_common), 0);
+		a733_pma_write_table(cp, rate->pll, rate->pll_len, 0);
+	}
+
+	ret = a733_combophy_dp_release_reset(cp);
+	if (ret)
+		return ret;
+
+	if (rate)
+		cp->dp_rate = rate;
+
+	return 0;
+}
