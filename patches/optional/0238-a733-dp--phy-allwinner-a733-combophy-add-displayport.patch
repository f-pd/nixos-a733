+#define PMA_TX_DIAG_ACYA		0x01e7
+#define  PMA_TX_DIAG_ACYA_HBDC		BIT(0)
+/* DisplayPort lanes on: bits 3:1 switch lanes 3 to 1 off (vendor) */
+#define PMA_DP_LANES			0x4011
+#define  PMA_DP_LANES_ON		0x0100
+/* Per-lane PMA control, bit 8 inverts the transmitter (vendor) */
+#define PMA_LANE_CTRL(lane)		(0xf000 + (lane) * 0x100)
+#define  PMA_LANE_CTRL_TX_INVERT	BIT(8)
 
 #define SERDES_CLK_RATE			100000000
 #define PMA_TIMEOUT_US			10000
 
+#define A733_DP_LANES			4
+#define A733_DP_LEVELS			4
+
+/*
+ * DisplayPort reset steps and handshake timeouts: vendor values, not
+ * measured on our boards.
+ */
+#define DP_RESET_STEP_US		1000
+#define DP_POLL_US			10
+#define DP_ACK_TIMEOUT_US		5000
+#define DP_POWER_STATE_TIMEOUT_US	500000
+
+enum a733_combophy_mode {
+	A733_COMBOPHY_USB,
+	A733_COMBOPHY_DP,
+};
+
 struct a733_pma_write {
 	u16 idx;
 	u16 val;
 };
 
+/* Driver settings of one swing and pre-emphasis level pair */
+struct a733_dp_swing {
+	u16 tx_drv;
+	u16 cpost;
+	u16 mgnfs[A733_DP_LANES];
+};
+
+struct a733_dp_rate {
+	unsigned int			link_rate;	/* Mb/s */
+	const struct a733_pma_write	*pll;
+	size_t				pll_len;
+	const struct a733_dp_swing	(*swing)[A733_DP_LEVELS];
+};
+
 struct a733_combophy {
 	struct device		*dev;
 	void __iomem		*link;
