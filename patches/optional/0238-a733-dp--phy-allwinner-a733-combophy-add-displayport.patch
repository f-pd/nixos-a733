 #define  LINK_CTRL3_PLLCLK_EN		BIT(0)
 #define LINK_STUS0			0x0900
@@ -70,15 +89,61 @@
 #define  PMA_PLL_RESTART_MASK		GENMASK(11, 8)
 /* Lane n of a flipped plug is lane 3 - n, the lane stride is 0x200 words */
 #define PMA_LANE_MIRROR			0x0600
+/* Torrent TX lane registers */
+#define PMA_TX(lane, idx)		(0x4000 + (lane) * 0x200 + (idx))
+#define PMA_TX_TXCC_CTRL		0x0040
+#define  PMA_TX_TXCC_CTRL_DP		0x08a4
+#define PMA_TX_TXCC_CPOST_MULT_00	0x004c
+#define PMA_TX_TXCC_MGNFS_MULT_000	0x0050
