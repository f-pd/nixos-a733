+static int a733_combophy_dp_wait(struct a733_combophy *cp, u32 mask,
+				 unsigned long timeout_us, const char *what)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(cp->link + LINK_STUS0, val, val & mask,
+				 DP_POLL_US, timeout_us);
