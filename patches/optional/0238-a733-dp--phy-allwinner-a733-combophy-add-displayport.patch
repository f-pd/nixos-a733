 // SPDX-License-Identifier: GPL-2.0
 /*
- * Allwinner A733 USB3 combo PHY
+ * Allwinner A733 USB3 and DisplayPort combo PHY
  *
  * The first combo PHY (COMB0) in the SERDES block of the A733 is a Cadence
- * PHY in an Allwinner wrapper. It carries USB3 or DisplayPort to a Type-C
- * connector; only USB3 is supported here. A flipped plug is handled inside
- * the PHY, so the driver is also the orientation switch of the connector.
+ * PHY in an Allwinner wrapper. It carries USB3 or the four main link lanes of
+ * the DisplayPort transmitter to a Type-C connector. A flipped plug and the
+ * hand-over of the lanes are both handled inside the PHY, so the driver is the
+ * orientation switch and the mode switch of the connector.
+ *
+ * The PMA is a Cadence Torrent: register indices and names, and the swing and
+ * pre-emphasis sequence, are those of phy-cadence-torrent.c. The wrapper
+ * replaces the Torrent DisplayPort link registers by its own link control
+ * and status registers.
  */
 
+#include <linux/bitfield.h>
 #include <linux/bits.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
