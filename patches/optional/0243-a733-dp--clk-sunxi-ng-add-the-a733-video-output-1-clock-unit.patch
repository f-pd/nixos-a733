@@ -99,6 +99,16 @@ config SUN60I_A733_SERDES_CCU
 	  and keeps the SERDES bus matrix gates of the main clock unit
 	  running while it is bound.
 
+config SUN60I_A733_VO1_CCU
+	tristate "Support for the Allwinner A733 video output 1 clock unit"
