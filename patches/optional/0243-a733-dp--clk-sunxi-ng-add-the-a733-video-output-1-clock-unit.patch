diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733-vo1.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733-vo1.c
new file mode 100644
index 000000000000..b8a76f6d5f75
--- /dev/null
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733-vo1.c
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Clock unit of the Allwinner A733 video output 1 block (VIDEO_OUT1_SYS)
+ *
+ * It selects whether each TCON TV takes its clock from the HDMI or the eDP
+ * side, and gates the clocks of both TCONs and the clock from TCON TV0 to
+ * HDMI (user manual sections 15.2.9.1 and 15.2.9.2).
+ */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+
+#include <dt-bindings/clock/allwinner,sun60i-a733-vo1-ccu.h>
+
+#include "ccu_common.h"
+#include "ccu_gate.h"
+#include "ccu_mux.h"
+
+#define VO1_TV_CLK_SRC_REG	0x000
+#define VO1_MODULE_GATING_REG	0x020
+
+/* Select value 0 is the HDMI side, 1 the eDP side */
+static const struct clk_parent_data tv_parents[] = {
+	{ .fw_name = "hdmi" },
+	{ .fw_name = "edp" },
+};
+
+static SUNXI_CCU_MUX_DATA(tv0_sel_clk, "vo1-tv0-sel", tv_parents,
+			  VO1_TV_CLK_SRC_REG, 1, 1,
+			  CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT);
+static SUNXI_CCU_MUX_DATA(tv1_sel_clk, "vo1-tv1-sel", tv_parents,
+			  VO1_TV_CLK_SRC_REG, 5, 1,
+			  CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT);
+
+static const struct clk_hw *tv0_sel_hws[] = { &tv0_sel_clk.common.hw };
+static const struct clk_hw *tv1_sel_hws[] = { &tv1_sel_clk.common.hw };
+
+static SUNXI_CCU_GATE_HWS(tv0_clk, "vo1-tv0", tv0_sel_hws,
+			  VO1_MODULE_GATING_REG, BIT(20), CLK_SET_RATE_PARENT);
+static SUNXI_CCU_GATE_HWS(tv1_clk, "vo1-tv1", tv1_sel_hws,
+			  VO1_MODULE_GATING_REG, BIT(21), CLK_SET_RATE_PARENT);
+
+static const struct clk_hw *tv0_hws[] = { &tv0_clk.common.hw };
+
+static SUNXI_CCU_GATE_HWS(tv0_hdmi_clk, "vo1-tv0-hdmi", tv0_hws,
+			  VO1_MODULE_GATING_REG, BIT(28), CLK_SET_RATE_PARENT);
+
+static struct ccu_common *sun60i_a733_vo1_ccu_clks[] = {
+	&tv0_sel_clk.common,
+	&tv1_sel_clk.common,
+	&tv0_clk.common,
+	&tv1_clk.common,
+	&tv0_hdmi_clk.common,
+};
+
+static struct clk_hw_onecell_data sun60i_a733_vo1_hw_clks = {
+	.num	= CLK_VO1_TV0_HDMI + 1,
+	.hws	= {
+		[CLK_VO1_TV0_SEL]	= &tv0_sel_clk.common.hw,
+		[CLK_VO1_TV1_SEL]	= &tv1_sel_clk.common.hw,
+		[CLK_VO1_TV0]		= &tv0_clk.common.hw,
+		[CLK_VO1_TV1]		= &tv1_clk.common.hw,
+		[CLK_VO1_TV0_HDMI]	= &tv0_hdmi_clk.common.hw,
+	},
+};
+
+static const struct sunxi_ccu_desc sun60i_a733_vo1_ccu_desc = {
+	.ccu_clks	= sun60i_a733_vo1_ccu_clks,
+	.num_ccu_clks	= ARRAY_SIZE(sun60i_a733_vo1_ccu_clks),
+	.hw_clks	= &sun60i_a733_vo1_hw_clks,
+};
+
+/*
+ * The block is reachable with the video output 1 gate of the AHB bus
+ * matrix, its reset deasserted and its bus clock running, the reset before
+ * the bus clock (user manual section 4.1.4.4). It stays reachable while the
+ * unit is bound, as its clocks may be in use.
+ */
+static int sun60i_a733_vo1_ccu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct reset_control *rstc;
+	void __iomem *reg;
+	struct clk *clk;
+
+	reg = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(reg))
+		return PTR_ERR(reg);
+
+	clk = devm_clk_get_enabled(dev, "ahb");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "Failed to enable ahb\n");
+
+	rstc = devm_reset_control_get_exclusive_deasserted(dev, NULL);
+	if (IS_ERR(rstc))
+		return dev_err_probe(dev, PTR_ERR(rstc),
+				     "Failed to deassert reset\n");
+
+	clk = devm_clk_get_enabled(dev, "bus");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "Failed to enable bus\n");
+
+	return devm_sunxi_ccu_probe(dev, reg, &sun60i_a733_vo1_ccu_desc);
+}
+
+static const struct of_device_id sun60i_a733_vo1_ccu_ids[] = {
+	{ .compatible = "allwinner,sun60i-a733-vo1-ccu" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sun60i_a733_vo1_ccu_ids);
+
+static struct platform_driver sun60i_a733_vo1_ccu_driver = {
+	.probe	= sun60i_a733_vo1_ccu_probe,
+	.driver	= {
+		.name			= "sun60i-a733-vo1-ccu",
+		.suppress_bind_attrs	= true,
+		.of_match_table		= sun60i_a733_vo1_ccu_ids,
+	},
+};
+module_platform_driver(sun60i_a733_vo1_ccu_driver);
+
+MODULE_IMPORT_NS("SUNXI_CCU");
+MODULE_DESCRIPTION("Support for the Allwinner A733 video output 1 clock unit");
+MODULE_LICENSE("GPL");
