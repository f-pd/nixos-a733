From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Thu, 15 Oct 2026 15:25:07 +0200
Subject: [PATCH] drm/sun4i: sun8i_dw_hdmi: Set up the bridge in probe

The dw-hdmi bridge is created in the bind callback and removed in the
unbind callback. dw-hdmi embeds the connector it creates for a bridge
attached without DRM_BRIDGE_ATTACH_NO_CONNECTOR in the memory of the
bridge, and that memory is freed with the last reference to the bridge.
A following patch lets DRM clean up the mode objects of sun4i when the
last reference to the drm_device is dropped, after the unbind callbacks
and possibly after the device is removed. The bridge must outlive the
connector until then.

Do what dw_hdmi-imx does: probe the controller, the PHY and the bridge
in the platform probe, look the bridge up by its node, and let the bind
callback only create the encoder and attach the bridge. Remove undoes
the probe in reverse order, after the component is deleted. The bridge
reference taken in probe keeps the bridge, and with it the connector,
alive while the master unbinds.

The PHY is now also shut down on the error paths after its
initialisation, which the bind callback did not do. The result of the
encoder initialisation, which was ignored, is checked.

Not covered: unbinding the master with the drm_device held open by
userspace while the HDMI device is removed too.

Tested on Radxa Cubie A7S: not tested; the board has no dw-hdmi
controller, the code is compiled only.

Assisted-by: LLM
---
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c | 114 +++++++++++++++-----------
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h |   1 +
 2 files changed, 65 insertions(+), 50 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
index bd3923ef5a41..43aebfecc9d8 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
@@ -8,6 +8,7 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 
+#include <drm/drm_bridge.h>
 #include <drm/drm_modeset_helper_vtables.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_of.h>
@@ -101,27 +102,11 @@ static u32 sun8i_dw_hdmi_find_possible_crtcs(struct drm_device *drm,
 static int sun8i_dw_hdmi_bind(struct device *dev, struct device *master,
 			      void *data)
 {
-	struct platform_device *pdev = to_platform_device(dev);
-	struct dw_hdmi_plat_data *plat_data;
+	struct sun8i_dw_hdmi *hdmi = dev_get_drvdata(dev);
 	struct drm_device *drm = data;
-	struct device_node *phy_node;
-	struct drm_encoder *encoder;
-	struct sun8i_dw_hdmi *hdmi;
+	struct drm_encoder *encoder = &hdmi->encoder;
 	int ret;
 
-	if (!pdev->dev.of_node)
-		return -ENODEV;
-
-	hdmi = devm_kzalloc(&pdev->dev, sizeof(*hdmi), GFP_KERNEL);
-	if (!hdmi)
-		return -ENOMEM;
-
-	plat_data = &hdmi->plat_data;
-	hdmi->dev = &pdev->dev;
-	encoder = &hdmi->encoder;
-
-	hdmi->quirks = of_device_get_match_data(dev);
-
 	encoder->possible_crtcs =
 		sun8i_dw_hdmi_find_possible_crtcs(drm, dev->of_node);
 	/*
@@ -133,6 +118,43 @@ static int sun8i_dw_hdmi_bind(struct device *dev, struct device *master,
 	if (encoder->possible_crtcs == 0)
 		return -EPROBE_DEFER;
 
+	drm_encoder_helper_add(encoder, &sun8i_dw_hdmi_encoder_helper_funcs);
+	ret = drm_encoder_init(drm, encoder, &sun8i_dw_hdmi_encoder_funcs,
+			       DRM_MODE_ENCODER_TMDS, NULL);
+	if (ret)
+		return ret;
+
+	ret = drm_bridge_attach(encoder, hdmi->bridge, NULL, 0);
+	if (ret)
+		drm_encoder_cleanup(encoder);
+
+	return ret;
+}
+
+static const struct component_ops sun8i_dw_hdmi_ops = {
+	.bind	= sun8i_dw_hdmi_bind,
+};
+
+static int sun8i_dw_hdmi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct dw_hdmi_plat_data *plat_data;
+	struct device_node *phy_node;
+	struct sun8i_dw_hdmi *hdmi;
+	int ret;
+
+	if (!dev->of_node)
+		return -ENODEV;
+
+	hdmi = devm_kzalloc(dev, sizeof(*hdmi), GFP_KERNEL);
+	if (!hdmi)
+		return -ENOMEM;
+
+	plat_data = &hdmi->plat_data;
+	hdmi->dev = dev;
+
+	hdmi->quirks = of_device_get_match_data(dev);
+
 	hdmi->rst_ctrl = devm_reset_control_get(dev, "ctrl");
 	if (IS_ERR(hdmi->rst_ctrl))
 		return dev_err_probe(dev, PTR_ERR(hdmi->rst_ctrl),
@@ -184,31 +206,36 @@ static int sun8i_dw_hdmi_bind(struct device *dev, struct device *master,
 	if (ret)
 		goto err_disable_clk_tmds;
 
-	drm_encoder_helper_add(encoder, &sun8i_dw_hdmi_encoder_helper_funcs);
-	drm_encoder_init(drm, encoder, &sun8i_dw_hdmi_encoder_funcs,
-			 DRM_MODE_ENCODER_TMDS, NULL);
-
 	plat_data->mode_valid = hdmi->quirks->mode_valid;
 	plat_data->use_drm_infoframe = hdmi->quirks->use_drm_infoframe;
 	sun8i_hdmi_phy_set_ops(hdmi->phy, plat_data);
 
 	platform_set_drvdata(pdev, hdmi);
 
-	hdmi->hdmi = dw_hdmi_bind(pdev, encoder, plat_data);
-
-	/*
-	 * If dw_hdmi_bind() fails we'll never call dw_hdmi_unbind(),
-	 * which would have called the encoder cleanup.  Do it manually.
-	 */
+	hdmi->hdmi = dw_hdmi_probe(pdev, plat_data);
 	if (IS_ERR(hdmi->hdmi)) {
 		ret = PTR_ERR(hdmi->hdmi);
-		goto cleanup_encoder;
+		goto err_phy_deinit;
+	}
+
+	hdmi->bridge = of_drm_find_and_get_bridge(dev->of_node);
+	if (!hdmi->bridge) {
+		ret = -ENODEV;
+		goto err_remove;
 	}
 
+	ret = component_add(dev, &sun8i_dw_hdmi_ops);
+	if (ret)
+		goto err_put_bridge;
+
 	return 0;
 
-cleanup_encoder:
-	drm_encoder_cleanup(encoder);
+err_put_bridge:
+	drm_bridge_put(hdmi->bridge);
+err_remove:
+	dw_hdmi_remove(hdmi->hdmi);
+err_phy_deinit:
+	sun8i_hdmi_phy_deinit(hdmi->phy);
 err_disable_clk_tmds:
 	clk_disable_unprepare(hdmi->clk_tmds);
 err_assert_ctrl_reset:
@@ -219,33 +246,20 @@ static int sun8i_dw_hdmi_bind(struct device *dev, struct device *master,
 	return ret;
 }
 
-static void sun8i_dw_hdmi_unbind(struct device *dev, struct device *master,
-				 void *data)
+static void sun8i_dw_hdmi_remove(struct platform_device *pdev)
 {
-	struct sun8i_dw_hdmi *hdmi = dev_get_drvdata(dev);
+	struct sun8i_dw_hdmi *hdmi = platform_get_drvdata(pdev);
 
-	dw_hdmi_unbind(hdmi->hdmi);
+	component_del(&pdev->dev, &sun8i_dw_hdmi_ops);
+
+	drm_bridge_put(hdmi->bridge);
+	dw_hdmi_remove(hdmi->hdmi);
 	sun8i_hdmi_phy_deinit(hdmi->phy);
 	clk_disable_unprepare(hdmi->clk_tmds);
 	reset_control_assert(hdmi->rst_ctrl);
 	regulator_disable(hdmi->regulator);
 }
 
-static const struct component_ops sun8i_dw_hdmi_ops = {
-	.bind	= sun8i_dw_hdmi_bind,
-	.unbind	= sun8i_dw_hdmi_unbind,
-};
-
-static int sun8i_dw_hdmi_probe(struct platform_device *pdev)
-{
-	return component_add(&pdev->dev, &sun8i_dw_hdmi_ops);
-}
-
-static void sun8i_dw_hdmi_remove(struct platform_device *pdev)
-{
-	component_del(&pdev->dev, &sun8i_dw_hdmi_ops);
-}
-
 static const struct sun8i_dw_hdmi_quirks sun8i_a83t_quirks = {
 	.mode_valid = sun8i_dw_hdmi_mode_valid_a83t,
 };
diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h
index ab80d52a70bb..f6eb3f619b83 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h
@@ -181,6 +181,7 @@ struct sun8i_dw_hdmi {
 	struct clk			*clk_tmds;
 	struct device			*dev;
 	struct dw_hdmi			*hdmi;
+	struct drm_bridge		*bridge;
 	struct drm_encoder		encoder;
 	struct sun8i_hdmi_phy		*phy;
 	struct dw_hdmi_plat_data	plat_data;
