From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Wed, 7 Oct 2026 20:35:44 +0200
Subject: [PATCH] arm64: dts: allwinner: a733: Add the PCIe controller and its
 combo PHY

Add the PCIe controller and the second combo PHY (COMB1) that carries
its lane, both disabled.

The DBI registers of the controller are at 0x06000000, 4 MiB below the
module base the manual's memory map gives, 0x06400000, which holds the
application registers. The configuration window and the I/O and memory
windows share PCIE_SLAVE at 0x20000000. The SII interrupt (SPI 152)
carries the Root Port's own events to the Root Port node through the
child interrupt controller; the MSI interrupt (SPI 153) is the
integrated MSI receiver.

The SERDES CCU gains the COMB1 oscillator gate of the RTC as an input
and a window that reaches its reference clock gate at 0x00f0.

The protocol mux of COMB1 is reached through the SERDES top system
controller, so the PHY node has no register region inside that page. A
kernel whose COMB1 driver still maps the mux as its own region does not
bind the PHY with this device tree.

Not covered: INTx of endpoints, and COMB1 in its USB3 role.

Tested on Radxa Cubie A7S: booted on one board; the controller and the
combo PHY nodes bound, the PHY through the SERDES top syscon, and the
NVMe endpoint came up at Gen3 x1.

Assisted-by: LLM
---
 .../arm64/boot/dts/allwinner/sun60i-a733.dtsi | 72 ++++++++++++++++++-
 1 file changed, 69 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index b471919e0818..923e344e1d40 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -947,6 +947,59 @@ dma: dma-controller@4601000 {
 			#dma-cells = <1>;
 		};
 
+		pcie: pcie@6000000 {
+			compatible = "allwinner,sun60i-a733-pcie";
+			reg = <0x06000000 0x400000>,
+			      <0x06400000 0x80000>,
+			      <0x20000000 0x200000>;
+			reg-names = "dbi", "app", "config";
+			device_type = "pci";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			bus-range = <0x00 0xff>;
+			linux,pci-domain = <0>;
+			/*
+			 * PCIE_SLAVE 0x20000000-0x27ffffff: configuration
+			 * window, then I/O and memory up to the end.
+			 */
+			ranges = <0x81000000 0x0 0x21000000 0x21000000 0x0 0x01000000>,
+				 <0x82000000 0x0 0x22000000 0x22000000 0x0 0x06000000>;
+			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH 0>,
+				     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH 0>;
+			interrupt-names = "sii", "msi";
+			clocks = <&ccu CLK_PCIE_AUX>, <&ccu CLK_PCIE_AXI_SLV>,
+				 <&ccu CLK_BUS_ITS_PCIE0_ACLK>,
+				 <&serdes_ccu CLK_BUS_PCIE_SLV_ACLK>,
+				 <&serdes_ccu CLK_BUS_PCIE_MST_ACLK>,
+				 <&serdes_ccu CLK_BUS_PCIE_HCLK>;
+			clock-names = "aux", "axi-slv", "its", "slv-aclk",
+				      "mst-aclk", "hclk";
+			resets = <&ccu RST_BUS_PCIE_PWRUP>, <&ccu RST_BUS_PCIE>,
+				 <&ccu RST_BUS_ITS_PCIE0>;
+			reset-names = "pwrup", "core", "its";
+			phys = <&combophy1>;
+			phy-names = "pcie-phy";
+			power-domains = <&pck600 PD_PCIE>;
+			num-lanes = <1>;
+			max-link-speed = <3>;
+			status = "disabled";
+
+			pcie_intc: legacy-interrupt-controller {
+				interrupt-controller;
+				#address-cells = <0>;
+				#interrupt-cells = <1>;
+			};
+
+			pcie@0,0 {
+				device_type = "pci";
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+				interrupts-extended = <&pcie_intc 0>;
+			};
+		};
+
 		usb3: usb@6a00000 {
 			compatible = "allwinner,sun60i-a733-dwc3";
 			reg = <0x06a00000 0x10000>;
@@ -983,10 +1036,10 @@ usb3_u2phy: phy@6b00000 {
 
 		serdes_ccu: clock-controller@6c00000 {
 			compatible = "allwinner,sun60i-a733-serdes-ccu";
-			reg = <0x06c00000 0x10>;
+			reg = <0x06c00000 0x100>;
 			clocks = <&ccu CLK_AHB_SERDES>, <&ccu CLK_MBUS_SERDES>,
-				 <&ccu CLK_USB2_U2_PIPE>;
-			clock-names = "ahb", "mbus", "usb2-u2-pipe";
+				 <&ccu CLK_USB2_U2_PIPE>, <&rtc CLK_HOSC_SERDES1>;
+			clock-names = "ahb", "mbus", "usb2-u2-pipe", "hosc-serdes1";
 			resets = <&ccu RST_BUS_SERDES>;
 			#clock-cells = <1>;
 			#reset-cells = <1>;
@@ -1005,6 +1058,19 @@ combophy0: phy@6c01000 {
 			status = "disabled";
 		};
 
+		combophy1: phy@6c02000 {
+			compatible = "allwinner,sun60i-a733-pcie-combophy";
+			reg = <0x06c02000 0x1000>,
+			      <0x06ca0000 0x20000>;
+			reg-names = "link", "pma";
+			allwinner,serdes-top = <&serdes_top>;
+			clocks = <&ccu CLK_SERDES_PHY>, <&serdes_ccu CLK_COMB1_REF>;
+			clock-names = "serdes", "ref";
+			resets = <&ccu RST_BUS_SERDES>;
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
 		serdes_top: syscon@6c06000 {
 			compatible = "allwinner,sun60i-a733-serdes-top", "syscon";
 			reg = <0x06c06000 0x1000>;
