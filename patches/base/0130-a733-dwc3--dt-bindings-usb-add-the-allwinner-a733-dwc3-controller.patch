From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 18:58:48 +0200
Subject: [PATCH] dt-bindings: usb: Add the Allwinner A733 DWC3 controller

The A733 has a DWC3 USB 3.1 DRD controller. It needs five clocks to
run, two of which are bus gates in the SERDES CCU, and sits in its own
power domain. It is described as a single flattened node.

Tested on Radxa Cubie A7S: booted on two boards; the controller node
described by this binding binds and starts.

Assisted-by: LLM
---
 .../usb/allwinner,sun60i-a733-dwc3.yaml       | 98 +++++++++++++++++++
 1 file changed, 98 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/allwinner,sun60i-a733-dwc3.yaml

diff --git a/Documentation/devicetree/bindings/usb/allwinner,sun60i-a733-dwc3.yaml b/Documentation/devicetree/bindings/usb/allwinner,sun60i-a733-dwc3.yaml
new file mode 100644
index 000000000000..761e45dfacf6
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/allwinner,sun60i-a733-dwc3.yaml
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/allwinner,sun60i-a733-dwc3.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 SuperSpeed DWC3 USB controller
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The A733 has a DWC3 USB 3.1 DRD controller with a USB 2.0 PHY of its own
+  and a combo PHY in the SERDES block for its SuperSpeed lanes. Its AHB and
+  AXI bus clocks are gated in the SERDES CCU.
+
+allOf:
+  - $ref: snps,dwc3-common.yaml#
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-dwc3
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: USB 2.0 reference clock
+      - description: microframe clock
+      - description: suspend clock
+      - description: AXI bus clock
+      - description: AHB bus clock
+
+  clock-names:
+    items:
+      - const: ref
+      - const: mf
+      - const: suspend
+      - const: axi
+      - const: ahb
+
+  resets:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  phys:
+    items:
+      - description: USB 2.0 PHY
+      - description: USB3 combo PHY
+
+  phy-names:
+    items:
+      - const: usb2-phy
+      - const: usb3-phy
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - power-domains
+  - phys
+  - phy-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/clock/allwinner,sun60i-a733-serdes-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/allwinner,sun60i-a733-pck-600.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    usb@6a00000 {
+        compatible = "allwinner,sun60i-a733-dwc3";
+        reg = <0x06a00000 0x10000>;
+        interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&ccu CLK_USB2_U2_REF>,
+                 <&ccu CLK_USB2_MF>,
+                 <&ccu CLK_USB2_SUSPEND>,
+                 <&serdes_ccu CLK_BUS_USB3_ACLK>,
+                 <&serdes_ccu CLK_BUS_USB3_HCLK>;
+        clock-names = "ref", "mf", "suspend", "axi", "ahb";
+        resets = <&ccu RST_BUS_USB2>;
+        power-domains = <&pck600 PD_USB2>;
+        phys = <&usb3_u2phy>, <&combophy0>;
+        phy-names = "usb2-phy", "usb3-phy";
+        dr_mode = "host";
+    };
