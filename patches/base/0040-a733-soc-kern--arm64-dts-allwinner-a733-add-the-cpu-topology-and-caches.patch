+			i-cache-sets = <128>;
+			d-cache-size = <32768>;
+			d-cache-line-size = <64>;
+			d-cache-sets = <128>;
+			next-level-cache = <&l2_cache2>;
 		};
 
 		cpu3: cpu@300 {
@@ -46,6 +103,13 @@ cpu3: cpu@300 {
 			reg = <0x300>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <530>;
+			i-cache-size = <32768>;
+			i-cache-line-size = <64>;
+			i-cache-sets = <128>;
+			d-cache-size = <32768>;
+			d-cache-line-size = <64>;
+			d-cache-sets = <128>;
+			next-level-cache = <&l2_cache3>;
 		};
 
 		cpu4: cpu@400 {
@@ -54,6 +118,13 @@ cpu4: cpu@400 {
 			reg = <0x400>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <530>;
+			i-cache-size = <32768>;
+			i-cache-line-size = <64>;
+			i-cache-sets = <128>;
+			d-cache-size = <32768>;
+			d-cache-line-size = <64>;
+			d-cache-sets = <128>;
+			next-level-cache = <&l2_cache4>;
 		};
 
 		cpu5: cpu@500 {
@@ -62,6 +133,13 @@ cpu5: cpu@500 {
 			reg = <0x500>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <530>;
+			i-cache-size = <32768>;
+			i-cache-line-size = <64>;
+			i-cache-sets = <128>;
+			d-cache-size = <32768>;
+			d-cache-line-size = <64>;
+			d-cache-sets = <128>;
+			next-level-cache = <&l2_cache5>;
 		};
 
 		cpu6: cpu@600 {
@@ -70,6 +148,13 @@ cpu6: cpu@600 {
 			reg = <0x600>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <1024>;
+			i-cache-size = <65536>;
+			i-cache-line-size = <64>;
