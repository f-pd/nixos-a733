 			capacity-dmips-mhz = <530>;
+			i-cache-size = <32768>;
+			i-cache-line-size = <64>;
+			i-cache-sets = <128>;
+			d-cache-size = <32768>;
+			d-cache-line-size = <64>;
+			d-cache-sets = <128>;
+			next-level-cache = <&l2_cache1>;
 		};
 
 		cpu2: cpu@200 {
@@ -38,6 +88,13 @@ cpu2: cpu@200 {
 			reg = <0x200>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <530>;
