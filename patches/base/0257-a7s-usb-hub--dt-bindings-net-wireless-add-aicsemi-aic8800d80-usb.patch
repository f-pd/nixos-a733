From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 11 Oct 2026 15:16:14 +0200
Subject: [PATCH] dt-bindings: net: wireless: Add AICSemi AIC8800D80 USB

The AIC8800D80 is a WiFi and Bluetooth chip with a USB interface. It is
used soldered on boards, with a supply and a CHIP_EN pin.

The compatible string uses the USB ID of the chip before the firmware
download. The ID changes when the firmware is loaded, the node is
matched by its hub port, so it stays valid.

Tested on Radxa Cubie A7S: booted on two boards with a device tree that
uses this binding; the module node binds and dtbs_check reports nothing.

Assisted-by: LLM
---
 .../net/wireless/aicsemi,aic8800d80.yaml      | 55 +++++++++++++++++++
 1 file changed, 55 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/wireless/aicsemi,aic8800d80.yaml

diff --git a/Documentation/devicetree/bindings/net/wireless/aicsemi,aic8800d80.yaml b/Documentation/devicetree/bindings/net/wireless/aicsemi,aic8800d80.yaml
new file mode 100644
index 000000000000..45958f6ff657
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/wireless/aicsemi,aic8800d80.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/wireless/aicsemi,aic8800d80.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: AICSemi AIC8800D80 USB WiFi and Bluetooth
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  AICSemi AIC8800D80 is a USB-connected dual-band WiFi and Bluetooth chip.
+  The USB product ID changes when the firmware is loaded, the compatible
+  string names the ID before the firmware download.
+
+allOf:
+  - $ref: /schemas/usb/usb-device.yaml#
+
+properties:
+  compatible:
+    const: usba69c,8d80
+
+  reg: true
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      GPIO connected to the CHIP_EN pin, asserted when the chip is disabled.
+
+  vdd-supply:
+    description:
+      Regulator for the 3V3 supply.
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    usb {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        wifi@1 {
+            compatible = "usba69c,8d80";
+            reg = <1>;
+            reset-gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
+            vdd-supply = <&vcc3v3>;
+        };
+    };
