From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Wed, 7 Oct 2026 20:33:07 +0200
Subject: [PATCH] PCI: sun60i-a733: Deliver the Root Port's AER, PME and
 bandwidth events

The Root Port binds its AER, PME and bandwidth notification services,
but none of their interrupts reaches the CPU: the core raises the
port's own events on sideband outputs, never as an MSI to its MSI
receiver, so correctable errors pile up in the Root Error Status and
are never reported.

On the A733 these outputs are latched into SII_INT_0 and reach the CPU
through the SII interrupt once unmasked in SII_INT_MASK_0 (A733 user
manual V1.00, 18.3.8.60 and 18.3.8.62). The level outputs are asserted
while INTx is enabled in the port, so the port runs on INTx: the
DesignWare core already removes the port's MSI and MSI-X capabilities
when the integrated MSI receiver is used, and the Root Port node takes
hwirq 0 of a one-entry interrupt domain that the SII handler feeds.

The manual does not say whether an SII_INT_0 bit latches the level or
only its rising edge. The handler therefore checks the port's own
status and enable pairs after each pass and dispatches again while one
is pending, so an event that arrives while the output is high is not
lost.

The vendor kernel also requests the SII interrupt, but unmasks only the
INTx assert messages of endpoints and leaves MSI enabled on the port,
so its AER and PME interrupts do not arrive either.

Not covered: INTx of endpoints. SII_INT_0 latches assert and deassert
messages separately, so the state of an INTx wire cannot be told.
There is no interrupt-map; an INTx-only endpoint gets no interrupt.

Tested on Radxa Cubie A7S: booted on one board; the Root Port's AER, PME
and bandwidth control services bound to the SII INTx line, and AER on the
Root Port and the NVMe endpoint reported no errors under read load.

Assisted-by: LLM
---
 drivers/pci/controller/dwc/pcie-sun60i-a733.c | 238 +++++++++++++++++-
 1 file changed, 233 insertions(+), 5 deletions(-)

diff --git a/drivers/pci/controller/dwc/pcie-sun60i-a733.c b/drivers/pci/controller/dwc/pcie-sun60i-a733.c
index a623ceffa6c9..08515f8f6a71 100644
--- a/drivers/pci/controller/dwc/pcie-sun60i-a733.c
+++ b/drivers/pci/controller/dwc/pcie-sun60i-a733.c
@@ -5,9 +5,9 @@
  * The controller is a DesignWare core. Its DBI registers are at 0x06000000;
  * the module base of the user manual, 0x06400000, is the User Defined Space
  * of the Allwinner wrapper, here the "app" region, which holds the LTSSM
- * control and the link status (A733 user manual V1.00, 18.3.8). The iATU,
- * the integrated MSI receiver and the configuration accesses are those of
- * the DesignWare core.
+ * control, the link status and the System Information Interface (A733 user
+ * manual V1.00, 18.3.8). The iATU, the integrated MSI receiver and the
+ * configuration accesses are those of the DesignWare core.
  */
 
 #include <linux/bitfield.h>
@@ -16,7 +16,10 @@
 #include <linux/gpio/consumer.h>
 #include <linux/init.h>
 #include <linux/io.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/irqdomain.h>
 #include <linux/mod_devicetable.h>
+#include <linux/of.h>
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
@@ -40,6 +43,38 @@
 /* SII_INT_1 */
 #define SUN60I_A733_PCIE_LINK_STAT		0x0e0c
 
+/*
+ * The System Information Interface: sideband outputs of the core, latched
+ * into write-1-to-clear status registers and ORed onto one interrupt. A mask
+ * bit of 1 passes its status bit on; every mask resets to 0 (18.3.8.60 to
+ * 18.3.8.65).
+ */
+#define SUN60I_A733_PCIE_SII_INT_MASK_0		0x0e00
+#define SUN60I_A733_PCIE_SII_INT_MASK_1		0x0e04
+#define SUN60I_A733_PCIE_SII_INT_0		0x0e08
+#define SUN60I_A733_PCIE_SII_INT_MASK_2		0x0e10
+#define SUN60I_A733_PCIE_SII_INT_MASK_3		0x0e14
+
+/*
+ * The level outputs of the Root Port's own events, asserted while INTx is
+ * enabled in its Command register: AER, PME, hot-plug and the two link
+ * bandwidth notifications (SII_INT_0, 18.3.8.62).
+ */
+#define  SUN60I_A733_PCIE_SII_AER_RC_ERR_INT	BIT(1)
+#define  SUN60I_A733_PCIE_SII_PME_INT		BIT(3)
+#define  SUN60I_A733_PCIE_SII_HP_INT		BIT(14)
+#define  SUN60I_A733_PCIE_SII_LINK_AUTO_BW_INT	BIT(16)
+#define  SUN60I_A733_PCIE_SII_BW_MGT_INT		BIT(18)
+#define  SUN60I_A733_PCIE_SII_RP_EVENTS				\
+	(SUN60I_A733_PCIE_SII_AER_RC_ERR_INT |			\
+	 SUN60I_A733_PCIE_SII_PME_INT |				\
+	 SUN60I_A733_PCIE_SII_HP_INT |				\
+	 SUN60I_A733_PCIE_SII_LINK_AUTO_BW_INT |		\
+	 SUN60I_A733_PCIE_SII_BW_MGT_INT)
+
+/* Passes over the Root Port's events per SII interrupt */
+#define SUN60I_A733_PCIE_SII_MAX_PASSES		4
+
 /*
  * The AXI slave clock resets to PERI0_600M. At that rate a configuration
  * read through the slave window does not complete and stalls the CPU that
@@ -77,6 +112,11 @@ struct sun60i_a733_pcie {
 	struct gpio_desc	*perst;
 	struct regulator	*vpcie3v3;
 	u8			exp_cap;
+	struct irq_domain	*rp_domain;
+	/* protects the SII masks */
+	raw_spinlock_t		sii_lock;
+	int			sii_irq;
+	u16			aer_cap;
 };
 
 static struct sun60i_a733_pcie *to_sun60i_a733_pcie(struct dw_pcie *pci)
@@ -129,11 +169,157 @@ static bool sun60i_a733_pcie_link_up(struct dw_pcie *pci)
 	       PCI_EXP_LNKSTA_DLLLA;
 }
 
-/* The DBI is mapped here and the core has not asked for the link yet */
+/*
+ * The Root Port's own interrupt.
+ *
+ * The core signals the Root Port's AER, PME and link bandwidth events on
+ * sideband outputs, as a pulse while the port's MSI is enabled and as a level
+ * while INTx is enabled. Neither reaches the MSI receiver; on the A733 the
+ * only path to the CPU is SII_INT_0 and the SII interrupt. So the Root Port
+ * runs on INTx: its MSI and MSI-X capabilities are removed by the DesignWare
+ * core, which does so whenever the integrated MSI receiver is used, and the
+ * Root Port's device tree node takes hwirq 0 of the one-entry domain below,
+ * which the SII handler feeds from the level outputs.
+ *
+ * Downstream INTx is not served: SII_INT_0 latches the Assert_INTx and
+ * Deassert_INTx messages as separate pulses, and with both latched the state
+ * of the wire is lost.
+ */
+
+/*
+ * Whether the Root Port still has an event its services have not taken, read
+ * from the same status and enable pairs that drive the level outputs. The
+ * manual does not say whether an SII_INT_0 bit follows its output or latches
+ * only a rising edge; with an edge-only latch, a second event that arrives
+ * while the output is still high raises no new interrupt. Checking the source
+ * after each pass makes the handler correct either way.
+ */
+static bool sun60i_a733_pcie_rp_pending(struct sun60i_a733_pcie *pcie)
+{
+	struct dw_pcie *pci = &pcie->pci;
+	u32 cmd, sta, lnk;
+
+	if (pcie->aer_cap) {
+		cmd = dw_pcie_readl_dbi(pci, pcie->aer_cap + PCI_ERR_ROOT_COMMAND);
+		sta = dw_pcie_readl_dbi(pci, pcie->aer_cap + PCI_ERR_ROOT_STATUS);
+		if ((sta & PCI_ERR_ROOT_COR_RCV) &&
+		    (cmd & PCI_ERR_ROOT_CMD_COR_EN))
+			return true;
+		if ((sta & PCI_ERR_ROOT_UNCOR_RCV) &&
+		    (cmd & (PCI_ERR_ROOT_CMD_NONFATAL_EN |
+			    PCI_ERR_ROOT_CMD_FATAL_EN)))
+			return true;
+	}
+
+	if (!pcie->exp_cap)
+		return false;
+
+	cmd = dw_pcie_readw_dbi(pci, pcie->exp_cap + PCI_EXP_RTCTL);
+	sta = dw_pcie_readl_dbi(pci, pcie->exp_cap + PCI_EXP_RTSTA);
+	if ((sta & PCI_EXP_RTSTA_PME) && (cmd & PCI_EXP_RTCTL_PMEIE))
+		return true;
+
+	/* Link Control in the low half, Link Status in the high half */
+	lnk = dw_pcie_readl_dbi(pci, pcie->exp_cap + PCI_EXP_LNKCTL);
+	if (((lnk >> 16) & PCI_EXP_LNKSTA_LBMS) &&
+	    (lnk & PCI_EXP_LNKCTL_LBMIE))
+		return true;
+
+	return ((lnk >> 16) & PCI_EXP_LNKSTA_LABS) &&
+	       (lnk & PCI_EXP_LNKCTL_LABIE);
+}
+
+static void sun60i_a733_pcie_handle_rp_events(struct sun60i_a733_pcie *pcie)
+{
+	int pass;
+
+	for (pass = 0; pass < SUN60I_A733_PCIE_SII_MAX_PASSES; pass++) {
+		/*
+		 * Clear the latch, then check the source, then dispatch: an
+		 * event after the check latches again and raises the line.
+		 */
+		writel(SUN60I_A733_PCIE_SII_RP_EVENTS,
+		       pcie->app + SUN60I_A733_PCIE_SII_INT_0);
+		if (pass && !sun60i_a733_pcie_rp_pending(pcie))
+			return;
+		generic_handle_domain_irq(pcie->rp_domain, 0);
+	}
+
+	if (sun60i_a733_pcie_rp_pending(pcie))
+		dev_warn_ratelimited(pcie->pci.dev,
+				     "Root Port event still pending after %d passes\n",
+				     pass);
+}
+
+static void sun60i_a733_pcie_sii_handler(struct irq_desc *desc)
+{
+	struct sun60i_a733_pcie *pcie = irq_desc_get_handler_data(desc);
+	struct irq_chip *chip = irq_desc_get_chip(desc);
+
+	chained_irq_enter(chip, desc);
+
+	if (readl(pcie->app + SUN60I_A733_PCIE_SII_INT_0) &
+	    readl(pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_0) &
+	    SUN60I_A733_PCIE_SII_RP_EVENTS)
+		sun60i_a733_pcie_handle_rp_events(pcie);
+
+	chained_irq_exit(chip, desc);
+}
+
+static void sun60i_a733_pcie_sii_update(struct sun60i_a733_pcie *pcie,
+					bool enable)
+{
+	unsigned long flags;
+	u32 val;
+
+	raw_spin_lock_irqsave(&pcie->sii_lock, flags);
+	val = readl(pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_0);
+	if (enable)
+		val |= SUN60I_A733_PCIE_SII_RP_EVENTS;
+	else
+		val &= ~SUN60I_A733_PCIE_SII_RP_EVENTS;
+	writel(val, pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_0);
+	raw_spin_unlock_irqrestore(&pcie->sii_lock, flags);
+}
+
+static void sun60i_a733_pcie_rp_irq_mask(struct irq_data *d)
+{
+	sun60i_a733_pcie_sii_update(irq_data_get_irq_chip_data(d), false);
+}
+
+static void sun60i_a733_pcie_rp_irq_unmask(struct irq_data *d)
+{
+	sun60i_a733_pcie_sii_update(irq_data_get_irq_chip_data(d), true);
+}
+
+static struct irq_chip sun60i_a733_pcie_rp_irq_chip = {
+	.name		= "A733-PCIe-INTx",
+	.irq_mask	= sun60i_a733_pcie_rp_irq_mask,
+	.irq_unmask	= sun60i_a733_pcie_rp_irq_unmask,
+	.flags		= IRQCHIP_SKIP_SET_WAKE | IRQCHIP_MASK_ON_SUSPEND,
+};
+
+static int sun60i_a733_pcie_rp_irq_map(struct irq_domain *domain,
+				       unsigned int irq, irq_hw_number_t hwirq)
+{
+	irq_set_chip_and_handler(irq, &sun60i_a733_pcie_rp_irq_chip,
+				 handle_level_irq);
+	irq_set_chip_data(irq, domain->host_data);
+
+	return 0;
+}
+
+static const struct irq_domain_ops sun60i_a733_pcie_rp_domain_ops = {
+	.map	= sun60i_a733_pcie_rp_irq_map,
+	.xlate	= irq_domain_xlate_onecell,
+};
+
 static int sun60i_a733_pcie_host_init(struct dw_pcie_rp *pp)
 {
 	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
 	struct sun60i_a733_pcie *pcie = to_sun60i_a733_pcie(pci);
+	struct device *dev = pci->dev;
+	struct device_node *intc;
 	u32 val;
 
 	/*
@@ -144,16 +330,53 @@ static int sun60i_a733_pcie_host_init(struct dw_pcie_rp *pp)
 	val &= ~SUN60I_A733_PCIE_APP_DBI_RO_WR_DISABLE;
 	writel(val, pcie->app + SUN60I_A733_PCIE_LTSSM_CTRL);
 
+	/* A warm start finds whatever the boot loader left in the masks */
+	writel(0, pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_0);
+	writel(0, pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_1);
+	writel(0, pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_2);
+	writel(0, pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_3);
+	writel(SUN60I_A733_PCIE_SII_RP_EVENTS,
+	       pcie->app + SUN60I_A733_PCIE_SII_INT_0);
+
 	pcie->exp_cap = dw_pcie_find_capability(pci, PCI_CAP_ID_EXP);
 	if (!pcie->exp_cap)
-		return dev_err_probe(pci->dev, -ENODEV,
+		return dev_err_probe(dev, -ENODEV,
 				     "no PCI Express capability\n");
+	pcie->aer_cap = dw_pcie_find_ext_capability(pci, PCI_EXT_CAP_ID_ERR);
+
+	intc = of_get_child_by_name(dev->of_node, "legacy-interrupt-controller");
+	if (!intc)
+		return dev_err_probe(dev, -EINVAL,
+				     "no legacy-interrupt-controller node\n");
+
+	/* One source, the Root Port, as hwirq 0 */
+	pcie->rp_domain = irq_domain_create_linear(of_fwnode_handle(intc), 1,
+						   &sun60i_a733_pcie_rp_domain_ops,
+						   pcie);
+	of_node_put(intc);
+	if (!pcie->rp_domain)
+		return dev_err_probe(dev, -ENOMEM,
+				     "failed to create the IRQ domain\n");
+
+	irq_set_chained_handler_and_data(pcie->sii_irq,
+					 sun60i_a733_pcie_sii_handler, pcie);
 
 	return 0;
 }
 
+static void sun60i_a733_pcie_host_deinit(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct sun60i_a733_pcie *pcie = to_sun60i_a733_pcie(pci);
+
+	writel(0, pcie->app + SUN60I_A733_PCIE_SII_INT_MASK_0);
+	irq_set_chained_handler_and_data(pcie->sii_irq, NULL, NULL);
+	irq_domain_remove(pcie->rp_domain);
+}
+
 static const struct dw_pcie_host_ops sun60i_a733_pcie_host_ops = {
 	.init	= sun60i_a733_pcie_host_init,
+	.deinit	= sun60i_a733_pcie_host_deinit,
 };
 
 static const struct dw_pcie_ops sun60i_a733_dw_pcie_ops = {
@@ -270,6 +493,10 @@ static int sun60i_a733_pcie_get_resources(struct sun60i_a733_pcie *pcie)
 	if (IS_ERR(pcie->app))
 		return PTR_ERR(pcie->app);
 
+	pcie->sii_irq = platform_get_irq_byname(pdev, "sii");
+	if (pcie->sii_irq < 0)
+		return pcie->sii_irq;
+
 	for (i = 0; i < ARRAY_SIZE(pcie->clks); i++)
 		pcie->clks[i].id = sun60i_a733_pcie_clk_names[i];
 	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(pcie->clks), pcie->clks);
@@ -326,6 +553,7 @@ static int sun60i_a733_pcie_probe(struct platform_device *pdev)
 	pcie->pci.dev = dev;
 	pcie->pci.ops = &sun60i_a733_dw_pcie_ops;
 	pcie->pci.pp.ops = &sun60i_a733_pcie_host_ops;
+	raw_spin_lock_init(&pcie->sii_lock);
 
 	ret = sun60i_a733_pcie_get_resources(pcie);
 	if (ret)
