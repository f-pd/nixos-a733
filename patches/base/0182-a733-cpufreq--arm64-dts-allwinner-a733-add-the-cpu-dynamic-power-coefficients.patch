+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -64,6 +64,7 @@ cpu0: cpu@0 {
 			clocks = <&cpu_ccu CLK_CPU_L>;
 			enable-method = "psci";
 			capacity-dmips-mhz = <454>;
+			dynamic-power-coefficient = <170>;
 			cpu-idle-states = <&cpu_sleep_a55>;
 			#cooling-cells = <2>;
 			i-cache-size = <32768>;
