From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 18:53:56 +0200
Subject: [PATCH] dt-bindings: phy: Add the Allwinner A733 USB2 PHY of the USB3
 controller

The USB3 controller of the A733 has a USB 2.0 UTMI PHY of its own,
separate from the PHY of the USB0 and USB1 controllers. It needs the
200 ohm reference resistor calibrated by a unit in the system control
block before its PLL locks; the PHY reaches those registers through
the system control device.

Add a binding for it.

Tested on Radxa Cubie A7S: booted on two boards; the PHY node described
by this binding binds and reaches the calibration through the system
control node.

Assisted-by: LLM
---
 .../phy/allwinner,sun60i-a733-usb2-phy.yaml   | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb2-phy.yaml

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb2-phy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb2-phy.yaml
new file mode 100644
index 000000000000..d6a5f25534c1
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb2-phy.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/allwinner,sun60i-a733-usb2-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 USB 2.0 PHY of the USB3 controller
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The USB3 DRD controller of the A733 has its own USB 2.0 UTMI PHY, separate
+  from the PHY of the USB0 and USB1 controllers. Its 200 ohm reference
+  resistor is calibrated by a unit in the system control block, which the
+  PHY reaches through the system control device.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-usb2-phy
+
+  reg:
+    maxItems: 1
+
+  allwinner,sram:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      phandle to the system control block holding the resistor calibration
+      registers
+
+  clocks:
+    maxItems: 1
+    description: clock of the resistor calibration unit
+
+  resets:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - allwinner,sram
+  - clocks
+  - resets
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-serdes-ccu.h>
+
+    phy@6b00000 {
+        compatible = "allwinner,sun60i-a733-usb2-phy";
+        reg = <0x06b00000 0x800>;
+        allwinner,sram = <&syscon>;
+        clocks = <&ccu CLK_RES_DCAP_24M>;
+        resets = <&serdes_ccu RST_USB3_USB2_PHY>;
+        #phy-cells = <0>;
+    };
