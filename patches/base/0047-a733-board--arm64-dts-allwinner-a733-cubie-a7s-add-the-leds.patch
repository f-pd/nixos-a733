From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 05:57:58 +0200
Subject: [PATCH] arm64: dts: allwinner: a733: cubie-a7s: Add the LEDs

The Cubie A7S has a green power LED and a blue status LED, which the
board file does not describe, so Linux cannot switch them.

The blue LED is on PJ26 and lights when the pin is high. The green LED is
lit whenever the board has power; PM2 switches it off when low and leaves
it on when high or open. Describe both as GPIO LEDs, active high, the
green one as the power LED that stays on.

Not covered: a default trigger for the blue LED.

Tested on Radxa Cubie A7S: booted on two boards; blue:status and
green:power appear and switch their GPIOs.

Assisted-by: LLM
---
 .../dts/allwinner/sun60i-a733-cubie-a7s.dts   | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
index 854896c0fb2c..db942dc0123f 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
@@ -4,6 +4,9 @@
 
 #include "sun60i-a733.dtsi"
 
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+
 / {
 	model = "Radxa Cubie A7S";
 	compatible = "radxa,cubie-a7s", "allwinner,sun60i-a733";
@@ -24,6 +27,23 @@ ext_osc32k: ext-osc32k-clk {
 		clock-output-names = "ext_osc32k";
 	};
 
+	leds {
+		compatible = "gpio-leds";
+
+		power-led {
+			function = LED_FUNCTION_POWER;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&r_pio 1 2 GPIO_ACTIVE_HIGH>; /* PM2 */
+			default-state = "on";
+		};
+
+		status-led {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&pio 9 26 GPIO_ACTIVE_HIGH>; /* PJ26 */
+		};
+	};
+
 	reserved-memory {
 		#address-cells = <2>;
 		#size-cells = <2>;
