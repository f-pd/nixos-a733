+
+static void a733_rmw(void __iomem *reg, u32 clr, u32 set)
+{
+	u32 val = readl(reg);
+
+	val &= ~clr;
+	val |= set;
+	writel(val, reg);
+}
+
+static void a733_pma_write_table(struct a733_combophy *cp,
+				 const struct a733_pma_write *tbl, size_t n,
+				 u16 mirror)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		writew(tbl[i].val, cp->pma + PMA_REG(tbl[i].idx ^ mirror));
+}
+
+/*
+ * Put the link side of the PHY back into reset with power and clocks left
+ * on. The plug direction may only change while PHY_RESET_N is low, so the
+ * resets are dropped first and the direction after them.
+ */
+static void a733_combophy_hold_reset(struct a733_combophy *cp)
+{
+	u32 dir = readl(cp->link + LINK_CTRL0) & LINK_CTRL0_TYPEC_CONN_DIR;
+
+	writel(dir, cp->link + LINK_CTRL0);
+	writel(0, cp->link + LINK_CTRL0);
+	regmap_write(cp->top, TOP_DP_RAWS_TXDW_CONV_CTRL, 0);
+	writel(0, cp->link + LINK_CTRL3);
+	usleep_range(1000, 2000);
+}
+
+/* Must be called with the PHY held in reset */
+static void a733_combophy_pma_config(struct a733_combophy *cp)
+{
+	bool flip = cp->orientation == TYPEC_ORIENTATION_REVERSE;
+	u16 m = flip ? PMA_LANE_MIRROR : 0;
+
+	a733_pma_write_table(cp, a733_pma_a_common,
+			     ARRAY_SIZE(a733_pma_a_common), 0);
+	a733_pma_write_table(cp, a733_pma_fork1,
+			     ARRAY_SIZE(a733_pma_fork1), m);
+
+	writel(LINK_CTRL1_USB3, cp->link + LINK_CTRL1);
+
+	a733_pma_write_table(cp, a733_pma_b_pre,
+			     ARRAY_SIZE(a733_pma_b_pre), 0);
+	a733_pma_write_table(cp, a733_pma_fork2,
+			     ARRAY_SIZE(a733_pma_fork2), m);
+	a733_pma_write_table(cp, a733_pma_b_post,
+			     ARRAY_SIZE(a733_pma_b_post), 0);
+
+	a733_rmw(cp->link + LINK_CTRL0, LINK_CTRL0_TYPEC_CONN_DIR,
+		 flip ? LINK_CTRL0_TYPEC_CONN_DIR : 0);
+
+	a733_pma_write_table(cp, a733_pma_c_pre,
+			     ARRAY_SIZE(a733_pma_c_pre), 0);
+	a733_pma_write_table(cp, a733_pma_fork3,
+			     ARRAY_SIZE(a733_pma_fork3), m);
+	a733_pma_write_table(cp, a733_pma_c_mid,
+			     ARRAY_SIZE(a733_pma_c_mid), 0);
+	a733_pma_write_table(cp, a733_pma_fork4,
+			     ARRAY_SIZE(a733_pma_fork4), m);
+	a733_pma_write_table(cp, a733_pma_c_post,
+			     ARRAY_SIZE(a733_pma_c_post), 0);
+}
+
+/*
+ * Release the PHY from reset and request power state A0 for the PIPE side.
+ * The PHY answers in LINK_STUS0. The controller cannot leave its core soft
+ * reset without the PIPE clock, so a missing answer is an error.
+ *
+ * The delays are not measured on our boards.
+ */
+static int a733_combophy_release_reset(struct a733_combophy *cp)
+{
+	u32 val;
+	u16 pma;
+	int ret, pll;
+
+	a733_rmw(cp->link + LINK_CTRL0, LINK_CTRL0_PHY_RESET_N, 0);
+	usleep_range(1000, 2000);
+	a733_rmw(cp->link + LINK_CTRL0, 0, LINK_CTRL0_PHY_RESET_N);
+
+	regmap_set_bits(cp->top, TOP_DP_RAWS_TXDW_CONV_CTRL,
+			TOP_DP_CFG_LN_RSTN | TOP_DP_CFG_LN_EN |
+			TOP_DP_CFG_DATA_EN);
+	usleep_range(1000, 2000);
+
+	a733_rmw(cp->link + LINK_CTRL0, 0, LINK_CTRL0_PIPE_LINK_RESET_N);
+	a733_rmw(cp->link + LINK_CTRL3, 0, LINK_CTRL3_PLLCLK_EN);
+	a733_rmw(cp->link + LINK_CTRL3, 0, LINK_CTRL3_POWER_STATE_REQ_A0);
+	a733_rmw(cp->link + LINK_CTRL0, 0, LINK_CTRL0_DP_LINK_RESET_N);
+
+	ret = readl_poll_timeout(cp->link + LINK_STUS0, val,
+				 (val & LINK_STUS0_CLK_EN_ACK) &&
+				 (val & LINK_STUS0_POWER_STATE_ACK), 10,
+				 PMA_TIMEOUT_US);
+	if (ret)
+		dev_err(cp->dev, "no PIPE clock acknowledge, status %#x\n",
+			val);
+
+	if (readl(cp->link + LINK_STUS0) & LINK_STUS0_PMA_CMN_READY)
+		return ret;
+
+	/*
+	 * The vendor code restarts the common PLL once when it is not ready;
+	 * the delay is not measured on our boards.
+	 */
+	usleep_range(10000, 11000);
+	pma = readw(cp->pma + PMA_REG(PMA_PLL_RESTART));
+	pma &= ~PMA_PLL_RESTART_MASK;
+	writew(pma, cp->pma + PMA_REG(PMA_PLL_RESTART));
+
+	pll = readl_poll_timeout(cp->link + LINK_STUS0, val,
+				 val & LINK_STUS0_PMA_CMN_READY, 5,
+				 PMA_TIMEOUT_US);
+	if (pll) {
+		dev_err(cp->dev, "PMA common block not ready\n");
+		return pll;
+	}
+
+	return ret;
+}
+
+/* Must be called with cp->lock held */
+static void a733_combophy_power_down(struct a733_combophy *cp)
+{
+	cp->inited = false;
+	a733_rmw(cp->link + LINK_CTRL2, 0,
+		 LINK_CTRL2_IDDQ_EN_SEL | LINK_CTRL2_IDDQ_EN);
+}
+
+static int a733_combophy_init(struct phy *phy)
+{
+	struct a733_combophy *cp = phy_get_drvdata(phy);
+	int ret;
+
+	ret = clk_set_rate(cp->serdes_clk, SERDES_CLK_RATE);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(cp->serdes_clk);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(cp->hosc_clk);
+	if (ret) {
+		clk_disable_unprepare(cp->serdes_clk);
+		return ret;
+	}
+
+	mutex_lock(&cp->lock);
+
+	a733_combophy_hold_reset(cp);
+
+	/* Leave IDDQ */
+	a733_rmw(cp->link + LINK_CTRL2, LINK_CTRL2_IDDQ_EN_SEL, 0);
+	a733_rmw(cp->link + LINK_CTRL2, LINK_CTRL2_IDDQ_EN, 0);
+
+	/* Reference clocks of the PLLs, PIPE clock and data from COMB0 */
+	a733_rmw(cp->link + LINK_CTRL1, 0, LINK_CTRL1_USB3);
+	regmap_update_bits(cp->top, TOP_USB3_PIPE_CLK_MAP_CTRL,
+			   TOP_USB3_PIPE_MAP, TOP_USB3_PIPE_MAP_COMB0);
+	regmap_update_bits(cp->top, TOP_USB3_PIPE_RXD_MAP_CTRL,
+			   TOP_USB3_PIPE_MAP, TOP_USB3_PIPE_MAP_COMB0);
+
+	a733_combophy_pma_config(cp);
+	ret = a733_combophy_release_reset(cp);
+	if (ret) {
+		a733_combophy_hold_reset(cp);
+		a733_combophy_power_down(cp);
+		mutex_unlock(&cp->lock);
+		clk_disable_unprepare(cp->hosc_clk);
+		clk_disable_unprepare(cp->serdes_clk);
+		return ret;
+	}
+	cp->inited = true;
+
+	mutex_unlock(&cp->lock);
+
+	return 0;
+}
+
+static int a733_combophy_exit(struct phy *phy)
+{
+	struct a733_combophy *cp = phy_get_drvdata(phy);
+
+	mutex_lock(&cp->lock);
+	a733_combophy_power_down(cp);
+	mutex_unlock(&cp->lock);
+
+	clk_disable_unprepare(cp->hosc_clk);
+	clk_disable_unprepare(cp->serdes_clk);
+
+	return 0;
+}
+
+static const struct phy_ops a733_combophy_ops = {
+	.init	= a733_combophy_init,
+	.exit	= a733_combophy_exit,
+	.owner	= THIS_MODULE,
+};
+
+/*
+ * The plug direction is reported after the controller has initialised the
+ * PHY. A PHY in use is put back into reset, set up for the new direction and
+ * released again; otherwise the direction is used by the next init.
+ */
+static int a733_combophy_typec_switch_set(struct typec_switch_dev *sw,
+					  enum typec_orientation orientation)
+{
+	struct a733_combophy *cp = typec_switch_get_drvdata(sw);
+	int ret = 0;
+
+	if (orientation == TYPEC_ORIENTATION_NONE)
+		return 0;
+
+	mutex_lock(&cp->lock);
+	if (orientation != cp->orientation) {
+		cp->orientation = orientation;
+		if (cp->inited) {
+			a733_combophy_hold_reset(cp);
+			a733_combophy_pma_config(cp);
+			ret = a733_combophy_release_reset(cp);
+		}
+	}
+	mutex_unlock(&cp->lock);
+
+	return ret;
+}
+
+static void a733_combophy_typec_switch_unregister(void *data)
+{
+	typec_switch_unregister(data);
+}
+
+static int a733_combophy_typec_switch_register(struct a733_combophy *cp)
+{
+	struct typec_switch_desc sw_desc = {
+		.drvdata = cp,
+		.fwnode = dev_fwnode(cp->dev),
+		.set = a733_combophy_typec_switch_set,
+	};
+
+	cp->sw = typec_switch_register(cp->dev, &sw_desc);
+	if (IS_ERR(cp->sw))
+		return dev_err_probe(cp->dev, PTR_ERR(cp->sw),
+				     "failed to register orientation switch\n");
+
+	return devm_add_action_or_reset(cp->dev,
+					a733_combophy_typec_switch_unregister,
+					cp->sw);
+}
+
+static void a733_combophy_assert_reset(void *data)
+{
+	reset_control_assert(data);
+}
+
+static int a733_combophy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct a733_combophy *cp;
+	struct phy *phy;
+	int ret;
+
+	cp = devm_kzalloc(dev, sizeof(*cp), GFP_KERNEL);
+	if (!cp)
+		return -ENOMEM;
+
+	cp->dev = dev;
+	cp->orientation = TYPEC_ORIENTATION_NORMAL;
+
+	ret = devm_mutex_init(dev, &cp->lock);
+	if (ret)
+		return ret;
+
+	cp->link = devm_platform_ioremap_resource_byname(pdev, "link");
+	if (IS_ERR(cp->link))
+		return PTR_ERR(cp->link);
+
+	cp->top = syscon_regmap_lookup_by_phandle(dev->of_node,
+						  "allwinner,serdes-top");
+	if (IS_ERR(cp->top))
+		return dev_err_probe(dev, PTR_ERR(cp->top),
+				     "failed to get SERDES top registers\n");
+
+	cp->pma = devm_platform_ioremap_resource_byname(pdev, "pma");
+	if (IS_ERR(cp->pma))
+		return PTR_ERR(cp->pma);
+
+	cp->serdes_clk = devm_clk_get(dev, "serdes");
+	if (IS_ERR(cp->serdes_clk))
+		return dev_err_probe(dev, PTR_ERR(cp->serdes_clk),
+				     "failed to get serdes clock\n");
+
+	cp->hosc_clk = devm_clk_get(dev, "hosc");
+	if (IS_ERR(cp->hosc_clk))
+		return dev_err_probe(dev, PTR_ERR(cp->hosc_clk),
+				     "failed to get hosc clock\n");
+
+	/* Shared with the SERDES CCU, which needs it deasserted as well */
+	cp->reset = devm_reset_control_get_shared(dev, NULL);
+	if (IS_ERR(cp->reset))
+		return dev_err_probe(dev, PTR_ERR(cp->reset),
+				     "failed to get reset\n");
+
+	ret = reset_control_deassert(cp->reset);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(dev, a733_combophy_assert_reset,
+				       cp->reset);
+	if (ret)
+		return ret;
+
+	phy = devm_phy_create(dev, NULL, &a733_combophy_ops);
+	if (IS_ERR(phy))
+		return PTR_ERR(phy);
+
+	phy_set_drvdata(phy, cp);
+
+	if (device_property_read_bool(dev, "orientation-switch")) {
+		ret = a733_combophy_typec_switch_register(cp);
+		if (ret)
+			return ret;
+	}
+
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id a733_combophy_of_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-usb3-combophy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a733_combophy_of_match);
+
+static struct platform_driver a733_combophy_driver = {
+	.probe	= a733_combophy_probe,
+	.driver	= {
+		.name		= "sun60i-a733-combophy",
+		.of_match_table	= a733_combophy_of_match,
+		/*
+		 * The Type-C core keeps calling the orientation and mode
+		 * switches of a port after they are unregistered, so the
+		 * device must not go away while a port holds them. Module
+		 * references of the switches and of the PHYs prevent that on
+		 * removal, but not on an unbind through sysfs.
+		 */
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(a733_combophy_driver);
+
+MODULE_DESCRIPTION("Allwinner A733 USB3 combo PHY driver");
+MODULE_LICENSE("GPL");
