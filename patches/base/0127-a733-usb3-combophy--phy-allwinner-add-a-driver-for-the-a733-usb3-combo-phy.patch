+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/usb/typec_mux.h>
+
+/*
+ * SERDES top page, a syscon shared with the second combo PHY. Only the
+ * registers below belong to this PHY; they are accessed through the regmap,
+ * whose lock keeps a read-modify-write atomic against the other driver.
+ */
+#define TOP_DP_RAWS_TXDW_CONV_CTRL	0x0004
+#define  TOP_DP_CFG_LN_RSTN		GENMASK(11, 8)
+#define  TOP_DP_CFG_LN_EN		GENMASK(7, 4)
+#define  TOP_DP_CFG_DATA_EN		BIT(0)
+#define TOP_USB3_PIPE_CLK_MAP_CTRL	0x0100
+#define TOP_USB3_PIPE_RXD_MAP_CTRL	0x0104
+#define  TOP_USB3_PIPE_MAP		GENMASK(3, 0)
+#define  TOP_USB3_PIPE_MAP_COMB0	0
+
+/* "link" region */
+#define LINK_CTRL0			0x0000
+#define  LINK_CTRL0_TYPEC_CONN_DIR	BIT(12)
+#define  LINK_CTRL0_DP_LINK_RESET_N	BIT(8)
+#define  LINK_CTRL0_PIPE_LINK_RESET_N	BIT(4)
+#define  LINK_CTRL0_PHY_RESET_N		BIT(0)
+#define LINK_CTRL1			0x0004
+#define  LINK_CTRL1_PLL1_REFCLK_SEL	BIT(24)
+#define  LINK_CTRL1_PLL0_REFCLK_SEL	BIT(20)
+#define  LINK_CTRL1_REFCLK_DIG_SEL	BIT(0)
+#define  LINK_CTRL1_USB3		(LINK_CTRL1_PLL1_REFCLK_SEL | \
+					 LINK_CTRL1_PLL0_REFCLK_SEL | \
+					 LINK_CTRL1_REFCLK_DIG_SEL)
+#define LINK_CTRL2			0x0008
+#define  LINK_CTRL2_IDDQ_EN_SEL		BIT(1)
+#define  LINK_CTRL2_IDDQ_EN		BIT(0)
+#define LINK_CTRL3			0x000c
+#define  LINK_CTRL3_POWER_STATE_REQ_A0	BIT(4)
+#define  LINK_CTRL3_PLLCLK_EN		BIT(0)
+#define LINK_STUS0			0x0900
+#define  LINK_STUS0_POWER_STATE_ACK	GENMASK(13, 8)
+#define  LINK_STUS0_CLK_EN_ACK		BIT(4)
+#define  LINK_STUS0_PMA_CMN_READY	BIT(0)
+
+/* "pma" region, 16-bit registers at word index << 1 */
+#define PMA_REG(idx)			((idx) << 1)
+#define PMA_PLL_RESTART			0xc008
+#define  PMA_PLL_RESTART_MASK		GENMASK(11, 8)
+/* Lane n of a flipped plug is lane 3 - n, the lane stride is 0x200 words */
+#define PMA_LANE_MIRROR			0x0600
+
+#define SERDES_CLK_RATE			100000000
+#define PMA_TIMEOUT_US			10000
+
+struct a733_pma_write {
+	u16 idx;
+	u16 val;
+};
+
+struct a733_combophy {
+	struct device		*dev;
+	void __iomem		*link;
+	struct regmap		*top;
+	void __iomem		*pma;
+	struct clk		*serdes_clk;
+	struct clk		*hosc_clk;
+	struct reset_control	*reset;
+	struct typec_switch_dev	*sw;
+	/* protects orientation and inited */
+	struct mutex		lock;
+	enum typec_orientation	orientation;
+	bool			inited;
+};
