+/*
+ * Allwinner A733 USB3 combo PHY
+ *
+ * The first combo PHY (COMB0) in the SERDES block of the A733 is a Cadence
+ * PHY in an Allwinner wrapper. It carries USB3 or DisplayPort to a Type-C
+ * connector; only USB3 is supported here. A flipped plug is handled inside
+ * the PHY, so the driver is also the orientation switch of the connector.
+ */
+
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
