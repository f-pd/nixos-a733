From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Mon, 5 Oct 2026 05:43:38 +0200
Subject: [PATCH] cpufreq: sun50i: Add the Allwinner A733

The A733 CPU operating points differ per die: the frequencies a die
runs and the voltage at each depend on a speed bin burned into the
eFuse, and mainline's sun50i-cpufreq-nvmem driver has no code for it.
Without an entry in the driver and an operating-points compatible, the
operating points are never selected and cpufreq stays off.

Add the A733 to the driver. Bits 15:8 of the DVFS fuse word hold the
bin, and the bin is the speed index, so a bit of opp-supported-hw is the
fuse value and the device tree decides which bins exist. A die whose bin
the tables do not describe, whose bin field is 0 or does not fit the
32-bit mask, or whose second copy in bits 23:16 is programmed gets index
1, the set the tables give an unknown die. If the tables of any CPU do
not describe index 1, the driver says so, and an unknown die then gets
no operating points. The set of indices all CPU tables describe is
computed for the A733 only; the other SoCs are unchanged.

Add the A733 to the machine compatibles of the driver, and to the
blocklist of cpufreq-dt-platdev so that cpufreq-dt is created by this
driver and not for a bare operating-points-v2 node.

Not covered: the operating points; the device tree patches that follow
add them. A kernel with this patch and an older device tree has no
operating points and no cpufreq.

Tested on Radxa Cubie A7S: booted on two boards; no cpufreq policy
exists before the module loads, the driver then reads the speed bin from
the eFuse (bin 4 on one board, bin 5 on the other) and selects its
operating points, and with the bin cell moved to a word that reads zero
it reports no usable bin and takes the fallback set.

Assisted-by: LLM
---
 drivers/cpufreq/cpufreq-dt-platdev.c   |   1 +
 drivers/cpufreq/sun50i-cpufreq-nvmem.c | 112 +++++++++++++++++++++++++
 2 files changed, 113 insertions(+)

diff --git a/drivers/cpufreq/cpufreq-dt-platdev.c b/drivers/cpufreq/cpufreq-dt-platdev.c
index 371ca1fe9020..3aa71a366fb1 100644
--- a/drivers/cpufreq/cpufreq-dt-platdev.c
+++ b/drivers/cpufreq/cpufreq-dt-platdev.c
@@ -114,6 +114,7 @@ static const struct of_device_id blocklist[] __initconst = {
 	{ .compatible = "allwinner,sun50i-h616", },
 	{ .compatible = "allwinner,sun50i-h618", },
 	{ .compatible = "allwinner,sun50i-h700", },
+	{ .compatible = "allwinner,sun60i-a733", },
 
 	{ .compatible = "apple,arm-platform", },
 
diff --git a/drivers/cpufreq/sun50i-cpufreq-nvmem.c b/drivers/cpufreq/sun50i-cpufreq-nvmem.c
index 9261d148a165..514fd468c5a6 100644
--- a/drivers/cpufreq/sun50i-cpufreq-nvmem.c
+++ b/drivers/cpufreq/sun50i-cpufreq-nvmem.c
@@ -11,7 +11,9 @@
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
 #include <linux/arm-smccc.h>
+#include <linux/bits.h>
 #include <linux/cpu.h>
+#include <linux/limits.h>
 #include <linux/module.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/of.h>
@@ -25,6 +27,17 @@
 #define SUN50I_A100_NVMEM_MASK	0xf
 #define SUN50I_A100_NVMEM_SHIFT	12
 
+/*
+ * A733: the nvmem cell is the 32-bit DVFS fuse word. Bits [15:8] hold the
+ * speed bin and bits [23:16] a second copy of it. The bin is the speed
+ * index, so a bit in opp-supported-hw is the fuse value: bin 4 is BIT(4).
+ * Index 1 is the set that a die with no usable bin gets.
+ */
+#define SUN60I_A733_NVMEM_MASK		0xff
+#define SUN60I_A733_NVMEM_SHIFT		8
+#define SUN60I_A733_NVMEM_BAK_SHIFT	16
+#define SUN60I_A733_SPEED_FALLBACK	1
+
 static struct platform_device *cpufreq_dt_pdev, *sun50i_cpufreq_pdev;
 
 struct sunxi_cpufreq_data {
@@ -124,6 +137,97 @@ static u32 sun50i_h616_efuse_xlate(u32 speedbin)
 	return value;
 }
 
+/**
+ * sunxi_cpufreq_dt_speed_mask() - speed indices every CPU OPP table describes
+ *
+ * ORs the opp-supported-hw values of one CPU's OPP table, then ANDs the
+ * results of all CPUs that have a table. A bit is set only if every such CPU
+ * has operating points for that index; supported_hw is set once for all CPUs,
+ * so a bin that only one cluster describes would leave the other cluster
+ * without operating points. Returns 0 if no CPU has an OPP table.
+ */
+static u32 sunxi_cpufreq_dt_speed_mask(void)
+{
+	u32 mask = U32_MAX;
+	bool found = false;
+	unsigned int cpu;
+
+	for_each_present_cpu(cpu) {
+		struct device *cpu_dev = get_cpu_device(cpu);
+		u32 cpu_mask = 0, val;
+		int count, i;
+
+		if (!cpu_dev)
+			continue;
+
+		struct device_node *np __free(device_node) =
+			dev_pm_opp_of_get_opp_desc_node(cpu_dev);
+		if (!np)
+			continue;
+
+		for_each_child_of_node_scoped(np, opp) {
+			count = of_property_count_u32_elems(opp,
+							    "opp-supported-hw");
+
+			for (i = 0; i < count; i++) {
+				if (of_property_read_u32_index(opp,
+							       "opp-supported-hw",
+							       i, &val))
+					continue;
+				cpu_mask |= val;
+			}
+		}
+
+		mask &= cpu_mask;
+		found = true;
+	}
+
+	return found ? mask : 0;
+}
+
+/*
+ * The speed index is the fuse bin, so the device tree alone decides which
+ * bins exist. Index 1 is used whenever there is no bin to act on:
+ *   - bits [15:8] read 0: an unprogrammed fuse cannot be told from a part
+ *     graded as bin 0;
+ *   - the second copy in bits [23:16] is programmed: its meaning is not
+ *     known, so the part is treated as unknown;
+ *   - the bin is 32 or more and does not fit the 32-bit opp-supported-hw;
+ *   - no operating point claims the bin.
+ */
+static u32 sun60i_a733_efuse_xlate(u32 speedbin)
+{
+	u32 bin = (speedbin >> SUN60I_A733_NVMEM_SHIFT) & SUN60I_A733_NVMEM_MASK;
+	u32 bak = (speedbin >> SUN60I_A733_NVMEM_BAK_SHIFT) & SUN60I_A733_NVMEM_MASK;
+	u32 mask = sunxi_cpufreq_dt_speed_mask();
+
+	if (!(mask & BIT(SUN60I_A733_SPEED_FALLBACK)))
+		pr_err("A733: the OPP tables do not describe the fallback speed index %u; an unknown die gets no operating points\n",
+		       SUN60I_A733_SPEED_FALLBACK);
+
+	if (bak) {
+		pr_warn("A733: second speed-bin fuse copy is programmed (0x%02x, primary 0x%02x); its meaning is unverified on this SoC, using the fallback OPP set\n",
+			bak, bin);
+		return SUN60I_A733_SPEED_FALLBACK;
+	}
+
+	if (!bin || bin >= BITS_PER_TYPE(u32)) {
+		pr_warn("A733: no usable speed bin in fuse word 0x%08x, using the fallback OPP set\n",
+			speedbin);
+		return SUN60I_A733_SPEED_FALLBACK;
+	}
+
+	if (!(mask & BIT(bin))) {
+		pr_warn("A733: speed bin %u has no operating points in DT, using the fallback OPP set\n",
+			bin);
+		return SUN60I_A733_SPEED_FALLBACK;
+	}
+
+	pr_info("A733: speed bin %u (fuse word 0x%08x)\n", bin, speedbin);
+
+	return bin;
+}
+
 static struct sunxi_cpufreq_data sun50i_h6_cpufreq_data = {
 	.efuse_xlate = sun50i_h6_efuse_xlate,
 };
@@ -136,6 +240,10 @@ static struct sunxi_cpufreq_data sun50i_h616_cpufreq_data = {
 	.efuse_xlate = sun50i_h616_efuse_xlate,
 };
 
+static struct sunxi_cpufreq_data sun60i_a733_cpufreq_data = {
+	.efuse_xlate = sun60i_a733_efuse_xlate,
+};
+
 static const struct of_device_id cpu_opp_match_list[] = {
 	{ .compatible = "allwinner,sun50i-h6-operating-points",
 	  .data = &sun50i_h6_cpufreq_data,
@@ -146,6 +254,9 @@ static const struct of_device_id cpu_opp_match_list[] = {
 	{ .compatible = "allwinner,sun50i-h616-operating-points",
 	  .data = &sun50i_h616_cpufreq_data,
 	},
+	{ .compatible = "allwinner,sun60i-a733-operating-points",
+	  .data = &sun60i_a733_cpufreq_data,
+	},
 	{}
 };
 
@@ -327,6 +438,7 @@ static const struct of_device_id sun50i_cpufreq_match_list[] = {
 	{ .compatible = "allwinner,sun50i-h616" },
 	{ .compatible = "allwinner,sun50i-h618" },
 	{ .compatible = "allwinner,sun50i-h700" },
+	{ .compatible = "allwinner,sun60i-a733" },
 	{}
 };
 MODULE_DEVICE_TABLE(of, sun50i_cpufreq_match_list);
