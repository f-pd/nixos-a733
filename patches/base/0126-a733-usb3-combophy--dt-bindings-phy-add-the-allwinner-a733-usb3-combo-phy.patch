From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 18:55:51 +0200
Subject: [PATCH] dt-bindings: phy: Add the Allwinner A733 USB3 combo PHY

The first combo PHY in the SERDES block of the A733 carries the
SuperSpeed lanes of the USB3 controller to a Type-C connector. The lane
swap for a flipped plug is done inside the PHY, so it can also be the
orientation switch of the connector.

Add a binding for its USB3 use. The USB3 PIPE muxes and the DisplayPort
lane width conversion of the PHY sit in the SERDES top page, which also
holds the protocol mux of the second combo PHY. That page is a system
controller of its own, referenced through allwinner,serdes-top, so
neither PHY node claims registers of the other.

Tested on Radxa Cubie A7S: booted on two boards; the node described by
this binding binds with its SERDES top phandle and carries the
SuperSpeed lanes of the USB3 controller.

Assisted-by: LLM
---
 .../allwinner,sun60i-a733-usb3-combophy.yaml  | 94 +++++++++++++++++++
 1 file changed, 94 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb3-combophy.yaml

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb3-combophy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb3-combophy.yaml
new file mode 100644
index 000000000000..e49e478a133c
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-usb3-combophy.yaml
@@ -0,0 +1,94 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/allwinner,sun60i-a733-usb3-combophy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 USB3 combo PHY
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The first combo PHY in the SERDES block of the A733 carries the SuperSpeed
+  lanes of the USB3 DRD controller to a USB Type-C connector. The lane swap
+  for a flipped plug is done inside the PHY, so it can act as the orientation
+  switch of the connector.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-usb3-combophy
+
+  reg:
+    items:
+      - description: PHY link control registers
+      - description: PMA registers
+
+  reg-names:
+    items:
+      - const: link
+      - const: pma
+
+  allwinner,serdes-top:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the SERDES top registers, a system controller shared with
+      the second combo PHY. It holds the USB3 PIPE clock and RX data muxes
+      and the DisplayPort lane width conversion of this PHY.
+
+  clocks:
+    items:
+      - description: SERDES PHY clock
+      - description: oscillator clock gate of the SERDES
+
+  clock-names:
+    items:
+      - const: serdes
+      - const: hosc
+
+  resets:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - allwinner,serdes-top
+  - clocks
+  - clock-names
+  - resets
+  - "#phy-cells"
+
+allOf:
+  - $ref: /schemas/usb/usb-switch.yaml#
+  - $ref: /schemas/usb/usb-switch-ports.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/clock/sun6i-rtc.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    phy@6c01000 {
+        compatible = "allwinner,sun60i-a733-usb3-combophy";
+        reg = <0x06c01000 0x1000>,
+              <0x06c80000 0x20000>;
+        reg-names = "link", "pma";
+        allwinner,serdes-top = <&serdes_top>;
+        clocks = <&ccu CLK_SERDES_PHY>, <&rtc CLK_HOSC_SERDES0>;
+        clock-names = "serdes", "hosc";
+        resets = <&ccu RST_BUS_SERDES>;
+        #phy-cells = <0>;
+        orientation-switch;
+
+        port {
+            endpoint {
+                remote-endpoint = <&usb_con_ss>;
+            };
+        };
+    };
