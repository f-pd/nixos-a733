From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Wed, 7 Oct 2026 20:29:36 +0200
Subject: [PATCH] dt-bindings: PCI: Add the Allwinner A733 PCIe controller

The A733 has one PCIe controller, a DesignWare core in Root Complex mode
with a single lane through the second combo PHY. Add a binding for it.

Besides the DesignWare registers the controller has application
registers with the LTSSM control, the link status and the System
Information Interface (SII). The SII collects the events of the Root
Port itself (AER, PME, link bandwidth) onto its own interrupt, which a
child interrupt controller hands to the Root Port node. Endpoint MSIs
go to the integrated MSI receiver of the core, on a second interrupt.

The clocks are the controller's own (auxiliary and AXI slave clock), its
three bus gates in the SERDES CCU and the AXI clock of the ITS in front
of it; the resets are the power-up and controller resets and the reset
of that ITS. PERST# is a GPIO and the slot supply a regulator.

Not covered: INTx of endpoints, and the controller's endpoint mode.

Tested on Radxa Cubie A7S: the binding check and the check of the board's
device tree pass, and the board booted with the controller node and the
driver bound to it.

Assisted-by: LLM
---
 .../pci/allwinner,sun60i-a733-pcie.yaml       | 187 ++++++++++++++++++
 1 file changed, 187 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml

diff --git a/Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml b/Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml
new file mode 100644
index 000000000000..15c3a53d1261
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/allwinner,sun60i-a733-pcie.yaml
@@ -0,0 +1,187 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/allwinner,sun60i-a733-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 PCIe Root Complex
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The PCIe controller of the A733 is a Synopsys DesignWare core in Root
+  Complex mode with one lane, routed through the second combo PHY. Its
+  application registers hold the LTSSM control, the link status and the
+  System Information Interface (SII), which collects the events of the Root
+  Port itself onto one interrupt. Inbound MSIs from the endpoints are
+  terminated by the integrated MSI receiver of the core.
+
+allOf:
+  - $ref: /schemas/pci/pci-host-bridge.yaml#
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-pcie
+
+  reg:
+    items:
+      - description: Data Bus Interface (DBI) registers
+      - description: application registers (User Defined Space)
+      - description: configuration space window
+
+  reg-names:
+    items:
+      - const: dbi
+      - const: app
+      - const: config
+
+  interrupts:
+    items:
+      - description: System Information Interface, events of the Root Port
+          and the link-down reset request
+      - description: integrated MSI receiver
+
+  interrupt-names:
+    items:
+      - const: sii
+      - const: msi
+
+  clocks:
+    items:
+      - description: auxiliary clock
+      - description: AXI slave interface clock
+      - description: ITS_PCIE0 AXI clock gate of the main CCU (ITS0_BGR)
+      - description: AXI slave bus gate
+      - description: AXI master bus gate
+      - description: AHB bus gate
+
+  clock-names:
+    items:
+      - const: aux
+      - const: axi-slv
+      - const: its
+      - const: slv-aclk
+      - const: mst-aclk
+      - const: hclk
+
+  resets:
+    items:
+      - description: power-up reset
+      - description: controller reset
+      - description: ITS_PCIE0 reset of the main CCU (ITS0_BGR)
+
+  reset-names:
+    items:
+      - const: pwrup
+      - const: core
+      - const: its
+
+  phys:
+    maxItems: 1
+
+  phy-names:
+    const: pcie-phy
+
+  power-domains:
+    maxItems: 1
+
+  num-lanes:
+    const: 1
+
+  legacy-interrupt-controller:
+    description:
+      Interrupt controller of the events of the Root Port, fed by the
+      System Information Interface. Its only source is the Root Port, as
+      hwirq 0.
+    type: object
+    additionalProperties: false
+
+    properties:
+      "#address-cells":
+        const: 0
+
+      "#interrupt-cells":
+        const: 1
+
+      interrupt-controller: true
+
+    required:
+      - "#address-cells"
+      - "#interrupt-cells"
+      - interrupt-controller
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - phys
+  - phy-names
+  - reset-gpios
+  - legacy-interrupt-controller
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/clock/allwinner,sun60i-a733-serdes-ccu.h>
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/allwinner,sun60i-a733-pck-600.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    pcie@6000000 {
+        compatible = "allwinner,sun60i-a733-pcie";
+        reg = <0x06000000 0x400000>,
+              <0x06400000 0x80000>,
+              <0x20000000 0x200000>;
+        reg-names = "dbi", "app", "config";
+        device_type = "pci";
+        #address-cells = <3>;
+        #size-cells = <2>;
+        bus-range = <0x00 0xff>;
+        ranges = <0x81000000 0x0 0x21000000 0x21000000 0x0 0x01000000>,
+                 <0x82000000 0x0 0x22000000 0x22000000 0x0 0x06000000>;
+        interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "sii", "msi";
+        clocks = <&ccu CLK_PCIE_AUX>, <&ccu CLK_PCIE_AXI_SLV>,
+                 <&ccu CLK_BUS_ITS_PCIE0_ACLK>,
+                 <&serdes_ccu CLK_BUS_PCIE_SLV_ACLK>,
+                 <&serdes_ccu CLK_BUS_PCIE_MST_ACLK>,
+                 <&serdes_ccu CLK_BUS_PCIE_HCLK>;
+        clock-names = "aux", "axi-slv", "its", "slv-aclk", "mst-aclk",
+                      "hclk";
+        resets = <&ccu RST_BUS_PCIE_PWRUP>, <&ccu RST_BUS_PCIE>,
+                 <&ccu RST_BUS_ITS_PCIE0>;
+        reset-names = "pwrup", "core", "its";
+        phys = <&combophy1>;
+        phy-names = "pcie-phy";
+        power-domains = <&pck600 PD_PCIE>;
+        num-lanes = <1>;
+        max-link-speed = <3>;
+        reset-gpios = <&pio 3 22 GPIO_ACTIVE_LOW>;
+        vpcie3v3-supply = <&reg_pcie>;
+
+        pcie_intc: legacy-interrupt-controller {
+            interrupt-controller;
+            #address-cells = <0>;
+            #interrupt-cells = <1>;
+        };
+
+        pcie@0,0 {
+            device_type = "pci";
+            reg = <0x0 0x0 0x0 0x0 0x0>;
+            #address-cells = <3>;
+            #size-cells = <2>;
+            ranges;
+            interrupts-extended = <&pcie_intc 0>;
+        };
+    };
