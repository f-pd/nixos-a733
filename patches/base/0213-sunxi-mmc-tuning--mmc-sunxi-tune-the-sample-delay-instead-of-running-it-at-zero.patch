From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Thu, 8 Oct 2026 11:36:56 +0200
Subject: [PATCH] mmc: sunxi: Tune the sample delay instead of running it at
 zero

The driver registers no ->execute_tuning, so mmc_execute_tuning()
returns 0 without sending a tuning block and SDR104 and HS200 run on
what sunxi_mmc_calibrate() writes: SAMP_DL_SW_EN with a delay of 0, a
value nobody chose.

Add ->execute_tuning for controllers that can calibrate. It sweeps
SAMP_DL_SW over 0..63 with mmc_send_tuning() and programs the middle of
the widest passing run, without wrapping, as the delay line is a chain.
The chosen value is tested again once programmed. A failure keeps delay
0 and returns 0: an error would abort an init that works untuned.

sunxi_mmc_calibrate() runs on every set_ios and would drop the result,
so it now reprograms the tuned delay in the timing it was tuned in, and
in HS400 when it was tuned in HS200 at the same ios->clock: the core
tunes HS400 in HS200, and command responses are still sampled through
this delay in HS400. All other timings, including the HS and DDR52
steps of the HS400 switch, write SAMP_DL_SW_EN with delay 0 as before.

Not covered: drift with temperature between retunes; HS400ES (untuned).

Tested on Radxa Cubie A7S: the SD card at SDR104 was tuned at boot and
after each of ten rebinds; every delay passed at this clock, the middle
one was programmed and read back after the rebinds, and the eMMC in
HS400 with enhanced strobe stayed untuned.

Assisted-by: LLM
---
 drivers/mmc/host/sunxi-mmc.c | 107 +++++++++++++++++++++++++++++++----
 1 file changed, 97 insertions(+), 10 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index 3bf1a7e5e5d9..5b63310dbf0e 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -442,6 +442,11 @@ struct sunxi_mmc_host {
 
 	/* HS400 data strobe delay */
 	u32		ds_dl;
+
+	/* tuned sample delay, and the timing and clock it was tuned at */
+	u32		samp_dl;
+	unsigned char	samp_dl_timing;
+	unsigned int	samp_dl_clock;
 };
 
 /*
@@ -1314,21 +1319,30 @@ static int sunxi_mmc_oclk_onoff(struct sunxi_mmc_host *host, u32 oclk_en)
 	return 0;
 }
 
-static int sunxi_mmc_calibrate(struct sunxi_mmc_host *host, int reg_off)
+static int sunxi_mmc_calibrate(struct sunxi_mmc_host *host,
+			       struct mmc_ios *ios, int reg_off)
 {
+	u32 dl = 0;
+
 	if (!host->cfg->can_calibrate)
 		return 0;
 
 	/*
-	 * FIXME:
-	 * This is not clear how the calibration is supposed to work
-	 * yet. The best rate have been obtained by simply setting the
-	 * delay to 0, as Allwinner does in its BSP.
-	 *
-	 * The only mode that doesn't have such a delay is HS400, that
-	 * is in itself a TODO.
+	 * Use the sample delay found by sunxi_mmc_execute_tuning() in the
+	 * timing it was tuned in, and in HS400 once that runs at the clock
+	 * HS200 was tuned at: the core tunes HS400 in HS200, and command
+	 * responses are still sampled through this delay in HS400.
+	 * Everything else keeps delay 0.
 	 */
-	writel(SDXC_CAL_DL_SW_EN, host->reg_base + reg_off);
+	if (reg_off == SDXC_REG_SAMP_DL_REG && host->samp_dl &&
+	    (ios->timing == host->samp_dl_timing ||
+	     (host->samp_dl_timing == MMC_TIMING_MMC_HS200 &&
+	      ios->timing == MMC_TIMING_MMC_HS400 &&
+	      ios->clock == host->samp_dl_clock)))
+		dl = host->samp_dl & SDXC_CAL_DL_MASK;
+
+	writel(SDXC_CAL_DL_SW_EN | (dl << SDXC_CAL_DL_SW_SHIFT),
+	       host->reg_base + reg_off);
 
 	return 0;
 }
@@ -1503,7 +1517,7 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	if (ret)
 		return ret;
 
-	ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
+	ret = sunxi_mmc_calibrate(host, ios, SDXC_REG_SAMP_DL_REG);
 	if (ret)
 		return ret;
 
@@ -1961,6 +1975,78 @@ static int sunxi_mmc_execute_hs400_tuning(struct mmc_host *mmc,
 	return 0;
 }
 
+/*
+ * Try every sample delay with the tuning block and keep the middle of the
+ * longest passing run; the delay line does not wrap. Never fail: a card
+ * that does not tune stays on delay 0, as it ran before.
+ */
+static int sunxi_mmc_execute_tuning(struct mmc_host *mmc, u32 opcode)
+{
+	struct sunxi_mmc_host *host = mmc_priv(mmc);
+	int i, run_start = -1, run_len = 0, best_start = -1, best_len = 0;
+	u64 passed = 0;
+	u32 dl;
+
+	if (!host->cfg->can_calibrate)
+		return 0;
+
+	for (i = 0; i <= SDXC_CAL_DL_MASK; i++) {
+		mmc_writel(host, REG_SAMP_DL_REG,
+			   SDXC_CAL_DL_SW_EN | (i << SDXC_CAL_DL_SW_SHIFT));
+
+		if (!mmc_send_tuning(mmc, opcode, NULL))
+			passed |= BIT_ULL(i);
+	}
+
+	for (i = 0; i <= SDXC_CAL_DL_MASK; i++) {
+		if (passed & BIT_ULL(i)) {
+			if (run_start < 0)
+				run_start = i;
+			run_len++;
+			if (run_len > best_len) {
+				best_len = run_len;
+				best_start = run_start;
+			}
+		} else {
+			run_start = -1;
+			run_len = 0;
+		}
+	}
+
+	if (best_len) {
+		dl = best_start + best_len / 2;
+		mmc_writel(host, REG_SAMP_DL_REG,
+			   SDXC_CAL_DL_SW_EN | (dl << SDXC_CAL_DL_SW_SHIFT));
+
+		if (mmc_send_tuning(mmc, opcode, NULL)) {
+			dev_err(mmc_dev(mmc),
+				"tuning: sample delay %u failed its confirmation, staying on delay 0 [%016llx]\n",
+				dl, passed);
+			best_len = 0;
+		} else {
+			host->samp_dl = dl;
+			host->samp_dl_timing = mmc->ios.timing;
+			host->samp_dl_clock = mmc->ios.clock;
+			dev_info(mmc_dev(mmc),
+				 "tuning: sample-delay window %d..%d (%d wide), using %u [%016llx]\n",
+				 best_start, best_start + best_len - 1,
+				 best_len, dl, passed);
+		}
+	}
+
+	if (!best_len) {
+		host->samp_dl = 0;
+		host->samp_dl_timing = MMC_TIMING_LEGACY;
+		host->samp_dl_clock = 0;
+		mmc_writel(host, REG_SAMP_DL_REG, SDXC_CAL_DL_SW_EN);
+		dev_err(mmc_dev(mmc),
+			"tuning: no sample delay passes, staying on delay 0 [%016llx]\n",
+			passed);
+	}
+
+	return 0;
+}
+
 static const struct mmc_host_ops sunxi_mmc_ops = {
 	.request	 = sunxi_mmc_request,
 	.set_ios	 = sunxi_mmc_set_ios,
@@ -1970,6 +2056,7 @@ static const struct mmc_host_ops sunxi_mmc_ops = {
 	.start_signal_voltage_switch = sunxi_mmc_volt_switch,
 	.card_hw_reset	 = sunxi_mmc_hw_reset,
 	.card_busy	 = sunxi_mmc_card_busy,
+	.execute_tuning	 = sunxi_mmc_execute_tuning,
 	.execute_hs400_tuning = sunxi_mmc_execute_hs400_tuning,
 	.hs400_enhanced_strobe = sunxi_mmc_hs400_enhanced_strobe,
 };
