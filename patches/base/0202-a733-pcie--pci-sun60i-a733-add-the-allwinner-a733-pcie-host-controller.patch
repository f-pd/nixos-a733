diff --git a/drivers/pci/controller/dwc/pcie-sun60i-a733.c b/drivers/pci/controller/dwc/pcie-sun60i-a733.c
new file mode 100644
index 000000000000..a623ceffa6c9
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-sun60i-a733.c
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PCIe Root Complex of the Allwinner A733
+ *
+ * The controller is a DesignWare core. Its DBI registers are at 0x06000000;
+ * the module base of the user manual, 0x06400000, is the User Defined Space
+ * of the Allwinner wrapper, here the "app" region, which holds the LTSSM
+ * control and the link status (A733 user manual V1.00, 18.3.8). The iATU,
+ * the integrated MSI receiver and the configuration accesses are those of
+ * the DesignWare core.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/reset.h>
+
+#include "../../pci.h"
+#include "pcie-designware.h"
+
+/* PCIE_LTSSM_ENABLE, reset value 0x40: device type root complex */
+#define SUN60I_A733_PCIE_LTSSM_CTRL		0x0c00
+/*
+ * APP_DBI_RO_WR_DISABLE forces DBI_RO_WR_EN in MISC_CONTROL_1 to 0 and makes
+ * it read-only (18.3.8.55, page 1220), so dw_pcie_dbi_ro_wr_en() cannot
+ * override it. Resets to 0.
+ */
+#define  SUN60I_A733_PCIE_APP_DBI_RO_WR_DISABLE	BIT(31)
+#define  SUN60I_A733_PCIE_LTSSM_ENABLE		BIT(0)
+#define  SUN60I_A733_PCIE_DEVICE_TYPE		GENMASK(7, 4)
+#define  SUN60I_A733_PCIE_DEVICE_TYPE_RC	0x4
+
+/* SII_INT_1 */
+#define SUN60I_A733_PCIE_LINK_STAT		0x0e0c
+
+/*
+ * The AXI slave clock resets to PERI0_600M. At that rate a configuration
+ * read through the slave window does not complete and stalls the CPU that
+ * issued it; at 400 MHz, one of the documented parents, it does.
+ */
+#define SUN60I_A733_PCIE_AXI_SLV_RATE		400000000
+
+enum {
+	SUN60I_A733_PCIE_CLK_AUX,
+	SUN60I_A733_PCIE_CLK_AXI_SLV,
+	SUN60I_A733_PCIE_CLK_ITS,
+	SUN60I_A733_PCIE_CLK_SLV_ACLK,
+	SUN60I_A733_PCIE_CLK_MST_ACLK,
+	SUN60I_A733_PCIE_CLK_HCLK,
+	SUN60I_A733_PCIE_NUM_CLKS,
+};
+
+static const char * const sun60i_a733_pcie_clk_names[] = {
+	[SUN60I_A733_PCIE_CLK_AUX]	= "aux",
+	[SUN60I_A733_PCIE_CLK_AXI_SLV]	= "axi-slv",
+	[SUN60I_A733_PCIE_CLK_ITS]	= "its",
+	[SUN60I_A733_PCIE_CLK_SLV_ACLK]	= "slv-aclk",
+	[SUN60I_A733_PCIE_CLK_MST_ACLK]	= "mst-aclk",
+	[SUN60I_A733_PCIE_CLK_HCLK]	= "hclk",
+};
+
+struct sun60i_a733_pcie {
+	struct dw_pcie		pci;
+	void __iomem		*app;
+	struct clk_bulk_data	clks[SUN60I_A733_PCIE_NUM_CLKS];
+	struct reset_control	*rst_pwrup;
+	struct reset_control	*rst_core;
+	struct reset_control	*rst_its;
+	struct phy		*phy;
+	struct gpio_desc	*perst;
+	struct regulator	*vpcie3v3;
+	u8			exp_cap;
+};
+
+static struct sun60i_a733_pcie *to_sun60i_a733_pcie(struct dw_pcie *pci)
+{
+	return container_of(pci, struct sun60i_a733_pcie, pci);
+}
+
+static int sun60i_a733_pcie_start_link(struct dw_pcie *pci)
+{
+	struct sun60i_a733_pcie *pcie = to_sun60i_a733_pcie(pci);
+	u32 val;
+
+	/*
+	 * The device type resets to root complex, but a warm start finds
+	 * whatever the boot loader left there.
+	 */
+	val = readl(pcie->app + SUN60I_A733_PCIE_LTSSM_CTRL);
+	val &= ~SUN60I_A733_PCIE_DEVICE_TYPE;
+	val |= FIELD_PREP(SUN60I_A733_PCIE_DEVICE_TYPE,
+			  SUN60I_A733_PCIE_DEVICE_TYPE_RC);
+	val |= SUN60I_A733_PCIE_LTSSM_ENABLE;
+	writel(val, pcie->app + SUN60I_A733_PCIE_LTSSM_CTRL);
+
+	return 0;
+}
+
+static void sun60i_a733_pcie_stop_link(struct dw_pcie *pci)
+{
+	struct sun60i_a733_pcie *pcie = to_sun60i_a733_pcie(pci);
+	u32 val;
+
+	val = readl(pcie->app + SUN60I_A733_PCIE_LTSSM_CTRL);
+	val &= ~SUN60I_A733_PCIE_LTSSM_ENABLE;
+	writel(val, pcie->app + SUN60I_A733_PCIE_LTSSM_CTRL);
+}
+
+/*
+ * Data Link Layer Link Active of the Root Port, read through the DBI. The
+ * link-up bits of SII_INT_1 are write-1-to-clear and latch (18.3.8.63): they
+ * read 1 with the link down, so they cannot tell whether the link is up.
+ */
+static bool sun60i_a733_pcie_link_up(struct dw_pcie *pci)
+{
+	struct sun60i_a733_pcie *pcie = to_sun60i_a733_pcie(pci);
+
+	if (!pcie->exp_cap)
+		return false;
+
+	return dw_pcie_readw_dbi(pci, pcie->exp_cap + PCI_EXP_LNKSTA) &
+	       PCI_EXP_LNKSTA_DLLLA;
+}
+
+/* The DBI is mapped here and the core has not asked for the link yet */
+static int sun60i_a733_pcie_host_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct sun60i_a733_pcie *pcie = to_sun60i_a733_pcie(pci);
+	u32 val;
+
+	/*
+	 * A warm start finds whatever the boot loader left here; with the
+	 * write disable set, every write to a read-only register is lost.
+	 */
+	val = readl(pcie->app + SUN60I_A733_PCIE_LTSSM_CTRL);
+	val &= ~SUN60I_A733_PCIE_APP_DBI_RO_WR_DISABLE;
+	writel(val, pcie->app + SUN60I_A733_PCIE_LTSSM_CTRL);
+
+	pcie->exp_cap = dw_pcie_find_capability(pci, PCI_CAP_ID_EXP);
+	if (!pcie->exp_cap)
+		return dev_err_probe(pci->dev, -ENODEV,
+				     "no PCI Express capability\n");
+
+	return 0;
+}
+
+static const struct dw_pcie_host_ops sun60i_a733_pcie_host_ops = {
+	.init	= sun60i_a733_pcie_host_init,
+};
+
+static const struct dw_pcie_ops sun60i_a733_dw_pcie_ops = {
+	.start_link	= sun60i_a733_pcie_start_link,
+	.stop_link	= sun60i_a733_pcie_stop_link,
+	.link_up	= sun60i_a733_pcie_link_up,
+};
+
+/* The reverse of the release order: ITS, controller, power-up */
+static int sun60i_a733_pcie_assert_resets(struct sun60i_a733_pcie *pcie)
+{
+	int ret;
+
+	ret = reset_control_assert(pcie->rst_its);
+	if (ret)
+		return ret;
+	ret = reset_control_assert(pcie->rst_core);
+	if (ret)
+		return ret;
+	return reset_control_assert(pcie->rst_pwrup);
+}
+
+static void sun60i_a733_pcie_power_off(void *data)
+{
+	struct sun60i_a733_pcie *pcie = data;
+
+	gpiod_set_value_cansleep(pcie->perst, 1);
+	phy_power_off(pcie->phy);
+	phy_exit(pcie->phy);
+	sun60i_a733_pcie_assert_resets(pcie);
+	clk_bulk_disable_unprepare(ARRAY_SIZE(pcie->clks), pcie->clks);
+	if (pcie->vpcie3v3)
+		regulator_disable(pcie->vpcie3v3);
+}
+
+static int sun60i_a733_pcie_power_on(struct sun60i_a733_pcie *pcie)
+{
+	struct device *dev = pcie->pci.dev;
+	int ret;
+
+	if (pcie->vpcie3v3) {
+		ret = regulator_enable(pcie->vpcie3v3);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to enable vpcie3v3\n");
+	}
+
+	ret = clk_set_rate(pcie->clks[SUN60I_A733_PCIE_CLK_AXI_SLV].clk,
+			   SUN60I_A733_PCIE_AXI_SLV_RATE);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to set the AXI slave clock\n");
+		goto err_regulator;
+	}
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(pcie->clks), pcie->clks);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to enable the clocks\n");
+		goto err_regulator;
+	}
+
+	/* A warm start can find the controller out of reset */
+	ret = sun60i_a733_pcie_assert_resets(pcie);
+	if (ret)
+		goto err_clocks;
+
+	/* Power-up reset, then the controller, then the ITS_PCIE0 reset of the CCU */
+	ret = reset_control_deassert(pcie->rst_pwrup);
+	if (ret)
+		goto err_clocks;
+	ret = reset_control_deassert(pcie->rst_core);
+	if (ret)
+		goto err_pwrup;
+	ret = reset_control_deassert(pcie->rst_its);
+	if (ret)
+		goto err_core;
+
+	/* The PHY generates the reference clock */
+	ret = phy_init(pcie->phy);
+	if (ret)
+		goto err_its;
+	ret = phy_power_on(pcie->phy);
+	if (ret)
+		goto err_phy_exit;
+
+	/* Power and reference clock stable before PERST# is released */
+	msleep(PCIE_T_PVPERL_MS);
+	gpiod_set_value_cansleep(pcie->perst, 0);
+
+	return 0;
+
+err_phy_exit:
+	phy_exit(pcie->phy);
+err_its:
+	reset_control_assert(pcie->rst_its);
+err_core:
+	reset_control_assert(pcie->rst_core);
+err_pwrup:
+	reset_control_assert(pcie->rst_pwrup);
+err_clocks:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(pcie->clks), pcie->clks);
+err_regulator:
+	if (pcie->vpcie3v3)
+		regulator_disable(pcie->vpcie3v3);
+	return ret;
+}
+
+static int sun60i_a733_pcie_get_resources(struct sun60i_a733_pcie *pcie)
+{
+	struct device *dev = pcie->pci.dev;
+	struct platform_device *pdev = to_platform_device(dev);
+	int ret, i;
+
+	pcie->app = devm_platform_ioremap_resource_byname(pdev, "app");
+	if (IS_ERR(pcie->app))
+		return PTR_ERR(pcie->app);
+
+	for (i = 0; i < ARRAY_SIZE(pcie->clks); i++)
+		pcie->clks[i].id = sun60i_a733_pcie_clk_names[i];
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(pcie->clks), pcie->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the clocks\n");
+
+	pcie->rst_pwrup = devm_reset_control_get_exclusive(dev, "pwrup");
+	if (IS_ERR(pcie->rst_pwrup))
+		return dev_err_probe(dev, PTR_ERR(pcie->rst_pwrup),
+				     "failed to get the pwrup reset\n");
+
+	pcie->rst_core = devm_reset_control_get_exclusive(dev, "core");
+	if (IS_ERR(pcie->rst_core))
+		return dev_err_probe(dev, PTR_ERR(pcie->rst_core),
+				     "failed to get the core reset\n");
+
+	pcie->rst_its = devm_reset_control_get_exclusive(dev, "its");
+	if (IS_ERR(pcie->rst_its))
+		return dev_err_probe(dev, PTR_ERR(pcie->rst_its),
+				     "failed to get the its reset\n");
+
+	pcie->phy = devm_phy_get(dev, "pcie-phy");
+	if (IS_ERR(pcie->phy))
+		return dev_err_probe(dev, PTR_ERR(pcie->phy),
+				     "failed to get the PHY\n");
+
+	/* PERST# is held asserted from here until the device is powered */
+	pcie->perst = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(pcie->perst))
+		return dev_err_probe(dev, PTR_ERR(pcie->perst),
+				     "failed to get the PERST# GPIO\n");
+
+	pcie->vpcie3v3 = devm_regulator_get_optional(dev, "vpcie3v3");
+	if (IS_ERR(pcie->vpcie3v3)) {
+		if (PTR_ERR(pcie->vpcie3v3) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(pcie->vpcie3v3),
+					     "failed to get vpcie3v3\n");
+		pcie->vpcie3v3 = NULL;
+	}
+
+	return 0;
+}
+
+static int sun60i_a733_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sun60i_a733_pcie *pcie;
+	int ret;
+
+	pcie = devm_kzalloc(dev, sizeof(*pcie), GFP_KERNEL);
+	if (!pcie)
+		return -ENOMEM;
+
+	pcie->pci.dev = dev;
+	pcie->pci.ops = &sun60i_a733_dw_pcie_ops;
+	pcie->pci.pp.ops = &sun60i_a733_pcie_host_ops;
+
+	ret = sun60i_a733_pcie_get_resources(pcie);
+	if (ret)
+		return ret;
+
+	ret = sun60i_a733_pcie_power_on(pcie);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(dev, sun60i_a733_pcie_power_off, pcie);
+	if (ret)
+		return ret;
+
+	ret = dw_pcie_host_init(&pcie->pci.pp);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to initialize host\n");
+
+	return 0;
+}
+
+static const struct of_device_id sun60i_a733_pcie_of_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-pcie" },
+	{ }
+};
+
+static struct platform_driver sun60i_a733_pcie_driver = {
+	.probe	= sun60i_a733_pcie_probe,
+	.driver	= {
+		.name			= "sun60i-a733-pcie",
+		.of_match_table		= sun60i_a733_pcie_of_match,
+		.suppress_bind_attrs	= true,
+	},
+};
+builtin_platform_driver(sun60i_a733_pcie_driver);
