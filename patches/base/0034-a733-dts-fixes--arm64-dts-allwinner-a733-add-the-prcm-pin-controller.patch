From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sat, 3 Oct 2026 16:34:04 +0200
Subject: [PATCH] arm64: dts: allwinner: a733: Add the PRCM pin controller

The PRCM pin controller, banks PL and PM, carries the pins of the PRCM's
own I2C, UART, SPI and PWM controllers, but is not described. Add it, with
the non-secure interrupt of each bank.

Tested on Radxa Cubie A7S: booted on two boards; the PRCM pin controller at
0x7025000 probes and initializes.

Assisted-by: LLM
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 6e3cac577e0b..17799725089f 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -209,6 +209,21 @@ r_ccu: clock-controller@7010000 {
 			#reset-cells = <1>;
 		};
 
+		r_pio: pinctrl@7025000 {
+			compatible = "allwinner,sun60i-a733-r-pinctrl";
+			reg = <0x07025000 0x410>;
+			interrupts = <GIC_SPI 198 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 200 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&r_ccu CLK_R_APB0>,
+				 <&ccu CLK_SYS_24M>,
+				 <&rtc CLK_OSC32K>;
+			clock-names = "apb", "hosc", "losc";
+			gpio-controller;
+			#gpio-cells = <3>;
+			interrupt-controller;
+			#interrupt-cells = <3>;
+		};
+
 		rtc: rtc@7090000 {
 			compatible = "allwinner,sun60i-a733-rtc",
 				     "allwinner,sun50i-r329-rtc";
