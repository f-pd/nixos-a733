From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 18:25:45 +0200
Subject: [PATCH] dt-bindings: iommu: Add Allwinner A733 IOMMU

The A733 has two IOMMU instances. Their register layout and their 34-bit
page table entries differ from the H6 IOMMU, so they get a binding of
their own instead of a compatible in allwinner,sun50i-h6-iommu.yaml.

Each instance has its own registers, interrupt, clocks, reset and page
table base, so each is a node of its own. The "iommus" cell is the index
of the master within its instance, as the user manual lists the masters.

A master's register block in the IOMMU sits behind that master's port on
the MBUS matrix, and an access to it while the port is gated stalls the
bus. Such a port gate is an optional "masterN" clock of the IOMMU, so
that the IOMMU can hold it while the master translates.

Tested on Radxa Cubie A7S: booted on two boards; both IOMMU nodes
described by this binding probe with the four clocks it names.

Assisted-by: LLM
---
 .../iommu/allwinner,sun60i-a733-iommu.yaml    | 93 +++++++++++++++++++
 1 file changed, 93 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/iommu/allwinner,sun60i-a733-iommu.yaml

diff --git a/Documentation/devicetree/bindings/iommu/allwinner,sun60i-a733-iommu.yaml b/Documentation/devicetree/bindings/iommu/allwinner,sun60i-a733-iommu.yaml
new file mode 100644
index 000000000000..918b7919e458
--- /dev/null
+++ b/Documentation/devicetree/bindings/iommu/allwinner,sun60i-a733-iommu.yaml
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iommu/allwinner,sun60i-a733-iommu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 IOMMU
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The Allwinner A733 has two IOMMU instances. Each has its own register
+  block, interrupt, clocks and reset, and one page table shared by all of
+  its bus masters. IOMMU0 serves USB0_USB1, CSI, ISP and VE_ENC (masters
+  0-3), IOMMU1 serves VE_MBUS0, VE_MBUS1, DE0, DI, G2D and EINK (masters
+  0-5). The register layout and the page table format differ from the
+  IOMMU described in allwinner,sun50i-h6-iommu.yaml.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-iommu
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 4
+    maxItems: 19
+    description:
+      The IOMMU's own gates -- SYS_MCLK, SYS_PCLK, SYS_HCLK and its MBUS
+      master gate -- followed, optionally, by the MBUS matrix port gate of
+      each master whose port can be gated while the IOMMU runs. A master's
+      register block inside the IOMMU does not answer while that master's
+      port is gated, so the IOMMU holds the port gate for as long as the
+      master translates.
+
+  clock-names:
+    allOf:
+      - minItems: 4
+        maxItems: 19
+        additionalItems: true
+        items:
+          - const: mclk
+          - const: pclk
+          - const: hclk
+          - const: mbus
+      - items:
+          pattern: '^(mclk|pclk|hclk|mbus|master([0-9]|1[0-4]))$'
+
+  resets:
+    maxItems: 1
+
+  "#iommu-cells":
+    const: 1
+    description:
+      The index of the bus master within this IOMMU.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - "#iommu-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    iommu@3910000 {
+        compatible = "allwinner,sun60i-a733-iommu";
+        reg = <0x03910000 0x10000>;
+        interrupts = <GIC_SPI 171 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&ccu CLK_MBUS_IOMMU1_SYS>, <&ccu CLK_APB_IOMMU1_SYS>,
+                 <&ccu CLK_AHB_IOMMU1_SYS>, <&ccu CLK_MBUS_IOMMU1>,
+                 <&ccu CLK_MBUS_VE_DEC0_GATE>, <&ccu CLK_MBUS_VE_DEC0_GATE>;
+        clock-names = "mclk", "pclk", "hclk", "mbus",
+                      "master0", "master1";
+        resets = <&ccu RST_BUS_IOMMU1_SYS>;
+        #iommu-cells = <1>;
+    };
+
+...
