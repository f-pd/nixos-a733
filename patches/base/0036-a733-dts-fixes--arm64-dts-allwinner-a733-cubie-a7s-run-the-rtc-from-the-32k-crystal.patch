From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sat, 3 Oct 2026 16:34:05 +0200
Subject: [PATCH] arm64: dts: allwinner: a733: cubie-a7s: Run the RTC from the
 32k crystal

Without the board's 32.768 kHz crystal in the device tree, the RTC runs its
32 kHz clock from the internal RC oscillator, which is far less accurate.
Describe the crystal and select it as the RTC's 32 kHz source.

Tested on Radxa Cubie A7S: booted on two boards; osc32k runs from
ext_osc32k at 32768 Hz, and the RTC keeps pace with the uptime.

Assisted-by: LLM
---
 .../boot/dts/allwinner/sun60i-a733-cubie-a7s.dts  | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
index fbd9d84ff0e4..3cb3060ed566 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
@@ -17,6 +17,13 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	ext_osc32k: ext-osc32k-clk {
+		#clock-cells = <0>;
+		compatible = "fixed-clock";
+		clock-frequency = <32768>;
+		clock-output-names = "ext_osc32k";
+	};
+
 	reg_vcc3v3: vcc3v3 {
 		compatible = "regulator-fixed";
 		regulator-name = "vcc-3v3";
@@ -38,6 +45,14 @@ &osc {
 	clock-frequency = <26000000>;
 };
 
+&rtc {
+	clocks = <&r_ccu CLK_BUS_R_RTC>, <&osc>,
+		 <&r_ccu CLK_R_AHB>, <&ext_osc32k>;
+	clock-names = "bus", "hosc", "ahb", "ext-osc32k";
+	assigned-clocks = <&rtc CLK_OSC32K>;
+	assigned-clock-rates = <32768>;
+};
+
 &uart0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart0_pb_pins>;
