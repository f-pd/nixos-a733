From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 09:10:13 +0200
Subject: [PATCH] mmc: sunxi: Tune the HS400 data strobe delay

The usable data strobe delay depends on card and board, and a delay
outside the window makes every HS400 read fail.

Implement ->execute_hs400_tuning: read the EXT_CSD at each of the 64
delays, keep the middle of the longest error-free window, and read the
card status once to clear the error bits the failed reads left. The
tuned delay is programmed again whenever HS400 timing is set up.

Tested on Radxa Cubie A7S: booted on two boards; on the board with an
eMMC, tuning sets a data strobe delay of 11 in HS400 and in enhanced
strobe mode, and no "no working HS400 data strobe delay" is logged.

Assisted-by: LLM
---
 drivers/mmc/host/sunxi-mmc.c | 51 ++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index ee320d9d942e..8fe2f4934542 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -1240,6 +1240,56 @@ static int sunxi_mmc_card_busy(struct mmc_host *mmc)
 	return !!(mmc_readl(host, REG_STAS) & SDXC_CARD_DATA_BUSY);
 }
 
+/*
+ * Called by the core once the bus runs in HS400. Read the EXT_CSD with every
+ * data strobe delay and keep the middle of the longest passing window.
+ */
+static int sunxi_mmc_execute_hs400_tuning(struct mmc_host *mmc,
+					  struct mmc_card *card)
+{
+	struct sunxi_mmc_host *host = mmc_priv(mmc);
+	int i, start = 0, best_start = 0, best_len = 0;
+	u8 *ext_csd;
+	u32 status, rval;
+
+	rval = mmc_readl(host, REG_DS_DL_REG) & ~SDXC_CAL_DL_MASK;
+
+	for (i = 0; i <= SDXC_CAL_DL_MASK + 1; i++) {
+		bool pass = false;
+
+		if (i <= SDXC_CAL_DL_MASK) {
+			mmc_writel(host, REG_DS_DL_REG,
+				   rval | SDXC_CAL_DL_SW_EN | i);
+			pass = !mmc_get_ext_csd(card, &ext_csd);
+			if (pass)
+				kfree(ext_csd);
+		}
+
+		if (!pass) {
+			if (i - start > best_len) {
+				best_start = start;
+				best_len = i - start;
+			}
+			start = i + 1;
+		}
+	}
+
+	/* The failed reads leave error bits in the card status */
+	mmc_send_status(card, &status);
+
+	if (!best_len) {
+		dev_err(mmc_dev(mmc), "no working HS400 data strobe delay\n");
+		return -EIO;
+	}
+
+	host->ds_dl = best_start + best_len / 2;
+	mmc_writel(host, REG_DS_DL_REG, rval | SDXC_CAL_DL_SW_EN | host->ds_dl);
+	dev_dbg(mmc_dev(mmc), "HS400 data strobe delay %d..%d, using %u\n",
+		best_start, best_start + best_len - 1, host->ds_dl);
+
+	return 0;
+}
+
 static const struct mmc_host_ops sunxi_mmc_ops = {
 	.request	 = sunxi_mmc_request,
 	.set_ios	 = sunxi_mmc_set_ios,
@@ -1249,6 +1299,7 @@ static const struct mmc_host_ops sunxi_mmc_ops = {
 	.start_signal_voltage_switch = sunxi_mmc_volt_switch,
 	.card_hw_reset	 = sunxi_mmc_hw_reset,
 	.card_busy	 = sunxi_mmc_card_busy,
+	.execute_hs400_tuning = sunxi_mmc_execute_hs400_tuning,
 };
 
 static const struct sunxi_mmc_clk_delay sunxi_mmc_clk_delays[] = {
