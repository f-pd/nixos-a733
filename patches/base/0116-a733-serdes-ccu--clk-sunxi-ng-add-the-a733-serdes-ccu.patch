 sun60i-a733-r-ccu-y		+= ccu-sun60i-a733-r.o
+sun60i-a733-serdes-ccu-y	+= ccu-sun60i-a733-serdes.o
 sun4i-a10-ccu-y			+= ccu-sun4i-a10.o
