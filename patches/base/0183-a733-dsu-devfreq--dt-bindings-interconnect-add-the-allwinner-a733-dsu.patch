From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Mon, 5 Oct 2026 12:03:49 +0200
Subject: [PATCH] dt-bindings: interconnect: Add the Allwinner A733 DSU

The DynamIQ Shared Unit (DSU) of the A733 holds the L3 cache and the
snoop filter of all eight cores. Boot firmware leaves its clock at a
fixed rate, and nothing in Linux describes it.

Add a binding for the DSU as a device of its own, with the DSU clock of
the CPU clock controller, an optional AXI divider, an operating point
table and the supply it shares with the Cortex-A55 cluster. As in the
CPU tables, the voltage of a point depends on the speed bin of the die:
the optional nvmem cell holds the fuse word, opp-microvolt-speed<bin>
the voltage of that bin. The binding sits next to mediatek,cci.yaml,
the binding of a cache interconnect that also shares its regulator
with a CPU cluster.

Tested on Radxa Cubie A7S: booted on two boards; the dsu node with this
compatible, with its clock, supply, operating points and speed bin cell,
binds the driver, registers a devfreq device and takes the voltage
column of its bin.

Assisted-by: LLM
---
 .../allwinner,sun60i-a733-dsu.yaml            | 100 ++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/interconnect/allwinner,sun60i-a733-dsu.yaml

diff --git a/Documentation/devicetree/bindings/interconnect/allwinner,sun60i-a733-dsu.yaml b/Documentation/devicetree/bindings/interconnect/allwinner,sun60i-a733-dsu.yaml
new file mode 100644
index 000000000000..a2b17e09ba5a
--- /dev/null
+++ b/Documentation/devicetree/bindings/interconnect/allwinner,sun60i-a733-dsu.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interconnect/allwinner,sun60i-a733-dsu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 DynamIQ Shared Unit frequency and voltage scaling
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The DynamIQ Shared Unit (DSU) of the Allwinner A733 holds the L3 cache and
+  the snoop filter shared by its Cortex-A55 and Cortex-A76 cores. Its clock
+  can follow the CPU frequency policies; its voltage comes from the supply it
+  shares with the Cortex-A55 cluster. The OPP table carries one voltage per
+  CPU speed bin (opp-microvolt-speed<bin>, <bin> the raw fuse value) and an
+  unnamed worst-case voltage for parts without a usable bin.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-dsu
+
+  clocks:
+    minItems: 1
+    items:
+      - description: The DSU clock multiplexer of the CPU clock controller.
+      - description:
+          The DSU's AXI clock divider. With it, the driver runs the AXI at
+          DSU/1 at the low operating points and at DSU/2 above them.
+
+  clock-names:
+    minItems: 1
+    items:
+      - const: dsu
+      - const: axi
+
+  operating-points-v2: true
+
+  opp-table:
+    type: object
+
+  dsu-supply:
+    description:
+      The regulator that supplies the DSU, shared with the Cortex-A55
+      cluster.
+
+  nvmem-cells:
+    items:
+      - description: The eFuse word that holds the CPU speed bin in bits 15:8.
+
+  nvmem-cell-names:
+    items:
+      - const: speed
+
+dependencies:
+  nvmem-cells: [ nvmem-cell-names ]
+
+required:
+  - compatible
+  - clocks
+  - operating-points-v2
+  - dsu-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-cpu-ccu.h>
+
+    dsu {
+        compatible = "allwinner,sun60i-a733-dsu";
+        clocks = <&cpu_ccu CLK_CPU_DSU>, <&cpu_ccu CLK_CPU_DSU_AXI>;
+        clock-names = "dsu", "axi";
+        operating-points-v2 = <&dsu_opp_table>;
+        dsu-supply = <&reg_dcdc5>;
+        nvmem-cells = <&cpu_speed_grade>;
+        nvmem-cell-names = "speed";
+    };
+
+    dsu_opp_table: opp-table-dsu {
+        compatible = "operating-points-v2";
+
+        opp-780000000 {
+            opp-hz = /bits/ 64 <780000000>;
+            opp-microvolt = <800000 800000 1050000>;
+            opp-microvolt-speed4 = <800000 800000 1050000>;
+            opp-microvolt-speed5 = <800000 800000 1050000>;
+            opp-supported-hw = <0x00000031>;
+        };
+
+        opp-1066000000 {
+            opp-hz = /bits/ 64 <1066000000>;
+            opp-microvolt = <950000 950000 1050000>;
+            opp-microvolt-speed4 = <840000 840000 1050000>;
+            opp-microvolt-speed5 = <800000 800000 1050000>;
+            opp-supported-hw = <0x00000031>;
+        };
+    };
+...
