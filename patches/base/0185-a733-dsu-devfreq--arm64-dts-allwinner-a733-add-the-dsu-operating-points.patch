 1 file changed, 191 insertions(+)
 create mode 100644 arch/arm64/boot/dts/allwinner/sun60i-a733-dsu-opp.dtsi

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-dsu-opp.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733-dsu-opp.dtsi
new file mode 100644
index 000000000000..bbc1593de533
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-dsu-opp.dtsi
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+
+/*
+ * DSU operating points of the Allwinner A733.
+ *
+ * A board includes this file and sets dsu-supply on the dsu node: the
+ * regulator of the Cortex-A55 cluster, which also supplies the DSU.
+ *
+ * Frequencies are 26 MHz * N (the DSU PLL runs from the 26 MHz crystal);
+ * the points below 650 MHz run the PLL at two or four times the rate
+ * behind its output divider. Which points a die runs, and at which
+ * voltage, depends on the speed bin in its eFuse, as in
+ * sun60i-a733-cpu-opp.dtsi:
+ *
+ *  - opp-supported-hw: bit b is set when bin b runs the point; the bit
+ *    is the fuse value. Bit 0 marks the worst-case set, which a die with
+ *    no usable bin gets.
+ *  - opp-microvolt-speed<b>: the voltage of bin b, as <target min max>,
+ *    with the maximum of the CPU tables, so that the DSU shares the
+ *    rail's window with the A55 cluster.
+ *  - opp-microvolt: the worst case, the highest voltage of any bin, on
+ *    the points that every bin runs.
+ *
+ * The driver never lets the DSU ask for more than the A55 cluster already
+ * holds, so the points above the A55's highest voltage are listed but not
+ * reached.
+ *
+ * Bins 4 and 5 are the dies this table was run on. The columns of bins 1,
+ * 2, 3, 6, 20 and 21 are vendor values, not measured on our boards; each
+ * run of them is marked.
+ */
+
+/ {
+	dsu_opp_table: opp-table-dsu {
+		compatible = "operating-points-v2";
+
+		opp-312000000 {
+			opp-hz = /bits/ 64 <312000000>;
+			opp-supported-hw = <0x0030007f>;
+			opp-microvolt = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <800000 800000 1050000>;
+			opp-microvolt-speed2 = <800000 800000 1050000>;
+			opp-microvolt-speed3 = <800000 800000 1050000>;
+			opp-microvolt-speed4 = <800000 800000 1050000>;
+			opp-microvolt-speed5 = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed6 = <800000 800000 1050000>;
+			opp-microvolt-speed20 = <800000 800000 1050000>;
+			opp-microvolt-speed21 = <800000 800000 1050000>;
+		};
+
+		opp-598000000 {
+			opp-hz = /bits/ 64 <598000000>;
+			opp-supported-hw = <0x0030007f>;
+			opp-microvolt = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <800000 800000 1050000>;
+			opp-microvolt-speed2 = <800000 800000 1050000>;
+			opp-microvolt-speed3 = <800000 800000 1050000>;
+			opp-microvolt-speed4 = <800000 800000 1050000>;
+			opp-microvolt-speed5 = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed6 = <800000 800000 1050000>;
+			opp-microvolt-speed20 = <800000 800000 1050000>;
+			opp-microvolt-speed21 = <800000 800000 1050000>;
+		};
+
+		opp-780000000 {
+			opp-hz = /bits/ 64 <780000000>;
+			opp-supported-hw = <0x0030007f>;
+			opp-microvolt = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <800000 800000 1050000>;
+			opp-microvolt-speed2 = <800000 800000 1050000>;
+			opp-microvolt-speed3 = <800000 800000 1050000>;
+			opp-microvolt-speed4 = <800000 800000 1050000>;
+			opp-microvolt-speed5 = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed6 = <800000 800000 1050000>;
+			opp-microvolt-speed20 = <800000 800000 1050000>;
+			opp-microvolt-speed21 = <800000 800000 1050000>;
+		};
+
+		opp-832000000 {
+			opp-hz = /bits/ 64 <832000000>;
+			opp-supported-hw = <0x00000002>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <800000 800000 1050000>;
+		};
+
+		opp-910000000 {
+			opp-hz = /bits/ 64 <910000000>;
+			opp-supported-hw = <0x0030007f>;
+			opp-microvolt = <850000 850000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <850000 850000 1050000>;
+			opp-microvolt-speed2 = <800000 800000 1050000>;
+			opp-microvolt-speed3 = <800000 800000 1050000>;
+			opp-microvolt-speed4 = <800000 800000 1050000>;
+			opp-microvolt-speed5 = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed6 = <800000 800000 1050000>;
+			opp-microvolt-speed20 = <800000 800000 1050000>;
+			opp-microvolt-speed21 = <800000 800000 1050000>;
+		};
+
+		opp-988000000 {
+			opp-hz = /bits/ 64 <988000000>;
+			opp-supported-hw = <0x00000006>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <900000 900000 1050000>;
+			opp-microvolt-speed2 = <800000 800000 1050000>;
+		};
+
+		opp-1066000000 {
+			opp-hz = /bits/ 64 <1066000000>;
+			opp-supported-hw = <0x0030007f>;
+			opp-microvolt = <950000 950000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <950000 950000 1050000>;
+			opp-microvolt-speed2 = <850000 850000 1050000>;
+			opp-microvolt-speed3 = <860000 860000 1050000>;
+			opp-microvolt-speed4 = <840000 840000 1050000>;
+			opp-microvolt-speed5 = <800000 800000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed6 = <840000 840000 1050000>;
+			opp-microvolt-speed20 = <800000 800000 1050000>;
+			opp-microvolt-speed21 = <800000 800000 1050000>;
+		};
+
+		opp-1144000000 {
+			opp-hz = /bits/ 64 <1144000000>;
+			opp-supported-hw = <0x00300036>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <1000000 1000000 1050000>;
+			opp-microvolt-speed2 = <900000 900000 1050000>;
+			opp-microvolt-speed4 = <880000 880000 1050000>;
+			opp-microvolt-speed5 = <820000 820000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed20 = <820000 820000 1050000>;
+			opp-microvolt-speed21 = <820000 820000 1050000>;
+		};
+
+		opp-1222000000 {
+			opp-hz = /bits/ 64 <1222000000>;
+			opp-supported-hw = <0x00300036>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed1 = <1050000 1050000 1050000>;
+			opp-microvolt-speed2 = <950000 950000 1050000>;
+			opp-microvolt-speed4 = <920000 920000 1050000>;
+			opp-microvolt-speed5 = <860000 860000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed20 = <860000 860000 1050000>;
+			opp-microvolt-speed21 = <840000 840000 1050000>;
+		};
+
+		opp-1248000000 {
+			opp-hz = /bits/ 64 <1248000000>;
+			opp-supported-hw = <0x00300034>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed2 = <1000000 1000000 1050000>;
+			opp-microvolt-speed4 = <960000 960000 1050000>;
+			opp-microvolt-speed5 = <900000 900000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed20 = <900000 900000 1050000>;
+			opp-microvolt-speed21 = <860000 860000 1050000>;
+		};
+
+		opp-1274000000 {
+			opp-hz = /bits/ 64 <1274000000>;
+			opp-supported-hw = <0x00300034>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed2 = <1050000 1050000 1050000>;
+			opp-microvolt-speed4 = <1000000 1000000 1050000>;
+			opp-microvolt-speed5 = <950000 950000 1050000>;
+			/* vendor values, not measured on our boards */
+			opp-microvolt-speed20 = <950000 950000 1050000>;
+			opp-microvolt-speed21 = <900000 900000 1050000>;
+		};
+	};
+
+	dsu: dsu {
+		compatible = "allwinner,sun60i-a733-dsu";
+		clocks = <&cpu_ccu CLK_CPU_DSU>, <&cpu_ccu CLK_CPU_DSU_AXI>;
+		clock-names = "dsu", "axi";
+		operating-points-v2 = <&dsu_opp_table>;
+		nvmem-cells = <&cpu_speed_grade>;
+		nvmem-cell-names = "speed";
+	};
+};
