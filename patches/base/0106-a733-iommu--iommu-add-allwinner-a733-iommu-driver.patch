--- /dev/null
+++ b/drivers/iommu/sun60i-iommu.c
@@ -0,0 +1,1273 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Allwinner A733 (sun60i) IOMMU driver
+ *
+ * The A733 has two IOMMU instances. Each has a global register block at
+ * +0x000..+0x3ff, one 0x200-wide block per bus master from +0x400, one
+ * interrupt, and one page table base register shared by all of its masters.
+ * So one DT node is one IOMMU and one iommu group, and the single cell of
+ * "iommus" is the master index within that IOMMU.
+ *
+ * This is not the generation handled by sun50i-iommu.c: that layout's
+ * ENABLE, BYPASS and TTB registers at 0x20/0x30/0x50 read as zero here, its
+ * page table entries carry 32-bit addresses, and it has a single bypass
+ * register for all masters of a single instance.
+ *
+ * The A733 user manual describes this IOMMU in a one-page feature list and
+ * has no register description. The register offsets below follow
+ * Allwinner's BSP driver (sunxi-iommu-v2.c). Everything this driver needs
+ * for translation was read back on an A733 while the BSP kernel was
+ * translating for the display engine, and the page table format was
+ * confirmed by walking that kernel's live tables. Registers and bits marked
+ * "(BSP)" are taken from the BSP driver alone: their meaning has not been
+ * observed on hardware.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+#include "iommu-pages.h"
+
+/* Global registers, one set per IOMMU */
+
+/* 0x16 on both instances; the only version this layout is known for. */
+#define SUN60I_IOMMU_VERSION_REG	0x000
+#define SUN60I_IOMMU_VERSION_V16		0x16
+/* Reads 0x00037fff at reset. (BSP) bit m holds master m in reset when 0. */
+#define SUN60I_IOMMU_RESET_REG		0x010
+/* 0 at reset, 1 while translating. */
+#define SUN60I_IOMMU_ENABLE_REG		0x014
+#define SUN60I_IOMMU_ENABLE			BIT(0)
+/* Physical address of the L1 table >> 14. */
+#define SUN60I_IOMMU_TTB_REG		0x020
+#define SUN60I_IOMMU_TTB_SHIFT			14
+/*
+ * 0x00030000 at reset, 0 while the BSP kernel translates. The bit meanings
+ * are unknown; 0 is the only value this IOMMU has been seen translating
+ * with.
+ */
+#define SUN60I_IOMMU_TLB_PREFETCH_REG	0x02c
+/* (BSP) bit 0 flushes the macro TLB, bit 1 the page table walk cache. */
+#define SUN60I_IOMMU_TLB_FLUSH_REG	0x030
+#define SUN60I_IOMMU_TLB_FLUSH_ALL		(BIT(1) | BIT(0))
+/* 1 while translating; (BSP) range invalidation mode. */
+#define SUN60I_IOMMU_TLB_IVLD_MODE_REG	0x040
+/* Page numbers (IOVA >> 12) of the range to invalidate. */
+#define SUN60I_IOMMU_TLB_IVLD_START_REG	0x044
+#define SUN60I_IOMMU_TLB_IVLD_END_REG	0x048
+#define SUN60I_IOMMU_TLB_IVLD_ENABLE_REG	0x054
+/* 1 while translating; (BSP) range invalidation mode. */
+#define SUN60I_IOMMU_PC_IVLD_MODE_REG	0x060
+/* 4 MiB numbers (IOVA >> 22) of the range to invalidate. */
+#define SUN60I_IOMMU_PC_IVLD_START_REG	0x068
+#define SUN60I_IOMMU_PC_IVLD_ENABLE_REG	0x06c
+#define SUN60I_IOMMU_PC_IVLD_END_REG	0x070
+#define SUN60I_IOMMU_IVLD_ENABLE		BIT(0)
+/* 3 while translating: bit 0 L1, bit 1 L2 page table fault. */
+#define SUN60I_IOMMU_INT_ENABLE_REG	0x080
+#define SUN60I_IOMMU_INT_L1_EN			BIT(0)
+#define SUN60I_IOMMU_INT_L2_EN			BIT(1)
+/*
+ * Interrupt clear, status and error registers. An L1 fault has been
+ * provoked on hardware: it sets INT_STA bit 16, names the faulting master
+ * in L1PG_INT and the IOVA in INT_ERR_ADDR_L1, and INT_STA reads clear
+ * after the handler below has run. L1PG_INT keeps the master's bit after
+ * that, and no write that clears it is known. The rest is (BSP).
+ */
+#define SUN60I_IOMMU_INT_CLR_REG	0x084
+#define SUN60I_IOMMU_INT_STA_REG	0x088
+#define SUN60I_IOMMU_INT_STA_MASTER		GENMASK(14, 0)
+#define SUN60I_IOMMU_INT_STA_L1			BIT(16)
+#define SUN60I_IOMMU_INT_STA_L2			BIT(17)
+#define SUN60I_IOMMU_INT_ERR_ADDR_L1_LO	0x08c
+#define SUN60I_IOMMU_INT_ERR_ADDR_L1_HI	0x090
+#define SUN60I_IOMMU_INT_ERR_ADDR_L2_LO	0x094
+#define SUN60I_IOMMU_INT_ERR_ADDR_L2_HI	0x098
+#define SUN60I_IOMMU_INT_ERR_DATA_L1	0x09c
+#define SUN60I_IOMMU_INT_ERR_DATA_L2	0x0a0
+#define SUN60I_IOMMU_L1PG_INT_REG	0x0b0
+#define SUN60I_IOMMU_L2PG_INT_REG	0x0b4
+/* (BSP) set in L1PG/L2PG_INT when the fault came from a prefetch. */
+#define SUN60I_IOMMU_PG_INT_PREFETCH		BIT(31)
+
+/* Per-master "micro TLB" block */
+
+#define SUN60I_IOMMU_MASTER_BASE(m)	(0x400 + 0x200 * (m))
+/* 1 at reset in every implemented master block, 0 where there is none. */
+#define SUN60I_IOMMU_M_AUTO_GATING	0x00
+/* 1 = bypass (reset value), 0 = translate. */
+#define SUN60I_IOMMU_M_BYP		0x04
+/* (BSP) flush this master's TLB. */
+#define SUN60I_IOMMU_M_TLB_FLUSH	0x18
+/* 1 on every master while the BSP kernel translates. */
+#define SUN60I_IOMMU_M_INT_ENABLE	0x30
+/* (BSP) */
+#define SUN60I_IOMMU_M_INT_CLR		0x34
+#define SUN60I_IOMMU_M_INT_ERR_ADDR_LO	0x3c
+#define SUN60I_IOMMU_M_INT_ERR_ADDR_HI	0x40
+#define SUN60I_IOMMU_M_INT_ERR_DATA	0x44
+
+/* Up to 15 masters per IOMMU (A733 user manual, chapter 10). */
+#define SUN60I_IOMMU_MAX_MASTERS	15
+
+/*
+ * Page table. 34-bit IOVA, a 16 GiB space. L1: 4096
+ * entries indexed by IOVA[33:22], 16 KiB, found through TTB = pa >> 14, so
+ * the table must be 16 KiB aligned. L2: 1024 entries indexed by
+ * IOVA[21:12], 4 KiB. Entries are 32 bits wide and carry a 34-bit physical
+ * address: bits 31:12 are the address's bits 31:12, bits 9:8 its bits
+ * 33:32. Tables and pages above 4 GiB have been walked on hardware; the
+ * permission bits have only been seen set together.
+ *
+ *   DTE  31:12 L2 table | 9:8 table 33:32 | 1:0 = 01 valid
+ *   PTE  31:12 page     | 9:8 page 33:32  | 3 W | 2 R | 1 valid
+ */
+#define SUN60I_IOVA_BITS		34
+#define SUN60I_L1_SHIFT			22
+#define SUN60I_L1_ENTRIES		4096
+#define SUN60I_L1_SIZE			SZ_16K
+#define SUN60I_L2_ENTRIES		1024
+#define SUN60I_L2_SIZE			SZ_4K
+#define SUN60I_PAGE_SIZE		SZ_4K
+#define SUN60I_PAGE_SHIFT		12
+
+#define SUN60I_ENT_ADDR_LOW		GENMASK(31, 12)
+#define SUN60I_ENT_ADDR_HIGH		GENMASK(9, 8)
+#define SUN60I_DTE_VALID_MASK		GENMASK(1, 0)
+#define SUN60I_DTE_VALID		0x1
+#define SUN60I_PTE_WRITABLE		BIT(3)
+#define SUN60I_PTE_READABLE		BIT(2)
+#define SUN60I_PTE_VALID		BIT(1)
+
+/*
+ * Physical addresses an entry carries as they are. The BSP driver gives
+ * entry addresses below 0x40000000 a second meaning (see
+ * sun60i_iommu_pa_ok()); RAM on this SoC starts at the lower bound.
+ */
+#define SUN60I_PA_MIN			0x40000000ULL
+#define SUN60I_PA_END			BIT_ULL(SUN60I_IOVA_BITS)
+
+#define SUN60I_IOMMU_CMD_TIMEOUT_US	1000
+
+struct sun60i_iommu {
+	struct iommu_device iommu;
+	struct device *dev;
+	void __iomem *base;
+	/* Serialises every register access of this IOMMU. */
+	spinlock_t lock;
+	/* The paging domain TTB points at, or NULL (all masters in bypass). */
+	struct sun60i_iommu_domain *domain;
+	/* Devices attached to a paging domain, per master. */
+	u8 users[SUN60I_IOMMU_MAX_MASTERS];
+	/*
+	 * The master's MBUS matrix port gate ("masterN"), prepared at probe and
+	 * enabled for as long as the master has a user. A master block does not
+	 * answer while its port is gated: an access stalls the bus. NULL for a
+	 * master that names no port gate.
+	 */
+	struct clk *master_clk[SUN60I_IOMMU_MAX_MASTERS];
+};
+
+struct sun60i_iommu_domain {
+	struct iommu_domain domain;
+	u32 *l1;
+	/*
+	 * The IOMMU of the device the domain was allocated for. Tables of one
+	 * IOMMU are never handed to the other (attach refuses it).
+	 */
+	struct sun60i_iommu *iommu;
+};
+
+/* One per client device, dev_iommu_priv. */
+struct sun60i_iommu_client {
+	struct sun60i_iommu *iommu;
+	/* This device holds a count in iommu->users for each of its masters. */
+	bool translating;
+};
+
+static struct sun60i_iommu_domain *to_sun60i_domain(struct iommu_domain *domain)
+{
+	return container_of(domain, struct sun60i_iommu_domain, domain);
+}
+
+static u32 sun60i_read(struct sun60i_iommu *iommu, u32 off)
+{
+	return readl(iommu->base + off);
+}
+
+static void sun60i_write(struct sun60i_iommu *iommu, u32 off, u32 val)
+{
+	writel(val, iommu->base + off);
+}
+
+static void sun60i_mwrite(struct sun60i_iommu *iommu, unsigned int m, u32 off,
+			  u32 val)
+{
+	writel(val, iommu->base + SUN60I_IOMMU_MASTER_BASE(m) + off);
+}
+
+static u32 sun60i_mread(struct sun60i_iommu *iommu, unsigned int m, u32 off)
+{
+	return readl(iommu->base + SUN60I_IOMMU_MASTER_BASE(m) + off);
+}
+
+/* Entries */
+
+static bool sun60i_iommu_pa_ok(phys_addr_t pa, size_t size)
+{
+	/*
+	 * The BSP driver reads an entry address below 0x40000000 (the CPU's
+	 * I/O region) as the CPU address 2^34 above it, and encodes CPU
+	 * addresses from 16 GiB up that way. The user manual does not
+	 * describe this and it has not been observed. RAM starts at
+	 * 0x40000000, so neither range is reached below 15 GiB of RAM: such
+	 * an address is refused rather than encoded on a guess.
+	 */
+	return (u64)pa >= SUN60I_PA_MIN && (u64)pa + size <= SUN60I_PA_END;
+}
+
+static u32 sun60i_mk_addr(phys_addr_t pa)
+{
+	return ((u32)pa & SUN60I_ENT_ADDR_LOW) |
+	       FIELD_PREP(SUN60I_ENT_ADDR_HIGH, (u64)pa >> 32);
+}
+
+static phys_addr_t sun60i_ent_addr(u32 ent)
+{
+	return ((phys_addr_t)FIELD_GET(SUN60I_ENT_ADDR_HIGH, ent) << 32) |
+	       (ent & SUN60I_ENT_ADDR_LOW);
+}
+
+static bool sun60i_dte_valid(u32 dte)
+{
+	return (dte & SUN60I_DTE_VALID_MASK) == SUN60I_DTE_VALID;
+}
+
+static u32 sun60i_mk_pte(phys_addr_t pa, int prot)
+{
+	u32 pte = sun60i_mk_addr(pa) | SUN60I_PTE_VALID;
+
+	if (prot & IOMMU_READ)
+		pte |= SUN60I_PTE_READABLE;
+	if (prot & IOMMU_WRITE)
+		pte |= SUN60I_PTE_WRITABLE;
+	return pte;
+}
+
+static unsigned int sun60i_l1_index(unsigned long iova)
+{
+	return (iova >> SUN60I_L1_SHIFT) & (SUN60I_L1_ENTRIES - 1);
+}
+
+static unsigned int sun60i_l2_index(unsigned long iova)
+{
+	return (iova >> SUN60I_PAGE_SHIFT) & (SUN60I_L2_ENTRIES - 1);
+}
+
+static void sun60i_table_flush(struct sun60i_iommu *iommu, void *vaddr,
+			       unsigned int n)
+{
+	dma_sync_single_for_device(iommu->dev, virt_to_phys(vaddr),
+				   n * sizeof(u32), DMA_TO_DEVICE);
+}
+
+/*
+ * Tables are DMA-mapped for their lifetime, so that the syncs above act on
+ * a mapping. The IOMMU reads a table at its physical address, so the
+ * mapping must not be a bounce buffer: probe sets a 34-bit mask, and a
+ * mapping that does not come back as the physical address is refused.
+ */
+static int sun60i_table_map(struct sun60i_iommu *iommu, void *table,
+			    size_t size)
+{
+	dma_addr_t dma = dma_map_single(iommu->dev, table, size, DMA_TO_DEVICE);
+
+	if (dma_mapping_error(iommu->dev, dma))
+		return -ENOMEM;
+	if (dma != virt_to_phys(table)) {
+		dma_unmap_single(iommu->dev, dma, size, DMA_TO_DEVICE);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static void sun60i_table_free(struct sun60i_iommu *iommu, void *table,
+			      size_t size)
+{
+	dma_unmap_single(iommu->dev, virt_to_phys(table), size, DMA_TO_DEVICE);
+	iommu_free_pages(table);
+}
+
+/* Commands */
+
+/*
+ * Set a command bit and wait for it to drop. A bit still set after the
+ * timeout is cleared and reported.
+ *
+ * TLB_FLUSH, PC_IVLD_ENABLE and the per-master TLB_FLUSH drop by the first
+ * read, a few microseconds after the write, whatever the video engine
+ * does. TLB_IVLD_ENABLE does not: its bit waits for the video engine's
+ * memory port and stays set while that port's bus clock gate is closed, as
+ * it is while the video engine is idle (the decoder's port for IOMMU1, the
+ * encoder's for IOMMU0, whether or not the instance is enabled), although
+ * the invalidation itself takes effect. The driver does not issue it (see
+ * sun60i_iommu_invalidate()). Whether a bit that drops means that the
+ * operation has completed is not documented.
+ */
+static void sun60i_iommu_cmd(struct sun60i_iommu *iommu, u32 off, u32 bits)
+{
+	u32 val;
+	int ret;
+
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_write(iommu, off, bits);
+	ret = readl_poll_timeout_atomic(iommu->base + off, val, !(val & bits),
+					10, SUN60I_IOMMU_CMD_TIMEOUT_US);
+	if (ret) {
+		sun60i_write(iommu, off, 0);
+		dev_err_ratelimited(iommu->dev,
+				    "command %#x at %#x timed out\n", bits, off);
+	}
+}
+
+/*
+ * Flush the macro TLB and the page table walk cache, then the micro TLB of
+ * every master that translates, in this order (see
+ * sun60i_iommu_invalidate()). A master in bypass holds no translation of
+ * this table (sun60i_iommu_master_translate() flushes it before it
+ * translates), and its block is not touched. A master with a user has its
+ * port gate held (see sun60i_iommu_master_translate()), so every block this
+ * touches answers.
+ */
+static void sun60i_iommu_flush_all(struct sun60i_iommu *iommu)
+{
+	unsigned int m;
+
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_iommu_cmd(iommu, SUN60I_IOMMU_TLB_FLUSH_REG,
+			 SUN60I_IOMMU_TLB_FLUSH_ALL);
+	for (m = 0; m < SUN60I_IOMMU_MAX_MASTERS; m++)
+		if (iommu->users[m])
+			sun60i_iommu_cmd(iommu, SUN60I_IOMMU_MASTER_BASE(m) +
+					 SUN60I_IOMMU_M_TLB_FLUSH, BIT(0));
+}
+
+/*
+ * Invalidate [first, last], both inclusive IOVAs, by flushing: the macro
+ * TLB and the page table walk cache first, then the micro TLB of every
+ * master that translates. The order matters. A stale entry that a master
+ * also held in its micro TLB survived the global flush alone, the
+ * per-master flush alone and the per-master flush followed by the global
+ * one; it was gone only after the global flush followed by the per-master
+ * one.
+ *
+ * The range command (TLB_IVLD_ENABLE over TLB_IVLD_START/END) is not used.
+ * It takes effect, but its done bit does not drop while the video engine is
+ * idle (see sun60i_iommu_cmd()), so its completion cannot be waited for. A
+ * flush costs page table walks after every sync, not correctness.
+ */
+static void sun60i_iommu_invalidate(struct sun60i_iommu *iommu,
+				    unsigned long first, unsigned long last)
+{
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_iommu_flush_all(iommu);
+}
+
+/* Enable / disable */
+
+static void sun60i_iommu_hw_enable(struct sun60i_iommu *iommu,
+				   struct sun60i_iommu_domain *dom)
+{
+	phys_addr_t l1 = virt_to_phys(dom->l1);
+
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_write(iommu, SUN60I_IOMMU_TTB_REG, l1 >> SUN60I_IOMMU_TTB_SHIFT);
+	sun60i_write(iommu, SUN60I_IOMMU_TLB_PREFETCH_REG, 0);
+	sun60i_write(iommu, SUN60I_IOMMU_TLB_IVLD_MODE_REG, 1);
+	sun60i_write(iommu, SUN60I_IOMMU_PC_IVLD_MODE_REG, 1);
+	sun60i_write(iommu, SUN60I_IOMMU_INT_ENABLE_REG,
+		     SUN60I_IOMMU_INT_L1_EN | SUN60I_IOMMU_INT_L2_EN);
+	sun60i_iommu_flush_all(iommu);
+	sun60i_write(iommu, SUN60I_IOMMU_ENABLE_REG, SUN60I_IOMMU_ENABLE);
+
+	dev_dbg(iommu->dev, "translating: L1 table at %pa\n", &l1);
+}
+
+/* Back to the reset state: no table, every master in bypass. */
+static void sun60i_iommu_hw_disable(struct sun60i_iommu *iommu)
+{
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_write(iommu, SUN60I_IOMMU_ENABLE_REG, 0);
+	sun60i_write(iommu, SUN60I_IOMMU_INT_ENABLE_REG, 0);
+	sun60i_write(iommu, SUN60I_IOMMU_TTB_REG, 0);
+	sun60i_iommu_flush_all(iommu);
+
+	dev_dbg(iommu->dev, "no master translating, disabled\n");
+}
+
+/*
+ * Program master @m's block to translate: interrupts on, micro TLB flushed,
+ * bypass off. Its port gate must be held.
+ */
+static void sun60i_iommu_master_program(struct sun60i_iommu *iommu,
+					unsigned int m)
+{
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_mwrite(iommu, m, SUN60I_IOMMU_M_INT_ENABLE, 1);
+	sun60i_iommu_cmd(iommu, SUN60I_IOMMU_MASTER_BASE(m) +
+			 SUN60I_IOMMU_M_TLB_FLUSH, BIT(0));
+	sun60i_mwrite(iommu, m, SUN60I_IOMMU_M_BYP, 0);
+}
+
+/*
+ * The first user of master @m: take its port gate, then program its block.
+ * The gate stays enabled until sun60i_iommu_master_bypass(), so the block is
+ * never gated while it holds this driver's state -- whether it would keep
+ * that state across a gated port has not been measured.
+ */
+static int sun60i_iommu_master_translate(struct sun60i_iommu *iommu,
+					 unsigned int m)
+{
+	int ret;
+
+	lockdep_assert_held(&iommu->lock);
+
+	ret = clk_enable(iommu->master_clk[m]);
+	if (ret) {
+		dev_err(iommu->dev, "master %u: port clock: %d\n", m, ret);
+		return ret;
+	}
+
+	sun60i_iommu_master_program(iommu, m);
+
+	dev_dbg(iommu->dev, "master %u translating\n", m);
+	return 0;
+}
+
+static void sun60i_iommu_master_bypass(struct sun60i_iommu *iommu,
+				       unsigned int m)
+{
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_mwrite(iommu, m, SUN60I_IOMMU_M_BYP, 1);
+	sun60i_mwrite(iommu, m, SUN60I_IOMMU_M_INT_ENABLE, 0);
+	/* Last block access of this master: its port may be gated again. */
+	clk_disable(iommu->master_clk[m]);
+
+	dev_dbg(iommu->dev, "master %u in bypass\n", m);
+}
+
+/* The masters that have a user, i.e. whose port gate this driver holds. */
+static u32 sun60i_iommu_user_mask(struct sun60i_iommu *iommu)
+{
+	unsigned int m;
+	u32 mask = 0;
+
+	for (m = 0; m < SUN60I_IOMMU_MAX_MASTERS; m++)
+		if (iommu->users[m])
+			mask |= BIT(m);
+	return mask;
+}
+
+static bool sun60i_iommu_any_user(struct sun60i_iommu *iommu)
+{
+	unsigned int m;
+
+	for (m = 0; m < SUN60I_IOMMU_MAX_MASTERS; m++)
+		if (iommu->users[m])
+			return true;
+	return false;
+}
+
+/* Domain ops */
+
+static u32 *sun60i_iommu_get_l2(struct sun60i_iommu_domain *dom,
+				unsigned long iova, gfp_t gfp)
+{
+	struct sun60i_iommu *iommu = dom->iommu;
+	u32 *dte = &dom->l1[sun60i_l1_index(iova)];
+	phys_addr_t pa;
+	u32 *l2, old, new;
+	int ret;
+
+	if (sun60i_dte_valid(*dte))
+		return phys_to_virt(sun60i_ent_addr(*dte));
+
+	l2 = iommu_alloc_pages_sz(gfp, SUN60I_L2_SIZE);
+	if (!l2)
+		return ERR_PTR(-ENOMEM);
+
+	pa = virt_to_phys(l2);
+	if (!sun60i_iommu_pa_ok(pa, SUN60I_L2_SIZE)) {
+		iommu_free_pages(l2);
+		return ERR_PTR(-EINVAL);
+	}
+	ret = sun60i_table_map(iommu, l2, SUN60I_L2_SIZE);
+	if (ret) {
+		iommu_free_pages(l2);
+		return ERR_PTR(ret);
+	}
+
+	new = sun60i_mk_addr(pa) | SUN60I_DTE_VALID;
+	old = cmpxchg(dte, 0, new);
+	if (old) {
+		/* Lost a race: somebody installed a table for this 4 MiB. */
+		sun60i_table_free(iommu, l2, SUN60I_L2_SIZE);
+		return phys_to_virt(sun60i_ent_addr(old));
+	}
+	sun60i_table_flush(iommu, dte, 1);
+
+	return l2;
+}
+
+static int sun60i_iommu_map_pages(struct iommu_domain *domain,
+				  unsigned long iova, phys_addr_t paddr,
+				  size_t pgsize, size_t pgcount, int prot,
+				  gfp_t gfp, size_t *mapped)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	size_t i;
+
+	if (!sun60i_iommu_pa_ok(paddr, pgsize * pgcount)) {
+		dev_warn_ratelimited(dom->iommu->dev,
+				     "refusing to map %pa (+%zu pages): outside [0x40000000, 16 GiB)\n",
+				     &paddr, pgcount);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < pgcount; i++) {
+		unsigned long va = iova + i * pgsize;
+		phys_addr_t pa = paddr + i * pgsize;
+		u32 *l2, *pte;
+
+		l2 = sun60i_iommu_get_l2(dom, va, gfp);
+		if (IS_ERR(l2))
+			return PTR_ERR(l2);
+
+		pte = &l2[sun60i_l2_index(va)];
+		if (*pte & SUN60I_PTE_VALID) {
+			phys_addr_t old = sun60i_ent_addr(*pte);
+
+			dev_err(dom->iommu->dev,
+				"iova %#lx already maps %pa, refusing %pa\n",
+				va, &old, &pa);
+			return -EBUSY;
+		}
+		*pte = sun60i_mk_pte(pa, prot);
+		sun60i_table_flush(dom->iommu, pte, 1);
+		*mapped += pgsize;
+	}
+
+	return 0;
+}
+
+static size_t sun60i_iommu_unmap_pages(struct iommu_domain *domain,
+				       unsigned long iova, size_t pgsize,
+				       size_t pgcount,
+				       struct iommu_iotlb_gather *gather)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	size_t unmapped = 0;
+	size_t i;
+
+	for (i = 0; i < pgcount; i++) {
+		unsigned long va = iova + i * pgsize;
+		u32 dte = dom->l1[sun60i_l1_index(va)];
+		u32 *pte;
+
+		if (!sun60i_dte_valid(dte))
+			break;
+		pte = (u32 *)phys_to_virt(sun60i_ent_addr(dte)) +
+		      sun60i_l2_index(va);
+		if (!(*pte & SUN60I_PTE_VALID))
+			break;
+		/*
+		 * Cleared here, invalidated in iotlb_sync: the other order
+		 * lets a walk in between cache the entry again. L2 tables are
+		 * kept until the domain is freed, so no walk can reach a
+		 * freed table.
+		 */
+		*pte = 0;
+		sun60i_table_flush(dom->iommu, pte, 1);
+		unmapped += pgsize;
+	}
+
+	if (unmapped)
+		iommu_iotlb_gather_add_range(gather, iova, unmapped);
+
+	return unmapped;
+}
+
+static int sun60i_iommu_iotlb_sync_map(struct iommu_domain *domain,
+				       unsigned long iova, size_t size)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	struct sun60i_iommu *iommu = dom->iommu;
+	unsigned long flags;
+
+	if (!size)
+		return 0;
+
+	/* A walk may have cached this range while it was still invalid. */
+	spin_lock_irqsave(&iommu->lock, flags);
+	if (iommu->domain == dom)
+		sun60i_iommu_invalidate(iommu, iova, iova + size - 1);
+	spin_unlock_irqrestore(&iommu->lock, flags);
+
+	return 0;
+}
+
+static void sun60i_iommu_iotlb_sync(struct iommu_domain *domain,
+				    struct iommu_iotlb_gather *gather)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	struct sun60i_iommu *iommu = dom->iommu;
+	unsigned long flags;
+
+	if (gather->start > gather->end)
+		return;
+
+	spin_lock_irqsave(&iommu->lock, flags);
+	if (iommu->domain == dom)
+		sun60i_iommu_invalidate(iommu, gather->start, gather->end);
+	spin_unlock_irqrestore(&iommu->lock, flags);
+}
+
+static void sun60i_iommu_flush_iotlb_all(struct iommu_domain *domain)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	struct sun60i_iommu *iommu = dom->iommu;
+	unsigned long flags;
+
+	spin_lock_irqsave(&iommu->lock, flags);
+	if (iommu->domain == dom)
+		sun60i_iommu_flush_all(iommu);
+	spin_unlock_irqrestore(&iommu->lock, flags);
+}
+
+static phys_addr_t sun60i_iommu_iova_to_phys(struct iommu_domain *domain,
+					     dma_addr_t iova)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	u32 dte, pte;
+
+	dte = dom->l1[sun60i_l1_index(iova)];
+	if (!sun60i_dte_valid(dte))
+		return 0;
+	pte = ((u32 *)phys_to_virt(sun60i_ent_addr(dte)))[sun60i_l2_index(iova)];
+	if (!(pte & SUN60I_PTE_VALID))
+		return 0;
+	return sun60i_ent_addr(pte) + (iova & (SUN60I_PAGE_SIZE - 1));
+}
+
+static void sun60i_iommu_domain_free(struct iommu_domain *domain)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	unsigned int i;
+
+	for (i = 0; i < SUN60I_L1_ENTRIES; i++) {
+		u32 dte = dom->l1[i];
+
+		if (sun60i_dte_valid(dte))
+			sun60i_table_free(dom->iommu,
+					  phys_to_virt(sun60i_ent_addr(dte)),
+					  SUN60I_L2_SIZE);
+	}
+	sun60i_table_free(dom->iommu, dom->l1, SUN60I_L1_SIZE);
+	kfree(dom);
+}
+
+static struct iommu_domain *sun60i_iommu_domain_alloc_paging(struct device *dev)
+{
+	struct sun60i_iommu_client *client = dev_iommu_priv_get(dev);
+	struct sun60i_iommu_domain *dom;
+	phys_addr_t pa;
+
+	dom = kzalloc_obj(*dom, GFP_KERNEL);
+	if (!dom)
+		return NULL;
+
+	/*
+	 * An order-2 block from the page allocator starts on a 16 KiB
+	 * physical boundary, which TTB = pa >> 14 requires. No GFP_DMA32:
+	 * this IOMMU walks tables above 4 GiB.
+	 */
+	dom->l1 = iommu_alloc_pages_sz(GFP_KERNEL, SUN60I_L1_SIZE);
+	if (!dom->l1)
+		goto err_free;
+
+	pa = virt_to_phys(dom->l1);
+	if ((pa & (SUN60I_L1_SIZE - 1)) ||
+	    !sun60i_iommu_pa_ok(pa, SUN60I_L1_SIZE)) {
+		dev_err(client->iommu->dev,
+			"L1 table at %pa cannot be put in TTB\n", &pa);
+		goto err_free_l1;
+	}
+	if (sun60i_table_map(client->iommu, dom->l1, SUN60I_L1_SIZE))
+		goto err_free_l1;
+	dom->iommu = client->iommu;
+
+	dom->domain.pgsize_bitmap = SUN60I_PAGE_SIZE;
+	dom->domain.geometry.aperture_start = 0;
+	dom->domain.geometry.aperture_end = SUN60I_PA_END - 1;
+	dom->domain.geometry.force_aperture = true;
+
+	return &dom->domain;
+
+err_free_l1:
+	iommu_free_pages(dom->l1);
+err_free:
+	kfree(dom);
+	return NULL;
+}
+
+static int sun60i_iommu_attach_paging(struct iommu_domain *domain,
+				      struct device *dev,
+				      struct iommu_domain *old)
+{
+	struct sun60i_iommu_domain *dom = to_sun60i_domain(domain);
+	struct sun60i_iommu_client *client = dev_iommu_priv_get(dev);
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	struct sun60i_iommu *iommu = client->iommu;
+	unsigned long flags;
+	unsigned int i;
+	int ret = 0;
+
+	spin_lock_irqsave(&iommu->lock, flags);
+
+	if (dom->iommu != iommu) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/*
+	 * No master block is read here: attach runs from dma_configure, before
+	 * the consumer's probe, with the MBUS port in whatever state it was
+	 * left, and a gated port stalls the bus on the first access. The block
+	 * is touched only in sun60i_iommu_master_translate(), gate held.
+	 * of_xlate() bounds the ids to the 15 master slots of the user manual;
+	 * a slot without a master reads 0 and ignores writes.
+	 */
+
+	if (iommu->domain != dom) {
+		if (iommu->domain) {
+			/* Switching tables under translating masters. */
+			sun60i_write(iommu, SUN60I_IOMMU_TTB_REG,
+				     virt_to_phys(dom->l1) >>
+				     SUN60I_IOMMU_TTB_SHIFT);
+			sun60i_iommu_flush_all(iommu);
+		} else {
+			sun60i_iommu_hw_enable(iommu, dom);
+		}
+		iommu->domain = dom;
+	}
+
+	if (!client->translating) {
+		for (i = 0; i < fwspec->num_ids; i++) {
+			unsigned int m = fwspec->ids[i];
+
+			if (!iommu->users[m]) {
+				ret = sun60i_iommu_master_translate(iommu, m);
+				if (ret)
+					goto undo;
+			}
+			iommu->users[m]++;
+		}
+		client->translating = true;
+	}
+	goto out;
+
+undo:
+	/* Put back the masters this attach switched on, in reverse. */
+	while (i--) {
+		unsigned int m = fwspec->ids[i];
+
+		if (--iommu->users[m] == 0)
+			sun60i_iommu_master_bypass(iommu, m);
+	}
+	if (!sun60i_iommu_any_user(iommu)) {
+		sun60i_iommu_hw_disable(iommu);
+		iommu->domain = NULL;
+	}
+out:
+	spin_unlock_irqrestore(&iommu->lock, flags);
+	return ret;
+}
+
+static void sun60i_iommu_client_bypass(struct device *dev)
+{
+	struct sun60i_iommu_client *client = dev_iommu_priv_get(dev);
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	struct sun60i_iommu *iommu = client->iommu;
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&iommu->lock, flags);
+
+	if (client->translating) {
+		for (i = 0; i < fwspec->num_ids; i++)
+			if (--iommu->users[fwspec->ids[i]] == 0)
+				sun60i_iommu_master_bypass(iommu,
+							   fwspec->ids[i]);
+		client->translating = false;
+	}
+
+	if (iommu->domain && !sun60i_iommu_any_user(iommu)) {
+		sun60i_iommu_hw_disable(iommu);
+		iommu->domain = NULL;
+	}
+
+	spin_unlock_irqrestore(&iommu->lock, flags);
+}
+
+static int sun60i_iommu_attach_identity(struct iommu_domain *domain,
+					struct device *dev,
+					struct iommu_domain *old)
+{
+	sun60i_iommu_client_bypass(dev);
+	return 0;
+}
+
+static const struct iommu_domain_ops sun60i_iommu_identity_ops = {
+	.attach_dev = sun60i_iommu_attach_identity,
+};
+
+/* Bypass is the reset state of every master. */
+static struct iommu_domain sun60i_iommu_identity_domain = {
+	.type = IOMMU_DOMAIN_IDENTITY,
+	.ops = &sun60i_iommu_identity_ops,
+};
+
+static struct iommu_device *sun60i_iommu_probe_device(struct device *dev)
+{
+	struct sun60i_iommu_client *client = dev_iommu_priv_get(dev);
+
+	if (!client)
+		return ERR_PTR(-ENODEV);
+
+	return &client->iommu->iommu;
+}
+
+static void sun60i_iommu_release_device(struct device *dev)
+{
+	struct sun60i_iommu_client *client = dev_iommu_priv_get(dev);
+
+	if (!client)
+		return;
+	sun60i_iommu_client_bypass(dev);
+	dev_iommu_priv_set(dev, NULL);
+	kfree(client);
+}
+
+static int sun60i_iommu_of_xlate(struct device *dev,
+				 const struct of_phandle_args *args)
+{
+	struct sun60i_iommu_client *client = dev_iommu_priv_get(dev);
+	struct platform_device *pdev;
+	struct sun60i_iommu *iommu;
+	u32 id;
+
+	if (args->args_count != 1 ||
+	    args->args[0] >= SUN60I_IOMMU_MAX_MASTERS)
+		return -EINVAL;
+	id = args->args[0];
+
+	pdev = of_find_device_by_node(args->np);
+	if (!pdev)
+		return -ENODEV;
+	iommu = platform_get_drvdata(pdev);
+	put_device(&pdev->dev);
+	if (!iommu)
+		return -EPROBE_DEFER;
+
+	if (!client) {
+		client = kzalloc_obj(*client, GFP_KERNEL);
+		if (!client)
+			return -ENOMEM;
+		client->iommu = iommu;
+		dev_iommu_priv_set(dev, client);
+	} else if (client->iommu != iommu) {
+		/* Masters on both IOMMUs would need two tables per domain. */
+		dev_err(dev, "masters on both IOMMUs are not supported\n");
+		return -EINVAL;
+	}
+
+	return iommu_fwspec_add_ids(dev, &id, 1);
+}
+
+static const struct iommu_ops sun60i_iommu_ops = {
+	.identity_domain	= &sun60i_iommu_identity_domain,
+	.domain_alloc_paging	= sun60i_iommu_domain_alloc_paging,
+	.probe_device		= sun60i_iommu_probe_device,
+	.release_device		= sun60i_iommu_release_device,
+	/* One TTB per IOMMU: all devices behind it share a group and a table. */
+	.device_group		= generic_single_device_group,
+	.of_xlate		= sun60i_iommu_of_xlate,
+	.default_domain_ops = &(const struct iommu_domain_ops) {
+		.attach_dev		= sun60i_iommu_attach_paging,
+		.map_pages		= sun60i_iommu_map_pages,
+		.unmap_pages		= sun60i_iommu_unmap_pages,
+		.iotlb_sync_map		= sun60i_iommu_iotlb_sync_map,
+		.iotlb_sync		= sun60i_iommu_iotlb_sync,
+		.flush_iotlb_all	= sun60i_iommu_flush_iotlb_all,
+		.iova_to_phys		= sun60i_iommu_iova_to_phys,
+		.free			= sun60i_iommu_domain_free,
+	},
+};
+
+/* Faults */
+
+/*
+ * Reset the masters in @mask, as sun50i-iommu does after a fault, and put
+ * back what this driver set in their blocks: what a master reset clears is
+ * not documented.
+ */
+static void sun60i_iommu_reset_masters(struct sun60i_iommu *iommu, u32 mask)
+{
+	u32 saved = sun60i_read(iommu, SUN60I_IOMMU_RESET_REG);
+	unsigned long m, bits = mask;
+
+	lockdep_assert_held(&iommu->lock);
+
+	sun60i_write(iommu, SUN60I_IOMMU_RESET_REG, saved & ~mask);
+	sun60i_write(iommu, SUN60I_IOMMU_RESET_REG, saved);
+	for_each_set_bit(m, &bits, SUN60I_IOMMU_MAX_MASTERS) {
+		sun60i_mwrite(iommu, m, SUN60I_IOMMU_M_INT_ENABLE,
+			      iommu->users[m] ? 1 : 0);
+		sun60i_mwrite(iommu, m, SUN60I_IOMMU_M_BYP,
+			      iommu->users[m] ? 0 : 1);
+	}
+}
+
+static void sun60i_iommu_report(struct sun60i_iommu *iommu, const char *what,
+				u32 masters, u64 iova, u32 data)
+{
+	dev_err_ratelimited(iommu->dev,
+			    "%s fault: iova %#llx, masters %#x, data %#x\n",
+			    what, iova, masters, data);
+	/* The access direction is not decoded: the data format is unknown. */
+	if (iommu->domain)
+		report_iommu_fault(&iommu->domain->domain, iommu->dev, iova,
+				   IOMMU_FAULT_READ);
+	sun60i_iommu_invalidate(iommu, iova, iova);
+}
+
+static irqreturn_t sun60i_iommu_irq(int irq, void *dev_id)
+{
+	struct sun60i_iommu *iommu = dev_id;
+	unsigned long m, bits;
+	u32 sta, l1, l2, masters, reset, clr, users;
+
+	spin_lock(&iommu->lock);
+
+	sta = sun60i_read(iommu, SUN60I_IOMMU_INT_STA_REG);
+	l1 = sun60i_read(iommu, SUN60I_IOMMU_L1PG_INT_REG);
+	l2 = sun60i_read(iommu, SUN60I_IOMMU_L2PG_INT_REG);
+	sta &= SUN60I_IOMMU_INT_STA_MASTER | SUN60I_IOMMU_INT_STA_L1 |
+	       SUN60I_IOMMU_INT_STA_L2;
+	if (!sta) {
+		spin_unlock(&iommu->lock);
+		return IRQ_NONE;
+	}
+
+	/*
+	 * Only masters with a user have their port gate held; the block of any
+	 * other master may not answer. A master without a user runs in bypass
+	 * and has its fault interrupt off, so its bit here would be stale.
+	 */
+	users = sun60i_iommu_user_mask(iommu);
+	masters = sta & SUN60I_IOMMU_INT_STA_MASTER & users;
+	bits = masters;
+	for_each_set_bit(m, &bits, SUN60I_IOMMU_MAX_MASTERS) {
+		u64 iova = sun60i_mread(iommu, m, SUN60I_IOMMU_M_INT_ERR_ADDR_LO) |
+			   (u64)sun60i_mread(iommu, m,
+					     SUN60I_IOMMU_M_INT_ERR_ADDR_HI) << 32;
+
+		sun60i_iommu_report(iommu, "permission", BIT(m), iova,
+				    sun60i_mread(iommu, m,
+						 SUN60I_IOMMU_M_INT_ERR_DATA));
+		sun60i_mwrite(iommu, m, SUN60I_IOMMU_M_INT_CLR, 1);
+	}
+
+	if (sta & SUN60I_IOMMU_INT_STA_L1) {
+		u64 iova = sun60i_read(iommu, SUN60I_IOMMU_INT_ERR_ADDR_L1_LO) |
+			   (u64)sun60i_read(iommu,
+					    SUN60I_IOMMU_INT_ERR_ADDR_L1_HI) << 32;
+
+		if (l1 & SUN60I_IOMMU_PG_INT_PREFETCH)
+			sun60i_iommu_invalidate(iommu, iova, iova);
+		else
+			sun60i_iommu_report(iommu, "L1 page table", l1, iova,
+					    sun60i_read(iommu,
+							SUN60I_IOMMU_INT_ERR_DATA_L1));
+	}
+
+	if (sta & SUN60I_IOMMU_INT_STA_L2) {
+		u64 iova = sun60i_read(iommu, SUN60I_IOMMU_INT_ERR_ADDR_L2_LO) |
+			   (u64)sun60i_read(iommu,
+					    SUN60I_IOMMU_INT_ERR_ADDR_L2_HI) << 32;
+
+		if (l2 & SUN60I_IOMMU_PG_INT_PREFETCH)
+			sun60i_iommu_invalidate(iommu, iova, iova);
+		else
+			sun60i_iommu_report(iommu, "L2 page table", l2, iova,
+					    sun60i_read(iommu,
+							SUN60I_IOMMU_INT_ERR_DATA_L2));
+	}
+
+	/*
+	 * Clear and reset on every run, as sun50i-iommu does. A master that
+	 * faults continuously -- a display engine scanning an unmapped
+	 * address -- interrupts again after each reset and runs on as soon as
+	 * its address is mapped. Its status may read set again right after the
+	 * clear; switching fault interrupts off on that would leave such a
+	 * master stopped, its last fault neither cleared nor reset.
+	 */
+	clr = ((sta & SUN60I_IOMMU_INT_STA_L1) ? SUN60I_IOMMU_INT_L1_EN : 0) |
+	      ((sta & SUN60I_IOMMU_INT_STA_L2) ? SUN60I_IOMMU_INT_L2_EN : 0);
+	sun60i_write(iommu, SUN60I_IOMMU_INT_CLR_REG, clr);
+
+	/*
+	 * L1PG_INT and L2PG_INT keep the bit of a master that faulted before
+	 * (seen for L1PG_INT), so this can reset a master that did not fault
+	 * now.
+	 */
+	reset = (masters | l1 | l2) & SUN60I_IOMMU_INT_STA_MASTER & users;
+	if (reset)
+		sun60i_iommu_reset_masters(iommu, reset);
+
+	spin_unlock(&iommu->lock);
+	return IRQ_HANDLED;
+}
+
+static const char * const sun60i_iommu_clk_names[] = {
+	"mclk", "pclk", "hclk", "mbus",
+};
+
+static void sun60i_iommu_clks_off(void *data)
+{
+	clk_bulk_disable_unprepare(ARRAY_SIZE(sun60i_iommu_clk_names), data);
+}
+
+static int sun60i_iommu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_bulk_data *clks;
+	struct reset_control *rst;
+	unsigned int m;
+	struct sun60i_iommu *iommu;
+	u32 version, enable, int_enable, ttb;
+	int irq, ret;
+
+	iommu = devm_kzalloc(dev, sizeof(*iommu), GFP_KERNEL);
+	if (!iommu)
+		return -ENOMEM;
+	iommu->dev = dev;
+	spin_lock_init(&iommu->lock);
+
+	iommu->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(iommu->base))
+		return PTR_ERR(iommu->base);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	/*
+	 * The IOMMU's own clocks, on for the life of the device. Named, not
+	 * "all": the node also lists the masters' port gates, which follow
+	 * their masters (below).
+	 */
+	clks = devm_kcalloc(dev, ARRAY_SIZE(sun60i_iommu_clk_names),
+			    sizeof(*clks), GFP_KERNEL);
+	if (!clks)
+		return -ENOMEM;
+	for (m = 0; m < ARRAY_SIZE(sun60i_iommu_clk_names); m++)
+		clks[m].id = sun60i_iommu_clk_names[m];
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(sun60i_iommu_clk_names), clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(sun60i_iommu_clk_names), clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable clocks\n");
+	ret = devm_add_action_or_reset(dev, sun60i_iommu_clks_off, clks);
+	if (ret)
+		return ret;
+
+	/*
+	 * Prepared here, enabled only under the lock while the master has a
+	 * user (clk_enable() does not sleep, clk_prepare() may).
+	 */
+	for (m = 0; m < SUN60I_IOMMU_MAX_MASTERS; m++) {
+		char name[sizeof("master14")];
+
+		snprintf(name, sizeof(name), "master%u", m);
+		iommu->master_clk[m] = devm_clk_get_optional_prepared(dev, name);
+		if (IS_ERR(iommu->master_clk[m]))
+			return dev_err_probe(dev, PTR_ERR(iommu->master_clk[m]),
+					     "failed to get %s clock\n", name);
+	}
+
+	/*
+	 * The reset is only ever de-asserted: asserting it would take every
+	 * master of this IOMMU through a reset, including masters that run
+	 * in bypass without a driver of their own attached.
+	 */
+	rst = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(rst))
+		return dev_err_probe(dev, PTR_ERR(rst), "failed to get reset\n");
+	ret = reset_control_deassert(rst);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to deassert reset\n");
+
+	/* For the table mappings: tables may live anywhere in RAM. */
+	ret = dma_set_mask(dev, DMA_BIT_MASK(SUN60I_IOVA_BITS));
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set DMA mask\n");
+
+	version = sun60i_read(iommu, SUN60I_IOMMU_VERSION_REG);
+	if (version != SUN60I_IOMMU_VERSION_V16)
+		return dev_err_probe(dev, -ENODEV,
+				     "unknown version %#x\n", version);
+
+	/*
+	 * Translation is off until a master attaches. Set the global
+	 * registers to their reset state instead of taking it from the
+	 * earlier boot stages. The per-master blocks are not touched, their
+	 * port gates are off here. How a master that an earlier stage took
+	 * out of bypass behaves with ENABLE at 0 is not measured on our
+	 * boards.
+	 */
+	enable = sun60i_read(iommu, SUN60I_IOMMU_ENABLE_REG);
+	int_enable = sun60i_read(iommu, SUN60I_IOMMU_INT_ENABLE_REG);
+	ttb = sun60i_read(iommu, SUN60I_IOMMU_TTB_REG);
+	if (enable || int_enable || ttb)
+		dev_warn(dev, "left on (ENABLE %#x, INT_ENABLE %#x, TTB %#x), switching off\n",
+			 enable, int_enable, ttb);
+	sun60i_write(iommu, SUN60I_IOMMU_ENABLE_REG, 0);
+	sun60i_write(iommu, SUN60I_IOMMU_INT_ENABLE_REG, 0);
+	sun60i_write(iommu, SUN60I_IOMMU_TTB_REG, 0);
+
+	platform_set_drvdata(pdev, iommu);
+
+	ret = devm_request_irq(dev, irq, sun60i_iommu_irq, 0,
+			       dev_name(dev), iommu);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+
+	ret = iommu_device_sysfs_add(&iommu->iommu, dev, NULL, "%s",
+				     dev_name(dev));
+	if (ret)
+		return ret;
+
+	ret = iommu_device_register(&iommu->iommu, &sun60i_iommu_ops, dev);
+	if (ret) {
+		iommu_device_sysfs_remove(&iommu->iommu);
+		return ret;
+	}
+
+	dev_dbg(dev, "version %#x, ENABLE %#x, TTB %#x\n", version,
+		sun60i_read(iommu, SUN60I_IOMMU_ENABLE_REG),
+		sun60i_read(iommu, SUN60I_IOMMU_TTB_REG));
+
+	return 0;
+}
+
+/*
+ * System sleep. Nothing is saved: everything this driver writes into the
+ * block follows from its own state -- the domain's L1 table, the masters
+ * with a user -- and the tables themselves are in DRAM, which keeps its
+ * contents across a suspend. So there is no suspend callback, and resume
+ * programs the block again from that state, exactly as attach does:
+ * sun60i_iommu_hw_enable(), then each master with a user. A block that kept
+ * its state is programmed with the values it already holds.
+ *
+ * The clocks are not touched on either side. The register interface needs
+ * SYS_MCLK, and an access with it gated stalls the bus; the driver enables it
+ * at probe and never gates it, and a master's port gate stays held for as
+ * long as the master has a user, so every block written here answers.
+ *
+ * resume_early, not resume_noirq: the noirq phase is where genpd powers a
+ * gateable domain back on, and it does so from the consumer's own noirq
+ * callback. With no device link between an IOMMU and its consumers ("iommus"
+ * is an optional supplier for fw_devlink), nothing orders that before this
+ * resume. Every early callback runs after every noirq one and before any
+ * consumer's normal resume, where DMA starts again.
+ */
+static int sun60i_iommu_resume_early(struct device *dev)
+{
+	struct sun60i_iommu *iommu = dev_get_drvdata(dev);
+	bool translating;
+	unsigned long flags;
+	unsigned int m;
+	u32 enable, ttb, users;
+
+	spin_lock_irqsave(&iommu->lock, flags);
+
+	enable = sun60i_read(iommu, SUN60I_IOMMU_ENABLE_REG);
+	ttb = sun60i_read(iommu, SUN60I_IOMMU_TTB_REG);
+	translating = iommu->domain;
+	users = sun60i_iommu_user_mask(iommu);
+
+	if (translating) {
+		sun60i_iommu_hw_enable(iommu, iommu->domain);
+		for (m = 0; m < SUN60I_IOMMU_MAX_MASTERS; m++)
+			if (iommu->users[m])
+				sun60i_iommu_master_program(iommu, m);
+	}
+
+	spin_unlock_irqrestore(&iommu->lock, flags);
+
+	dev_dbg(dev, "resume: found ENABLE %#x TTB %#x; %s, masters %#x\n",
+		enable, ttb,
+		translating ? "programmed again" : "all in bypass, nothing to do",
+		users);
+
+	return 0;
+}
+
+static const struct dev_pm_ops sun60i_iommu_pm_ops = {
+	LATE_SYSTEM_SLEEP_PM_OPS(NULL, sun60i_iommu_resume_early)
+};
+
+static const struct of_device_id sun60i_iommu_of_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-iommu" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sun60i_iommu_of_match);
+
+static struct platform_driver sun60i_iommu_driver = {
+	.probe	= sun60i_iommu_probe,
+	.driver = {
+		.name			= "sun60i-a733-iommu",
+		.of_match_table		= sun60i_iommu_of_match,
+		.pm			= pm_sleep_ptr(&sun60i_iommu_pm_ops),
+		.suppress_bind_attrs	= true,
+	},
+};
+builtin_platform_driver(sun60i_iommu_driver);
+
+MODULE_DESCRIPTION("Allwinner A733 IOMMU driver");
+MODULE_LICENSE("GPL");
