index 306e14a9c4d5..03239c4d0b5c 100644
--- a/Documentation/devicetree/bindings/pwm/allwinner,sun20i-d1-pwm.yaml
+++ b/Documentation/devicetree/bindings/pwm/allwinner,sun20i-d1-pwm.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/pwm/allwinner,sun20i-d1-pwm.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Allwinner D1, T113-S3 and R329 PWM
+title: Allwinner D1, T113-S3, R329 and A733 PWM
 
 maintainers:
   - Aleksandr Shubin <privatesub2@gmail.com>
@@ -17,10 +17,14 @@ properties:
       - items:
           - const: allwinner,sun50i-r329-pwm
           - const: allwinner,sun20i-d1-pwm
+      - const: allwinner,sun60i-a733-pwm
 
