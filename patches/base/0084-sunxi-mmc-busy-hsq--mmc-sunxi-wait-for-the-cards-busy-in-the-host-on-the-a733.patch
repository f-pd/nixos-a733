From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Sun, 4 Oct 2026 14:55:06 +0200
Subject: [PATCH] mmc: sunxi: Wait for the card's busy in the host on the A733

After every write request the block layer polls the card with CMD13
until it reports ready for data, and after an R1b command such as CMD6
the core polls the card's busy itself. On the A733 each SD write costs
several CMD13 that way, and every one of them is a full command on the
bus.

The A733 controller can wait for the busy itself. With SMHC_THLD BCIG
set it raises bit 13 of SMHC_RINTSTS when the card releases DAT0 after
a write, and SMHC_STATUS CARD_BUSY reads the DAT0 level at any time.
Use both and set MMC_CAP_WAIT_WHILE_BUSY:

- A write or an R1b command completes only when the controller is done
  with it on the bus and CARD_BUSY reads idle. The busy-clear interrupt
  only says when to look, so the result does not depend on the order in
  which the done and busy-clear interrupts arrive.
- If the interrupt does not come within 10 ms, or for an R1b command, a
  delayed work reads CARD_BUSY with the core's own pacing for its CMD13
  poll. A command still busy after its busy_timeout fails with
  -ETIMEDOUT; a write still busy after 1 s completes and is left to the
  block layer's CMD13 poll and its recovery.
- A busy clear that comes without the done bit fails the write as a
  data timeout after 1 s instead of leaving it open.
- Bit 13 means a start bit error only while data is received. On a
  write and on a command without data it no longer counts as an error,
  and a stale busy clear is cleared before each command.

max_busy_timeout is 60 s, the core's erase timeout, which the discard
sizing already used while it was 0.

Not covered: the controller's own R1b busy detection and its write busy
timeout register, which this patch leaves unused.

Tested on Radxa Cubie A7S: booted on two boards; 1 GiB and 8192 x 4 KiB
direct writes to the eMMC and the SD card read back as written, a 32 MiB
discard completes on both, and no busy timeout is logged.

Assisted-by: LLM
---
 drivers/mmc/host/sunxi-mmc.c | 366 ++++++++++++++++++++++++++++++++++-
 1 file changed, 357 insertions(+), 9 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index f89c985c9a1a..cb68adde3cda 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -19,6 +19,7 @@
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
+#include <linux/ktime.h>
 #include <linux/mmc/card.h>
 #include <linux/mmc/core.h>
 #include <linux/mmc/host.h>
@@ -149,6 +150,8 @@
 #define SDXC_FIFO_RUN_ERROR		BIT(11)
 #define SDXC_HARD_WARE_LOCKED		BIT(12)
 #define SDXC_START_BIT_ERROR		BIT(13)
+/* The same bit on a write with SDXC_CARD_BCIG set: the card's busy ended */
+#define SDXC_WRITE_BUSY_CLEAR		BIT(13)
 #define SDXC_AUTO_COMMAND_DONE		BIT(14)
 #define SDXC_END_BIT_ERROR		BIT(15)
 #define SDXC_SDIO_INTERRUPT		BIT(16)
@@ -169,6 +172,7 @@
 /* card threshold control */
 #define SDXC_CARD_THLD_SIZE		GENMASK(28, 16)
 #define SDXC_CARD_WR_THLD_ENB		BIT(2)
+#define SDXC_CARD_BCIG			BIT(1)
 #define SDXC_CARD_RD_THLD_ENB		BIT(0)
 
 /* extended command */
@@ -271,6 +275,30 @@
 /* Floor of the software timeout of a data request without access time */
 #define SDXC_DATA_SW_TIMEOUT_MIN_MS	1000
 
+/*
+ * Busy wait in the host: how long a write waits for the busy-clear interrupt
+ * before the driver looks at DAT0 itself, and the pacing of that look, which
+ * is the core's own for its CMD13 poll (__mmc_poll_for_busy()).
+ */
+#define SDXC_BUSY_IRQ_GRACE_MS		10
+#define SDXC_BUSY_POLL_MIN_US		32
+#define SDXC_BUSY_POLL_MAX_US		32768
+/*
+ * How long the host holds a write whose card stays busy. The block layer
+ * polls with CMD13 after every write anyway, so a longer wait here would
+ * only delay its recovery.
+ */
+#define SDXC_WRITE_BUSY_TIMEOUT_MS	1000
+/* A write whose busy clear came without DTC or ACD fails after this */
+#define SDXC_BUSY_CLEAR_DONE_MS		1000
+/*
+ * max_busy_timeout. The wait is timed in software; the value decides which
+ * R1b commands the core leaves to the host and how large a discard it
+ * builds. This is the core's MMC_ERASE_TIMEOUT_MS, which the discard sizing
+ * used while max_busy_timeout was 0.
+ */
+#define SDXC_MAX_BUSY_TIMEOUT_MS	60000
+
 struct sunxi_mmc_clk_delay {
 	u32 output;
 	u32 sample;
@@ -323,6 +351,9 @@ struct sunxi_mmc_cfg {
 
 	/* SMHC_A12A does not reset to zero, the auto-CMD12 argument */
 	bool needs_a12a_init;
+
+	/* busy-clear interrupt (SMHC_THLD BCIG): the host waits for busy */
+	bool can_wait_busy;
 };
 
 struct sunxi_mmc_host {
@@ -356,6 +387,16 @@ struct sunxi_mmc_host {
 	struct mmc_request *manual_stop_mrq;
 	int		ferror;
 
+	/* busy wait in the host, see sunxi_mmc_start_busy_wait() */
+	bool		busy_wait;
+	bool		busy_clear_first;
+	u32		busy_seq;
+	unsigned long	busy_deadline;
+	ktime_t		busy_start;
+	struct delayed_work busy_work;
+	u32		done_seq;
+	struct delayed_work done_work;
+
 	/* software timeout of a data request, see sunxi_mmc_data_work() */
 	u32		req_seq;
 	u32		data_seq;
@@ -519,6 +560,27 @@ static void sunxi_mmc_start_dma(struct sunxi_mmc_host *host,
 		   SDXC_IDMAC_FIX_BURST | SDXC_IDMAC_IDMA_ON);
 }
 
+/*
+ * Bit 13 is a start bit error only while data is received. On a write with
+ * the busy-clear interrupt armed it is the end of the card's busy, and on a
+ * command without data it can only be a busy clear that came in after the
+ * write before it.
+ *
+ * SMHC_WR_BUSY_TMOUT stays at its reset value; the busy wait is bounded in
+ * software. DATA_WR_BUSY_TO_INT (bit 18) is not treated as an error: its
+ * meaning is not documented, and it was seen set on a busy phase that
+ * completed normally.
+ */
+static u32 sunxi_mmc_error_bits(struct sunxi_mmc_host *host,
+				struct mmc_request *mrq)
+{
+	if (host->cfg->can_wait_busy &&
+	    (!mrq->data || (mrq->data->flags & MMC_DATA_WRITE)))
+		return SDXC_INTERRUPT_ERROR_BIT & ~SDXC_WRITE_BUSY_CLEAR;
+
+	return SDXC_INTERRUPT_ERROR_BIT;
+}
+
 /* Returns true when the controller reports the stop command as done. */
 static bool sunxi_mmc_send_manual_stop(struct sunxi_mmc_host *host,
 				       struct mmc_request *req)
@@ -538,6 +600,10 @@ static bool sunxi_mmc_send_manual_stop(struct sunxi_mmc_host *host,
 		arg = 0;
 	}
 
+	/* A busy clear of the failed write is no error of this command */
+	if (host->cfg->can_wait_busy)
+		mmc_writel(host, REG_RINTR, SDXC_WRITE_BUSY_CLEAR);
+
 	mmc_writel(host, REG_CARG, arg);
 	mmc_writel(host, REG_CMDR, cmd_val);
 
@@ -586,7 +652,8 @@ static void sunxi_mmc_dump_errinfo(struct sunxi_mmc_host *host)
 		host->int_sum & SDXC_DATA_TIMEOUT ? " DTO"    : "",
 		host->int_sum & SDXC_FIFO_RUN_ERROR  ? " FE"     : "",
 		host->int_sum & SDXC_HARD_WARE_LOCKED ? " HL"     : "",
-		host->int_sum & SDXC_START_BIT_ERROR ? " SBE"    : "",
+		host->int_sum & SDXC_START_BIT_ERROR &
+			sunxi_mmc_error_bits(host, host->mrq) ? " SBE" : "",
 		host->int_sum & SDXC_END_BIT_ERROR   ? " EBE"    : ""
 		);
 }
@@ -606,7 +673,7 @@ static bool sunxi_mmc_needs_manual_stop(struct mmc_request *mrq)
 	return mrq->data->blocks > 1;
 }
 
-/* Called in interrupt context! */
+/* Called in interrupt context, or from a work under host->lock */
 static irqreturn_t sunxi_mmc_finalize_request(struct sunxi_mmc_host *host)
 {
 	struct mmc_request *mrq = host->mrq;
@@ -617,7 +684,8 @@ static irqreturn_t sunxi_mmc_finalize_request(struct sunxi_mmc_host *host)
 	mmc_writel(host, REG_IDIE, 0);
 	cancel_delayed_work(&host->data_work);
 
-	if ((host->int_sum & SDXC_INTERRUPT_ERROR_BIT) || host->idma_err) {
+	if ((host->int_sum & sunxi_mmc_error_bits(host, mrq)) ||
+	    host->idma_err) {
 		sunxi_mmc_dump_errinfo(host);
 		mrq->cmd->error = -ETIMEDOUT;
 
@@ -647,6 +715,12 @@ static irqreturn_t sunxi_mmc_finalize_request(struct sunxi_mmc_host *host)
 	}
 
 	if (data) {
+		/* Disarm the busy-clear interrupt with its request */
+		if (host->cfg->can_wait_busy) {
+			rval = mmc_readl(host, REG_THLD);
+			mmc_writel(host, REG_THLD, rval & ~SDXC_CARD_BCIG);
+		}
+
 		mmc_writel(host, REG_IDST, 0x337);
 		mmc_writel(host, REG_DMAC, 0);
 		rval = mmc_readl(host, REG_GCTRL);
@@ -662,6 +736,14 @@ static irqreturn_t sunxi_mmc_finalize_request(struct sunxi_mmc_host *host)
 
 	mmc_writel(host, REG_RINTR, 0xffff);
 
+	/* A running busy_work rechecks busy_wait under the lock */
+	if (host->busy_wait) {
+		host->busy_wait = false;
+		cancel_delayed_work(&host->busy_work);
+	}
+	if (host->cfg->can_wait_busy)
+		cancel_delayed_work(&host->done_work);
+
 	host->mrq = NULL;
 	host->int_sum = 0;
 	host->idma_err = 0;
@@ -670,12 +752,227 @@ static irqreturn_t sunxi_mmc_finalize_request(struct sunxi_mmc_host *host)
 	return host->manual_stop_mrq ? IRQ_WAKE_THREAD : IRQ_HANDLED;
 }
 
+/*
+ * Busy wait in the host, which is what MMC_CAP_WAIT_WHILE_BUSY promises the
+ * core: a write or an R1b command completes only when the controller is
+ * done with it on the bus and the card has released DAT0 (SMHC_STATUS
+ * CARD_BUSY). For a write, the busy-clear interrupt (SMHC_THLD BCIG, raised
+ * as bit 13 of SMHC_RINTSTS) says when to look; the completion condition
+ * stays the DAT0 level, so it holds whatever order the controller raises
+ * the done and the busy-clear interrupts in.
+ */
+static bool sunxi_mmc_wants_busy_wait(struct sunxi_mmc_host *host,
+				      struct mmc_request *mrq)
+{
+	if (!host->cfg->can_wait_busy)
+		return false;
+
+	if (mrq->data)
+		return mrq->data->flags & MMC_DATA_WRITE;
+
+	return mrq->cmd->flags & MMC_RSP_BUSY;
+}
+
+/*
+ * The request is done on the bus and DAT0 is still busy: keep it open. A
+ * write waits for its busy-clear interrupt and gets a grace period before
+ * busy_work looks at DAT0; an R1b command, and a write whose busy clear came
+ * before the done bit, have no interrupt left to wait for.
+ */
+static void sunxi_mmc_start_busy_wait(struct sunxi_mmc_host *host)
+{
+	struct mmc_request *mrq = host->mrq;
+	unsigned int timeout_ms = host->mmc->max_busy_timeout;
+	unsigned long delay = 0;
+
+	if (mrq->data)
+		timeout_ms = SDXC_WRITE_BUSY_TIMEOUT_MS;
+	else if (mrq->cmd->busy_timeout)
+		timeout_ms = mrq->cmd->busy_timeout;
+
+	host->busy_clear_first = host->int_sum & SDXC_WRITE_BUSY_CLEAR;
+	if (mrq->data && !host->busy_clear_first)
+		delay = msecs_to_jiffies(SDXC_BUSY_IRQ_GRACE_MS);
+
+	host->busy_wait = true;
+	host->busy_seq++;
+	host->busy_start = ktime_get();
+	host->busy_deadline = jiffies + msecs_to_jiffies(timeout_ms) + 1;
+
+	mod_delayed_work(system_dfl_long_wq, &host->busy_work, delay);
+}
+
+/*
+ * End a busy wait, with DAT0 idle or with the deadline passed. A command
+ * that is still busy fails with -ETIMEDOUT, as the capability requires. A
+ * write completes without an error: the block layer polls the card with
+ * CMD13 after it and starts its recovery from there. Called with host->lock
+ * held; the caller completes the request after dropping it.
+ */
+static struct mmc_request *sunxi_mmc_end_busy_wait(struct sunxi_mmc_host *host,
+						   bool still_busy,
+						   const char *how)
+{
+	struct mmc_request *mrq = host->mrq;
+	s64 us = ktime_us_delta(ktime_get(), host->busy_start);
+
+	if (still_busy) {
+		if (mrq->data)
+			dev_warn(mmc_dev(host->mmc),
+				 "write: card still busy after %lld us, left to the core's status poll\n",
+				 us);
+		else
+			dev_err(mmc_dev(host->mmc),
+				"cmd %d: card still busy after %lld us (busy_timeout %u ms)\n",
+				mrq->cmd->opcode, us, mrq->cmd->busy_timeout);
+	} else {
+		dev_dbg(mmc_dev(host->mmc),
+			"cmd %d%s: busy end by %s after %lld us%s\n",
+			mrq->cmd->opcode, mrq->data ? " WR" : "", how, us,
+			host->busy_clear_first ? " (busy clear before done)" : "");
+	}
+
+	sunxi_mmc_finalize_request(host);
+
+	if (still_busy && !mrq->data)
+		mrq->cmd->error = -ETIMEDOUT;
+
+	return mrq;
+}
+
+static irqreturn_t sunxi_mmc_handle_manual_stop(int irq, void *dev_id);
+
+/* Complete a request that was finalized outside the hard interrupt */
+static void sunxi_mmc_complete_deferred(struct sunxi_mmc_host *host,
+					struct mmc_request *mrq,
+					irqreturn_t ret)
+{
+	if (ret == IRQ_WAKE_THREAD)
+		sunxi_mmc_handle_manual_stop(host->irq, host);
+	else
+		mmc_request_done(host->mmc, mrq);
+}
+
+/*
+ * Look at DAT0 until it is idle or the deadline passes: after the grace
+ * period when a write's busy-clear interrupt has not come, when it came and
+ * DAT0 still read busy, and for every R1b command.
+ */
+static void sunxi_mmc_busy_work(struct work_struct *work)
+{
+	struct sunxi_mmc_host *host = container_of(to_delayed_work(work),
+						   struct sunxi_mmc_host,
+						   busy_work);
+	unsigned int period_us = SDXC_BUSY_POLL_MIN_US;
+	struct mmc_request *mrq;
+	unsigned long iflags;
+	irqreturn_t ret;
+	bool busy, expired;
+	u32 seq;
+
+	spin_lock_irqsave(&host->lock, iflags);
+	if (!host->busy_wait) {
+		spin_unlock_irqrestore(&host->lock, iflags);
+		return;
+	}
+	seq = host->busy_seq;
+
+	for (;;) {
+		/* Deadline first, as the core does: a sleep may overrun it */
+		expired = time_after(jiffies, host->busy_deadline);
+		busy = mmc_readl(host, REG_STAS) & SDXC_CARD_DATA_BUSY;
+		if (!busy || expired)
+			break;
+
+		spin_unlock_irqrestore(&host->lock, iflags);
+		usleep_range(period_us, period_us * 2);
+		if (period_us < SDXC_BUSY_POLL_MAX_US)
+			period_us *= 2;
+		spin_lock_irqsave(&host->lock, iflags);
+
+		/* The interrupt handler may have finished it meanwhile */
+		if (!host->busy_wait || host->busy_seq != seq) {
+			spin_unlock_irqrestore(&host->lock, iflags);
+			return;
+		}
+	}
+
+	mrq = host->mrq;
+
+	/*
+	 * An error may be latched with its interrupt still waiting for the
+	 * lock. Collect it before the RINTSTS clear of the finalize can wipe
+	 * it, and let it win.
+	 */
+	host->int_sum |= mmc_readl(host, REG_MISTA);
+	if (host->int_sum & sunxi_mmc_error_bits(host, mrq)) {
+		ret = sunxi_mmc_finalize_request(host);
+		spin_unlock_irqrestore(&host->lock, iflags);
+		sunxi_mmc_complete_deferred(host, mrq, ret);
+		return;
+	}
+
+	/*
+	 * A write whose busy ended after the full grace period without the
+	 * busy-clear interrupt, neither handled nor pending: the interrupt
+	 * does not work as described. Say so.
+	 */
+	if (!busy && mrq->data &&
+	    !((host->int_sum | mmc_readl(host, REG_RINTR)) &
+	      SDXC_WRITE_BUSY_CLEAR) &&
+	    ktime_us_delta(ktime_get(), host->busy_start) >=
+	    SDXC_BUSY_IRQ_GRACE_MS * USEC_PER_MSEC)
+		dev_warn_ratelimited(mmc_dev(host->mmc),
+				     "write: busy ended without the busy-clear interrupt\n");
+
+	mrq = sunxi_mmc_end_busy_wait(host, busy, "DAT0 poll");
+	spin_unlock_irqrestore(&host->lock, iflags);
+
+	mmc_request_done(host->mmc, mrq);
+}
+
+/*
+ * A write's busy clear came in SDXC_BUSY_CLEAR_DONE_MS ago and DTC or ACD
+ * never followed. Fail it as a data timeout, which sends the stop command,
+ * instead of leaving it open.
+ */
+static void sunxi_mmc_done_work(struct work_struct *work)
+{
+	struct sunxi_mmc_host *host = container_of(to_delayed_work(work),
+						   struct sunxi_mmc_host,
+						   done_work);
+	struct mmc_request *mrq;
+	unsigned long iflags;
+	irqreturn_t ret;
+
+	spin_lock_irqsave(&host->lock, iflags);
+	mrq = host->mrq;
+	if (!mrq || host->busy_wait || host->req_seq != host->done_seq ||
+	    (host->int_sum & (SDXC_INTERRUPT_DONE_BIT |
+			      sunxi_mmc_error_bits(host, mrq)))) {
+		spin_unlock_irqrestore(&host->lock, iflags);
+		return;
+	}
+
+	dev_err(mmc_dev(host->mmc),
+		"cmd %d WR: busy clear without DTC/ACD after %d ms, int_sum %08x rint %08x\n",
+		mrq->cmd->opcode, SDXC_BUSY_CLEAR_DONE_MS, host->int_sum,
+		mmc_readl(host, REG_RINTR));
+
+	host->int_sum |= SDXC_DATA_TIMEOUT;
+	ret = sunxi_mmc_finalize_request(host);
+	spin_unlock_irqrestore(&host->lock, iflags);
+
+	sunxi_mmc_complete_deferred(host, mrq, ret);
+}
+
 static irqreturn_t sunxi_mmc_irq(int irq, void *dev_id)
 {
 	struct sunxi_mmc_host *host = dev_id;
-	struct mmc_request *mrq;
+	struct mmc_request *mrq, *busy_mrq = NULL;
 	u32 msk_int, idma_int;
 	bool finalize = false;
+	bool end_busy = false;
 	bool sdio_int = false;
 	irqreturn_t ret = IRQ_HANDLED;
 
@@ -708,12 +1005,33 @@ static irqreturn_t sunxi_mmc_irq(int irq, void *dev_id)
 			mmc_writel(host, REG_IMASK,
 				   host->sdio_imask | SDXC_COMMAND_DONE);
 		/* Don't wait for dma on error */
-		else if ((host->int_sum & SDXC_INTERRUPT_ERROR_BIT) ||
+		else if ((host->int_sum & sunxi_mmc_error_bits(host, mrq)) ||
 			 host->idma_err)
 			finalize = true;
-		else if ((host->int_sum & SDXC_INTERRUPT_DONE_BIT) &&
-				!host->wait_dma)
-			finalize = true;
+		else if (host->busy_wait) {
+			/* The busy clear says when to look at DAT0 */
+			if (msk_int & SDXC_WRITE_BUSY_CLEAR) {
+				if (!(mmc_readl(host, REG_STAS) &
+				      SDXC_CARD_DATA_BUSY))
+					end_busy = true;
+				else
+					mod_delayed_work(system_dfl_long_wq,
+							 &host->busy_work, 0);
+			}
+		} else if ((host->int_sum & SDXC_INTERRUPT_DONE_BIT) &&
+			   !host->wait_dma) {
+			if (sunxi_mmc_wants_busy_wait(host, mrq) &&
+			    (mmc_readl(host, REG_STAS) & SDXC_CARD_DATA_BUSY))
+				sunxi_mmc_start_busy_wait(host);
+			else
+				finalize = true;
+		} else if ((msk_int & SDXC_WRITE_BUSY_CLEAR) && mrq->data &&
+			   sunxi_mmc_wants_busy_wait(host, mrq)) {
+			/* Busy clear before the done bit: bound the wait */
+			host->done_seq = host->req_seq;
+			mod_delayed_work(system_dfl_long_wq, &host->done_work,
+					 msecs_to_jiffies(SDXC_BUSY_CLEAR_DONE_MS));
+		}
 	}
 
 	if (msk_int & SDXC_SDIO_INTERRUPT)
@@ -724,12 +1042,18 @@ static irqreturn_t sunxi_mmc_irq(int irq, void *dev_id)
 
 	if (finalize)
 		ret = sunxi_mmc_finalize_request(host);
+	else if (end_busy)
+		busy_mrq = sunxi_mmc_end_busy_wait(host, false,
+						   "busy-clear irq");
 
 	spin_unlock(&host->lock);
 
 	if (finalize && ret == IRQ_HANDLED)
 		mmc_request_done(host->mmc, mrq);
 
+	if (busy_mrq)
+		mmc_request_done(host->mmc, busy_mrq);
+
 	if (sdio_int)
 		mmc_signal_sdio_irq(host->mmc);
 
@@ -798,6 +1122,7 @@ static irqreturn_t sunxi_mmc_handle_manual_stop(int irq, void *dev_id)
  * stop command where one is needed, the controller reset where the stop
  * fails.
  *
+ * A request in its busy wait is left to busy_work, which bounds that phase.
  * req_seq and data_seq tell whether the request this was armed for is
  * still the current one. The deadline covers an expiry that was already
  * waiting for the lock while the next request was started and armed.
@@ -814,7 +1139,8 @@ static void sunxi_mmc_data_work(struct work_struct *work)
 
 	spin_lock_irqsave(&host->lock, iflags);
 	mrq = host->mrq;
-	if (!mrq || !mrq->data || host->req_seq != host->data_seq ||
+	if (!mrq || !mrq->data || host->busy_wait ||
+	    host->req_seq != host->data_seq ||
 	    time_before(jiffies, host->data_deadline)) {
 		spin_unlock_irqrestore(&host->lock, iflags);
 		return;
@@ -1411,6 +1737,10 @@ static void sunxi_mmc_request(struct mmc_host *mmc, struct mmc_request *mrq)
 		mmc_writel(host, REG_BCNTR, data->blksz * data->blocks);
 		if (host->cfg->thld_fifo_bytes)
 			sunxi_mmc_set_card_threshold(host, data);
+		/* The busy-clear interrupt, for the write it is armed for */
+		if (host->cfg->can_wait_busy && (data->flags & MMC_DATA_WRITE))
+			mmc_writel(host, REG_THLD,
+				   mmc_readl(host, REG_THLD) | SDXC_CARD_BCIG);
