From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Norman Herms <dockseed@proton.me>
Date: Wed, 7 Oct 2026 20:22:53 +0200
Subject: [PATCH] dt-bindings: phy: Add the Allwinner A733 PCIe combo PHY

The second combo PHY (COMB1) of the A733 carries one lane of either the
PCIe controller or the USB3 controller. Add a binding for it in its PCIe
role.

Its protocol mux is one register in the SERDES top page, which also
holds the muxes of the first combo PHY. Like the first PHY, it reaches
that page through allwinner,serdes-top, the phandle of the system
controller, instead of a register region of its own. The PLL reference
comes through a gate in the SERDES CCU.

Not covered: COMB1 in its USB3 role.

Tested on Radxa Cubie A7S: the board's device tree with the COMB1 PHY
node and its SERDES top phandle passed the binding check and booted, and
the PHY node bound.

Assisted-by: LLM
---
 .../allwinner,sun60i-a733-pcie-combophy.yaml  | 81 +++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-pcie-combophy.yaml

diff --git a/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-pcie-combophy.yaml b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-pcie-combophy.yaml
new file mode 100644
index 000000000000..e0490b8a938e
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/allwinner,sun60i-a733-pcie-combophy.yaml
@@ -0,0 +1,81 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/allwinner,sun60i-a733-pcie-combophy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 PCIe combo PHY
+
+maintainers:
+  - Norman Herms <dockseed@proton.me>
+
+description:
+  The second combo PHY (COMB1) in the SERDES block of the A733 carries one
+  lane of either the PCIe controller or the USB3 controller. This binding
+  describes it in its PCIe role.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-pcie-combophy
+
+  reg:
+    items:
+      - description: PHY link control registers
+      - description: PMA registers
+
+  reg-names:
+    items:
+      - const: link
+      - const: pma
+
+  allwinner,serdes-top:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the SERDES top registers, a system controller shared with
+      the first combo PHY. It holds the protocol mux of this PHY's lane.
+
+  clocks:
+    items:
+      - description: SERDES PHY clock
+      - description: reference clock gate of the PHY PLL
+
+  clock-names:
+    items:
+      - const: serdes
+      - const: ref
+
+  resets:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - allwinner,serdes-top
+  - clocks
+  - clock-names
+  - resets
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/allwinner,sun60i-a733-ccu.h>
+    #include <dt-bindings/clock/allwinner,sun60i-a733-serdes-ccu.h>
+    #include <dt-bindings/reset/allwinner,sun60i-a733-ccu.h>
+
+    phy@6c02000 {
+        compatible = "allwinner,sun60i-a733-pcie-combophy";
+        reg = <0x06c02000 0x1000>,
+              <0x06ca0000 0x20000>;
+        reg-names = "link", "pma";
+        allwinner,serdes-top = <&serdes_top>;
+        clocks = <&ccu CLK_SERDES_PHY>, <&serdes_ccu CLK_COMB1_REF>;
+        clock-names = "serdes", "ref";
+        resets = <&ccu RST_BUS_SERDES>;
+        #phy-cells = <0>;
+    };
