+/* SPDX-License-Identifier: GPL-2.0 */
+
+#ifndef _CCU_SUN60I_A733_CPU_H_
+#define _CCU_SUN60I_A733_CPU_H_
+
+#include <dt-bindings/clock/allwinner,sun60i-a733-cpu-ccu.h>
+
+/* The PLLs and the slow clock are not exported. */
+#define CLK_PLL_CPU_BACK	4
+#define CLK_PLL_CPU_L		5
+#define CLK_PLL_CPU_B		6
+#define CLK_PLL_CPU_DSU		7
+#define CLK_CPU_SLOW		8
+
+#define CLK_NUMBER		(CLK_CPU_SLOW + 1)
+
+#endif /* _CCU_SUN60I_A733_CPU_H_ */
