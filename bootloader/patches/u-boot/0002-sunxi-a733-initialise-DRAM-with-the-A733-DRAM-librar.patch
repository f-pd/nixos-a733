From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alessio Corsi <alessio.corsi@gmail.com>
Date: Fri, 13 Nov 2026 04:41:39 +0100
Subject: [PATCH] sunxi: a733: initialise DRAM with the A733 DRAM library

Build the A733 DRAM library into the SPL and call it from
sunxi_dram_init(). The library is freestanding and reaches the hardware
through a few callbacks; implement them: register access, polling with a
timeout, delays, the DRAM rails on the AXP318W, and the index of the
memory strap on GPADC channel 1.

The library sources are not part of this tree: the build copies them to
arch/arm/mach-sunxi/a733_dram/. The PHY training firmware is linked from
the file named by A733_DRAM_PAYLOAD.

DRAM init runs before relocation, without BSS and driver model, so the
PMIC is reached with a small polling driver for R_TWI0 in the same file.
A rail is only written if it differs from what the library asks for, and
never outside the window an LPDDR5 board can ask for.

Without the blob, three things the manufacturer's loader does before
DRAM init are left to the SPL, and are done here the same way: the
enable bit of the PLLs, the first contact with the PMIC, and the clock
of the GPADC before the strap is read.
---
 arch/arm/mach-sunxi/Makefile                  |  23 +
 arch/arm/mach-sunxi/a733_dram/Makefile        |  12 +
 arch/arm/mach-sunxi/a733_dram_payload.S       |  13 +
 arch/arm/mach-sunxi/dram_sun60i_a733_source.c | 508 ++++++++++++++++++
 4 files changed, 556 insertions(+)
 create mode 100644 arch/arm/mach-sunxi/a733_dram/Makefile
 create mode 100644 arch/arm/mach-sunxi/a733_dram_payload.S
 create mode 100644 arch/arm/mach-sunxi/dram_sun60i_a733_source.c

diff --git a/arch/arm/mach-sunxi/Makefile b/arch/arm/mach-sunxi/Makefile
index ebabdc90..2c983ae4 100644
--- a/arch/arm/mach-sunxi/Makefile
+++ b/arch/arm/mach-sunxi/Makefile
@@ -49,9 +49,32 @@ obj-$(CONFIG_DRAM_SUN50I_A133)	+= dram_sun50i_a133.o
 obj-$(CONFIG_DRAM_SUN50I_A133)	+= dram_timings/
 obj-$(CONFIG_MACH_SUN55I_A523)	+= dram_sun55i_a523.o dram_dw_helpers.o
 obj-$(CONFIG_DRAM_SUN55I_A523)	+= dram_timings/
+ifdef CONFIG_SUNXI_A733_DRAM_SOURCE
+obj-y				+= dram_sun60i_a733_source.o
+obj-y				+= a733_dram_payload.o
+obj-y				+= a733_dram/
+else
 obj-$(CONFIG_MACH_SUN60I_A733)	+= dram_sun60i_a733.o
 obj-$(CONFIG_MACH_SUN60I_A733)	+= sunxi_libdram.o
 endif
+endif
+
+A733_DRAM_PAYLOAD_TARGET = $(objtree)/a733-dram-payload.bin
+
+$(obj)/a733_dram_payload.o: $(A733_DRAM_PAYLOAD_TARGET)
+AFLAGS_a733_dram_payload.o := -DA733_DRAM_PAYLOAD_BIN=\"$(abspath $(A733_DRAM_PAYLOAD_TARGET))\"
+
+$(A733_DRAM_PAYLOAD_TARGET): FORCE
+	@if [ -z "$(A733_DRAM_PAYLOAD)" ] || [ ! -f "$(A733_DRAM_PAYLOAD)" ]; then \
+		echo "  Error: no A733 DRAM PHY firmware payload"; \
+		echo "  Set A733_DRAM_PAYLOAD to the packed payload file"; \
+		false; \
+	elif ! cmp -s "$(A733_DRAM_PAYLOAD)" $@ 2>/dev/null; then \
+		echo "  Copying A733 DRAM payload from: $(A733_DRAM_PAYLOAD)"; \
+		cp "$(A733_DRAM_PAYLOAD)" $@; \
+	fi
+
+clean-files += $(A733_DRAM_PAYLOAD_TARGET)
 
 SUNXI_LIBDRAM_TARGET = $(objtree)/sunxi-libdram.bin
 
