+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# The A733 DRAM library. Its sources are not part of this tree: the build
+# copies include/ and src/ of the library next to this file.
+
+ccflags-y += -I$(srctree)/$(src)/include -I$(srctree)/$(src)/src
+
+obj-y += $(patsubst $(srctree)/$(src)/%.c,%.o,$(wildcard $(srctree)/$(src)/src/*.c))
+
+ifeq ($(wildcard $(srctree)/$(src)/src/*.c),)
+$(error A733 DRAM library sources missing in $(src)/src)
+endif
diff --git a/arch/arm/mach-sunxi/a733_dram_payload.S b/arch/arm/mach-sunxi/a733_dram_payload.S
new file mode 100644
index 00000000..3a55dea5
--- /dev/null
+++ b/arch/arm/mach-sunxi/a733_dram_payload.S
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * The PHY training firmware for the A733 DRAM library: the packed payload,
+ * taken at build time from the file named by A733_DRAM_PAYLOAD.
+ */
+
+.section .rodata.a733_dram_payload, "a"
+.balign 4
+.global a733_dram_payload
