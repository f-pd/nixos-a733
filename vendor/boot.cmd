# NixOS boot script for the manufacturer's U-Boot 2018.05.
#
# Generated by nixos-a733: do not edit, it is rewritten on every switch.
# That U-Boot runs in 32-bit mode and cannot read extlinux.conf with an arm64
# kernel, so it loads a uImage with bootm, the way the manufacturer does.
#
# Every step is also written to a733-uboot.txt on the FAT partition (partition
# 1 of the same card), so a boot can be followed without a serial adapter:
# put the card in any computer and read the file. a733-uboot-env.txt holds
# the whole U-Boot environment as this script saw it.

setenv a733_log_addr ${pxefile_addr_r}
setenv a733_log_part ${devtype} ${devnum}:1
setenv a733_save 'env export -t ${a733_log_addr} a733_1_script a733_2_kernel a733_3_initrd a733_4_fdt a733_5_overlays a733_6_bootm && fatwrite ${a733_log_part} ${a733_log_addr} a733-uboot.txt ${filesize}'

setenv a733_1_script "boot.scr loaded from ${devtype} ${devnum}:${distro_bootpart}, prefix ${prefix}"
setenv a733_2_kernel "not reached"
setenv a733_3_initrd "not reached"
setenv a733_4_fdt "not reached"
setenv a733_5_overlays "@overlayNames@"
setenv a733_6_bootm "not reached"
echo "nixos-a733: ${a733_1_script}"

env export -t ${a733_log_addr}
fatwrite ${a733_log_part} ${a733_log_addr} a733-uboot-env.txt ${filesize}
run a733_save

setenv bootargs "init=@init@ @kernelParams@"

if load ${devtype} ${devnum}:${distro_bootpart} ${kernel_addr_r} ${prefix}nixos/uImage; then
	setenv a733_2_kernel "ok, 0x${filesize} bytes at ${kernel_addr_r}"
else
	setenv a733_2_kernel "FAILED to load ${prefix}nixos/uImage"
fi
if load ${devtype} ${devnum}:${distro_bootpart} ${ramdisk_addr_r} ${prefix}nixos/uInitrd; then
	setenv a733_3_initrd "ok, 0x${filesize} bytes at ${ramdisk_addr_r}"
else
	setenv a733_3_initrd "FAILED to load ${prefix}nixos/uInitrd"
fi
if load ${devtype} ${devnum}:${distro_bootpart} ${fdt_addr_r} ${prefix}nixos/dtbs/@deviceTree@; then
	setenv a733_4_fdt "ok, 0x${filesize} bytes at ${fdt_addr_r}"
else
	setenv a733_4_fdt "FAILED to load ${prefix}nixos/dtbs/@deviceTree@"
fi

fdt addr ${fdt_addr_r}
fdt resize 65536

@overlays@

setenv a733_6_bootm "starting the kernel: if nothing follows, the kernel took over"
run a733_save

bootm ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}

setenv a733_6_bootm "FAILED: bootm returned to U-Boot"
echo "nixos-a733: ${a733_6_bootm}"
run a733_save
